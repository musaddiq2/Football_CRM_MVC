@model List<FootBallOne.Models.RegistrationManagement>

@{
    ViewData["Title"] = "Paid Players Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Imports -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        theme: {
            extend: {
                fontFamily: {
                    sans: ['Inter', 'sans-serif'],
                },
                colors: {
                    'soft-blue': '#ADD8E6',
                    'soft-gold': '#FFD700',
                }
            }
        }
    }
</script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f3f4f6;
        padding: 20px;
    }

    .badge-paid {
        background-color: #10b981;
        color: white;
    }

    .card-glass {
        background-color: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        border-radius: 1rem;
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.37);
    }
</style>

<div class="container">
    <h2 class="text-3xl font-bold text-center text-success mb-4" data-aos="fade-down">✅ Paid Players Dashboard</h2>

    <div class="card-glass p-4" data-aos="fade-up">
        <table class="table table-hover table-striped">
            <thead class="bg-success text-white">
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Subscription End</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var player in Model.Where(p => p.PaymentStatus == "Paid"))
                {
                    <tr>
                        <td>@player.Name</td>
                        <td>@player.PhoneNo</td>
                        <td>@(player.SubscriptionEnd?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                        <td><span class="badge badge-paid px-3 py-1 rounded">Paid</span></td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    AOS.init({ duration: 800, once: true });
</script>
