@model FootBallOne.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = $"Order {Model.Order.OrderNumber}";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">


<div class="container my-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Orders</a></li>
            <li class="breadcrumb-item active">@Model.Order.OrderNumber</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-5">Order @Model.Order.OrderNumber</h1>
            <p class="text-muted">Placed on @Model.Order.CreatedAt.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
        </div>
        <div class="col-md-4 text-md-end">
            @if (Model.Order.OrderStatus == "Pending")
            {
                <span class="badge bg-warning text-dark fs-5">@Model.Order.OrderStatus</span>
            }
            else if (Model.Order.OrderStatus == "Processing")
            {
                <span class="badge bg-info fs-5">@Model.Order.OrderStatus</span>
            }
            else if (Model.Order.OrderStatus == "Shipped")
            {
                <span class="badge bg-primary fs-5">@Model.Order.OrderStatus</span>
            }
            else if (Model.Order.OrderStatus == "Delivered")
            {
                <span class="badge bg-success fs-5">@Model.Order.OrderStatus</span>
            }
            else if (Model.Order.OrderStatus == "Cancelled")
            {
                <span class="badge bg-danger fs-5">@Model.Order.OrderStatus</span>
            }
        </div>
    </div>

    <!-- Order Progress -->
    @if (Model.Order.OrderStatus != "Cancelled")
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="mb-4">Order Status</h5>
                <div class="row text-center">
                    <div class="col">
                        <div class="@(Model.Order.OrderStatus == "Pending" || Model.Order.OrderStatus == "Confirmed" || Model.Order.OrderStatus == "Processing" || Model.Order.OrderStatus == "Shipped" || Model.Order.OrderStatus == "Delivered" ? "text-success" : "text-muted")">
                            <i class="bi bi-check-circle-fill" style="font-size: 2rem;"></i>
                            <p class="mt-2 mb-0 small"><strong>Order Placed</strong></p>
                            <p class="small text-muted">@Model.Order.CreatedAt.ToString("MMM dd")</p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="@(Model.Order.OrderStatus == "Processing" || Model.Order.OrderStatus == "Shipped" || Model.Order.OrderStatus == "Delivered" ? "text-success" : "text-muted")">
                            <i class="bi bi-box-seam" style="font-size: 2rem;"></i>
                            <p class="mt-2 mb-0 small"><strong>Processing</strong></p>
                        </div>
                    </div>
                    <div class="col">
                        <div class="@(Model.Order.OrderStatus == "Shipped" || Model.Order.OrderStatus == "Delivered" ? "text-success" : "text-muted")">
                            <i class="bi bi-truck" style="font-size: 2rem;"></i>
                            <p class="mt-2 mb-0 small"><strong>Shipped</strong></p>
                            @if (Model.Order.ShippedAt.HasValue)
                            {
                                <p class="small text-muted">@Model.Order.ShippedAt.Value.ToString("MMM dd")</p>
                            }
                        </div>
                    </div>
                    <div class="col">
                        <div class="@(Model.Order.OrderStatus == "Delivered" ? "text-success" : "text-muted")">
                            <i class="bi bi-house-door" style="font-size: 2rem;"></i>
                            <p class="mt-2 mb-0 small"><strong>Delivered</strong></p>
                            @if (Model.Order.DeliveredAt.HasValue)
                            {
                                <p class="small text-muted">@Model.Order.DeliveredAt.Value.ToString("MMM dd")</p>
                            }
                        </div>
                    </div>
                </div>

                @if (Model.Order.OrderStatus == "Shipped" && !string.IsNullOrEmpty(Model.Order.TrackingNumber))
                {
                    <div class="alert alert-info mt-3 mb-0">
                        <i class="bi bi-truck"></i>
                        <strong>Tracking Number:</strong> @Model.Order.TrackingNumber
                    </div>
                }
            </div>
        </div>
    }

    <div class="row">
        <!-- Order Items -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Order Items</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@(item.Product?.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/images/no-image.jpg")"
                                                     alt="@item.ProductName"
                                                     class="rounded me-3"
                                                     style="width: 60px; height: 60px; object-fit: cover;">
                                                <div>
                                                    <h6 class="mb-1">@item.ProductName</h6>
                                                    <small class="text-muted">SKU: @item.SKU</small>
                                                    @if (!string.IsNullOrEmpty(item.Size) || !string.IsNullOrEmpty(item.Color))
                                                    {
                                                        <br />
                                                        <small class="text-muted">
                                                            @if (!string.IsNullOrEmpty(item.Size))
                                                            {
                                                                <span>Size: @item.Size</span>
                                                            }
                                                            @if (!string.IsNullOrEmpty(item.Color))
                                                            {
                                                                <span class="ms-2">Color: @item.Color</span>
                                                            }
                                                        </small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="align-middle">₹@item.UnitPrice.ToString("N2")</td>
                                        <td class="align-middle">@item.Quantity</td>
                                        <td class="align-middle text-end">
                                            <strong>₹@item.TotalPrice.ToString("N2")</strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Summary & Info -->
        <div class="col-lg-4">
            <!-- Price Summary -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <strong>₹@Model.Order.SubTotal.ToString("N2")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping:</span>
                        @if (Model.Order.ShippingCost == 0)
                        {
                            <strong class="text-success">FREE</strong>
                        }
                        else
                        {
                            <strong>₹@Model.Order.ShippingCost.ToString("N2")</strong>
                        }
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax:</span>
                        <strong>₹@Model.Order.TaxAmount.ToString("N2")</strong>
                    </div>
                    @if (Model.Order.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span>Discount:</span>
                            <strong class="text-success">-₹@Model.Order.DiscountAmount.ToString("N2")</strong>
                        </div>
                    }
                    <hr>
                    <div class="d-flex justify-content-between">
                        <h5>Total:</h5>
                        <h4 class="text-primary">₹@Model.Order.TotalAmount.ToString("N2")</h4>
                    </div>
                </div>
            </div>

            <!-- Shipping Address -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-truck"></i> Shipping Address</h6>
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>@Model.Order.ContactName</strong></p>
                    <p class="mb-1">@Model.Order.ShippingAddress</p>
                    <p class="mb-1">@Model.Order.ShippingCity, @Model.Order.ShippingState</p>
                    <p class="mb-1">@Model.Order.ShippingPostalCode</p>
                    <p class="mb-0">@Model.Order.ShippingCountry</p>
                </div>
            </div>

            <!-- Contact Info -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-person"></i> Contact Information</h6>
                </div>
                <div class="card-body">
                    <p class="mb-1">
                        <i class="bi bi-telephone"></i> @Model.Order.ContactPhone
                    </p>
                    <p class="mb-0">
                        <i class="bi bi-envelope"></i> @Model.Order.ContactEmail
                    </p>
                </div>
            </div>

            <!-- Payment Info -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-wallet2"></i> Payment Information</h6>
                </div>
                <div class="card-body">
                    <p class="mb-1">
                        <strong>Method:</strong> @Model.Order.PaymentMethod
                    </p>
                    <p class="mb-1">
                        <strong>Status:</strong>
                        <span class="badge @(Model.Order.PaymentStatus == "Paid" ? "bg-success" : "bg-warning")">
                            @Model.Order.PaymentStatus
                        </span>
                    </p>
                    @if (!string.IsNullOrEmpty(Model.Order.TransactionId))
                    {
                        <p class="mb-0">
                            <strong>Transaction ID:</strong><br />
                            <small class="text-muted">@Model.Order.TransactionId</small>
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mt-4">
        <div class="col-12">
            <a asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left"></i> Back to Orders
            </a>
            @if (Model.Order.OrderStatus == "Delivered")
            {
                <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.OrderItems.First().ProductId"
                   class="btn btn-outline-success">
                    <i class="bi bi-star"></i> Leave a Review
                </a>
            }
        </div>
    </div>
</div>