@model FootBallOne.ViewModels.CategoryProductsViewModel

@{
    ViewData["Title"] = Model.Category.CategoryName;
}

<div class="container my-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Shop</a></li>
            <li class="breadcrumb-item active">@Model.Category.CategoryName</li>
        </ol>
    </nav>

    <!-- Category Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Category.ImageUrl))
                    {
                        <img src="@Model.Category.ImageUrl" alt="@Model.Category.CategoryName"
                             class="img-fluid rounded mb-3" style="max-height: 200px; width: 100%; object-fit: cover;">
                    }
                    <h1 class="display-5">@Model.Category.CategoryName</h1>
                    @if (!string.IsNullOrEmpty(Model.Category.Description))
                    {
                        <p class="lead text-muted">@Model.Category.Description</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Subcategories (if any) -->
    @if (Model.SubCategories.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <h4 class="mb-3">Browse by Subcategory</h4>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var subCategory in Model.SubCategories)
                    {
                        <a asp-action="Category" asp-route-id="@subCategory.CategoryId"
                           class="btn btn-outline-primary">
                            @subCategory.CategoryName
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row">
        <!-- Filters Sidebar -->
        <div class="col-lg-3 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-funnel"></i> Filters</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Category" asp-route-id="@Model.Category.CategoryId" method="get">
                        <!-- Price Range -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Price Range</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="number" name="minPrice" class="form-control"
                                           placeholder="Min" value="@Model.MinPrice" step="0.01">
                                </div>
                                <div class="col-6">
                                    <input type="number" name="maxPrice" class="form-control"
                                           placeholder="Max" value="@Model.MaxPrice" step="0.01">
                                </div>
                            </div>
                        </div>

                        <!-- Sort By -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Sort By</label>
                            <select name="sortBy" class="form-select">
                                <option value="newest" selected="@(Model.SortBy == "newest")">Newest First</option>
                                <option value="popular" selected="@(Model.SortBy == "popular")">Most Popular</option>
                                <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                                <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                                <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Name: A to Z</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Apply Filters
                        </button>
                        <a asp-action="Category" asp-route-id="@Model.Category.CategoryId" class="btn btn-outline-secondary w-100 mt-2">
                            <i class="bi bi-x-circle"></i> Clear Filters
                        </a>
                    </form>
                </div>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="col-lg-9">
            <!-- Results Info -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="mb-0">
                        Showing @Model.Products.Count() of @Model.TotalProducts products
                    </h5>
                </div>
            </div>

            @if (Model.Products.Any())
            {
                <!-- Products Grid -->
                <div class="row g-4">
                    @foreach (var product in Model.Products)
                    {
                        <div class="col-md-6 col-lg-4">
                            <partial name="_ProductCard" model="product" />
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Product pagination" class="mt-5">
                        <ul class="pagination justify-content-center">
                            <!-- Previous -->
                            <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Category"
                                   asp-route-id="@Model.Category.CategoryId"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-sortBy="@Model.SortBy"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice">
                                    Previous
                                </a>
                            </li>

                            <!-- Page Numbers -->
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Category"
                                       asp-route-id="@Model.Category.CategoryId"
                                       asp-route-page="@i"
                                       asp-route-sortBy="@Model.SortBy"
                                       asp-route-minPrice="@Model.MinPrice"
                                       asp-route-maxPrice="@Model.MaxPrice">
                                        @i
                                    </a>
                                </li>
                            }

                            <!-- Next -->
                            <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Category"
                                   asp-route-id="@Model.Category.CategoryId"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-sortBy="@Model.SortBy"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice">
                                    Next
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <!-- No Products Found -->
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 4rem; color: #ccc;"></i>
                    <h3 class="mt-3">No products in this category</h3>
                    <p class="text-muted">Check back later for new products</p>
                    <a asp-action="Index" class="btn btn-primary">Browse All Products</a>
                </div>
            }
        </div>
    </div>
</div>