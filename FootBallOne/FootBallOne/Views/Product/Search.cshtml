    @model FootBallOne.ViewModels.SearchResultsViewModel

@{
    ViewData["Title"] = $"Search Results for \"{Model.SearchTerm}\"";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<div class="container mt-4">
    <!-- Search Header -->
    <div class="mb-4">
        <h1 class="h3">Search Results for "@Model.SearchTerm"</h1>
        <p class="text-muted">Found @Model.TotalProducts products</p>
    </div>

    <div class="row">
        <!-- Filters Sidebar -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-header">
                    <h5>Refine Search</h5>
                </div>
                <div class="card-body">
                    <form method="get" asp-action="Search">
                        <input type="hidden" name="term" value="@Model.SearchTerm" />

                        <!-- Category Filter -->
                        <div class="mb-3">
                            <label class="form-label">Category</label>
                            <select name="categoryId" class="form-select">
                                <option value="">All Categories</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.CategoryId"
                                            selected="@(Model.SelectedCategoryId == category.CategoryId)">
                                        @category.CategoryName
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Sort -->
                        <div class="mb-3">
                            <label class="form-label">Sort By</label>
                            <select name="sortBy" class="form-select">
                                <option value="relevance" selected="@(Model.SortBy == "relevance")">Most Relevant</option>
                                <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                                <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                                <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                                <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Name: A-Z</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-filter"></i> Apply Filters
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Search Results -->
        <div class="col-md-9">
            @if (Model.Products != null && Model.Products.Any())
            {
                <div class="row">
                    @foreach (var product in Model.Products)
                    {
                        <div class="col-md-4 col-sm-6 mb-4">
                            <!-- SAME PRODUCT CARD AS INDEX -->
                            <div class="product-card">
                                <a href="/Product/Details/@product.ProductId">
                                    @if (product.ProductImages != null && product.ProductImages.Any())
                                    {
                                        <img src="@product.ProductImages.First().ImageUrl"
                                             alt="@product.ProductName"
                                             class="product-image"
                                             onerror="this.onerror=null; this.src='/images/placeholder.jpg';" />
                                    }
                                    else
                                    {
                                        <div class="product-image-placeholder">
                                            <i class="fas fa-shopping-bag"></i>
                                        </div>
                                    }
                                </a>

                                <div class="product-info p-3">
                                    @if (product.Category != null)
                                    {
                                        <span class="badge bg-secondary mb-2">@product.Category.CategoryName</span>
                                    }

                                    <h5 class="product-name mb-2">
                                        <a href="/Product/Details/@product.ProductId" class="text-dark text-decoration-none">
                                            @product.ProductName
                                        </a>
                                    </h5>

                                    @if (!string.IsNullOrEmpty(product.Brand))
                                    {
                                        <p class="text-muted small mb-2">@product.Brand</p>
                                    }

                                    <div class="mb-2">
                                        <span class="product-price">₹@product.FinalPrice.ToString("N2")</span>
                                        @if (product.DiscountPercentage > 0)
                                        {
                                            <span class="product-price-original">₹@product.BasePrice.ToString("N2")</span>
                                            <span class="product-discount">@product.DiscountPercentage% OFF</span>
                                        }
                                    </div>

                                    @if (product.StockQuantity > 0)
                                    {
                                        <button type="button"
                                                class="btn btn-add-to-cart w-100"
                                                onclick="addToCart(@product.ProductId, null, 1)">
                                            <i class="fas fa-cart-plus"></i> Add to Cart
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary w-100" disabled>
                                            Out of Stock
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav>
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   href="?term=@Model.SearchTerm&page=@(Model.CurrentPage - 1)&categoryId=@Model.SelectedCategoryId&sortBy=@Model.SortBy">
                                    Previous
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link"
                                       href="?term=@Model.SearchTerm&page=@i&categoryId=@Model.SelectedCategoryId&sortBy=@Model.SortBy">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   href="?term=@Model.SearchTerm&page=@(Model.CurrentPage + 1)&categoryId=@Model.SelectedCategoryId&sortBy=@Model.SortBy">
                                    Next
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <!-- No Results -->
                <div class="alert alert-warning text-center py-5">
                    <i class="fas fa-search fa-3x mb-3 text-muted"></i>
                    <h4>No products found for "@Model.SearchTerm"</h4>
                    <p>Try different keywords or browse our categories.</p>
                    <a href="/Product" class="btn btn-primary">Browse All Products</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cart.js"></script>
}