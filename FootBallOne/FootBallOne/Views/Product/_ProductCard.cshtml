@model FootBallOne.Models.FBProduct
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<div class="card h-100 shadow-sm product-card">
    <!-- Product Image -->
    <div class="position-relative">
        @{
            var primaryImage = Model.ProductImages?.FirstOrDefault(i => i.IsPrimary);
            var imageUrl = primaryImage?.ImageUrl ?? "/images/no-image.jpg";
        }

        <a asp-action="Details" asp-route-id="@Model.ProductId">
            <img src="@imageUrl"
                 class="card-img-top"
                 alt="@Model.ProductName"
                 style="height: 250px; object-fit: cover;">
        </a>

        <!-- Badges -->
        <div class="position-absolute top-0 end-0 p-2">
            @if (Model.IsFeatured)
            {
                <span class="badge bg-warning text-dark">Featured</span>
            }
            @if (Model.DiscountPercentage > 0)
            {
                <span class="badge bg-danger">-@Model.DiscountPercentage%</span>
            }
        </div>

        <!-- Stock Badge -->
        <div class="position-absolute bottom-0 start-0 p-2">
            @if (Model.IsOutOfStock)
            {
                <span class="badge bg-secondary">Out of Stock</span>
            }
            else if (Model.IsLowStock)
            {
                <span class="badge bg-warning text-dark">Low Stock</span>
            }
        </div>
    </div>

    <!-- Product Info -->
    <div class="card-body d-flex flex-column">
        <!-- Category -->
        <p class="text-muted small mb-2">
            <i class="bi bi-tag"></i> @Model.Category?.CategoryName
        </p>

        <!-- Product Name -->
        <h5 class="card-title">
            <a asp-action="Details" asp-route-id="@Model.ProductId"
               class="text-decoration-none text-dark">
                @Model.ProductName
            </a>
        </h5>

        <!-- Brand -->
        @if (!string.IsNullOrEmpty(Model.Brand))
        {
            <p class="text-muted small mb-2">
                <strong>Brand:</strong> @Model.Brand
            </p>
        }

        <!-- Description (truncated) -->
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="card-text text-muted small">
                @(Model.Description.Length > 80 ? Model.Description.Substring(0, 80) + "..." : Model.Description)
            </p>
        }

        <div class="mt-auto">
            <!-- Price -->
            <div class="mb-3">
                @if (Model.DiscountPercentage > 0)
                {
                    <div>
                        <span class="h5 text-primary fw-bold">₹@Model.FinalPrice.ToString("N2")</span>
                        <span class="text-muted text-decoration-line-through ms-2">₹@Model.BasePrice.ToString("N2")</span>
                    </div>
                }
                else
                {
                    <span class="h5 text-primary fw-bold">₹@Model.BasePrice.ToString("N2")</span>
                }
            </div>

            <!-- Actions -->
            <div class="d-grid gap-2">
                <a asp-action="Details" asp-route-id="@Model.ProductId"
                   class="btn btn-primary">
                    <i class="bi bi-eye"></i> View Details
                </a>

                @if (!Model.IsOutOfStock)
                {
                    <button type="button"
                            class="btn btn-outline-success btn-add-to-cart"
                            data-product-id="@Model.ProductId">
                        <i class="bi bi-cart-plus"></i> Add to Cart
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-secondary" disabled>
                        <i class="bi bi-x-circle"></i> Out of Stock
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }

        .product-card .card-img-top {
            transition: opacity 0.3s ease;
        }

        .product-card:hover .card-img-top {
            opacity: 0.9;
        }
</style>