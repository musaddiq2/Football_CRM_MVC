@model ParentCreateViewModel

@{
    ViewData["Title"] = "Create Parent";
    var students = ViewBag.Students as List<RegistrationManagement>;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Subscribers & Subscriptions</a></li>
            <li class="breadcrumb-item"><a asp-controller="Parents" asp-action="Index">Parents</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </nav>

    <h1 class="mb-4">Create Parent</h1>

    <!-- Display Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="parentForm">
        @Html.AntiForgeryToken()

        <!-- Step Navigation -->
        <ul class="nav nav-pills mb-4" id="stepNav">
            <li class="nav-item">
                <a class="nav-link active" id="step1-tab" data-bs-toggle="pill" href="#step1">
                    <span class="step-number">01</span> Basic Information
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="step2-tab" data-bs-toggle="pill" href="#step2">
                    <span class="step-number">02</span> Phone Numbers
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="step3-tab" data-bs-toggle="pill" href="#step3">
                    <span class="step-number">03</span> Additional Information
                </a>
            </li>
        </ul>

        <div class="tab-content">
            <!-- Step 1: Basic Information -->
            <div class="tab-pane fade show active" id="step1">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title mb-4">Personal Details</h5>

                        <!-- Student Selection Dropdown -->
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <label asp-for="RegistrationId" class="form-label">Select Student <span class="text-danger">*</span></label>
                                <select asp-for="RegistrationId" class="form-select" id="studentSelect">
                                    <option value="">-- Select Student --</option>
                                    @if (students != null)
                                    {
                                        foreach (var student in students)
                                        {
                                            <option value="@student.Id">@student.Name - ID: @student.Id</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="RegistrationId" class="text-danger"></span>
                                <small class="form-text text-muted">Select the student this parent belongs to</small>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Replace your existing Email and Password fields with these -->
                        <!-- Replace these sections in your Step 1: Basic Information -->

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Fullname" class="form-label">Full Name <span class="text-danger">*</span></label>
                                <input asp-for="Fullname" class="form-control" placeholder="Enter full name" autocomplete="off" />
                                <span asp-validation-for="Fullname" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="Enter email address"
                                       autocomplete="off"
                                       readonly
                                       onfocus="this.removeAttribute('readonly');" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="MobileNo" class="form-label">Mobile Number <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">🇸🇦 +966</span>
                                    <input asp-for="MobileNo" class="form-control" placeholder="51 234 5678" autocomplete="off" />
                                </div>
                                <span asp-validation-for="MobileNo" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       placeholder="Enter password"
                                       autocomplete="new-password"
                                       readonly
                                       onfocus="this.removeAttribute('readonly');" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="IqamaID" class="form-label">ID/Iqama Number</label>
                                <input asp-for="IqamaID" class="form-control" placeholder="Enter ID/Iqama number" />
                                <span asp-validation-for="IqamaID" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label d-block">Gender</label>
                                <div class="btn-group" role="group">
                                    <input type="radio" asp-for="Gender" value="Male" class="btn-check" id="genderMale" checked />
                                    <label class="btn btn-outline-primary" for="genderMale">
                                        <i class="bi bi-gender-male"></i> Male
                                    </label>

                                    <input type="radio" asp-for="Gender" value="Female" class="btn-check" id="genderFemale" />
                                    <label class="btn btn-outline-primary" for="genderFemale">
                                        <i class="bi bi-gender-female"></i> Female
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SubscriberPhoto" class="form-label">Subscriber Photo</label>
                                <div class="upload-area text-center p-4 border rounded">
                                    <input asp-for="SubscriberPhoto" type="file" class="form-control" accept="image/*" id="photoUpload" />
                                    <p class="text-muted mb-0 mt-2">Drag & Drop your files or <span class="text-primary">Browse</span></p>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="activeSwitch" checked />
                                    <label class="form-check-label" for="activeSwitch">Active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-3">
                    <button type="button" class="btn btn-primary" onclick="nextStep(2)">Next</button>
                </div>
            </div>

            <!-- Step 2: Phone Numbers -->
            <div class="tab-pane fade" id="step2">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title mb-4">Phone Numbers</h5>

                        <div id="phoneNumbersContainer">
                            <!-- Phone 1 -->
                            <div class="phone-entry border rounded p-3 mb-3" id="phone1">
                                <div class="d-flex justify-content-between mb-3">
                                    <h6>Phone Number 1</h6>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label asp-for="Phone1" class="form-label">Phone Number</label>
                                        <div class="input-group">
                                            <span class="input-group-text">🇸🇦 +966</span>
                                            <input asp-for="Phone1" id="Phone1" class="form-control" placeholder="51 234 5678" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="Phone1Label" class="form-label">Label</label>
                                        <select asp-for="Phone1Label" id="Phone1Label" class="form-select">
                                            <option value="">-- Select Label --</option>
                                            <option value="Mobile">Mobile</option>
                                            <option value="Home">Home</option>
                                            <option value="Work">Work</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">WhatsApp</label>
                                        <div class="form-check form-switch mt-2">
                                            <input asp-for="Phone1IsWhatsApp" class="form-check-input" type="checkbox" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <label asp-for="Phone1Notes" class="form-label">Notes</label>
                                        <textarea asp-for="Phone1Notes" class="form-control" rows="2" placeholder="Add any notes about this number..."></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Phone 2 -->
                            <div class="phone-entry border rounded p-3 mb-3" id="phone2">
                                <div class="d-flex justify-content-between mb-3">
                                    <h6>Phone Number 2</h6>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label asp-for="Phone2" class="form-label">Phone Number</label>
                                        <div class="input-group">
                                            <span class="input-group-text">🇸🇦 +966</span>
                                            <input asp-for="Phone2" id="Phone2" class="form-control" placeholder="51 234 5678" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="Phone2Label" class="form-label">Label</label>
                                        <select asp-for="Phone2Label" id="Phone2Label" class="form-select">
                                            <option value="">-- Select Label --</option>
                                            <option value="Mobile">Mobile</option>
                                            <option value="Home" selected>Home</option>
                                            <option value="Work">Work</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">WhatsApp</label>
                                        <div class="form-check form-switch mt-2">
                                            <input asp-for="Phone2IsWhatsApp" class="form-check-input" type="checkbox" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <label asp-for="Phone2Notes" class="form-label">Notes</label>
                                        <textarea asp-for="Phone2Notes" class="form-control" rows="2" placeholder="Add any notes about this number..."></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Phone 3 -->
                            <div class="phone-entry border rounded p-3 mb-3" id="phone3">
                                <div class="d-flex justify-content-between mb-3">
                                    <h6>Phone Number 3</h6>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label asp-for="Phone3" class="form-label">Phone Number</label>
                                        <div class="input-group">
                                            <span class="input-group-text">🇸🇦 +966</span>
                                            <input asp-for="Phone3" id="Phone3" class="form-control" placeholder="51 234 5678" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="Phone3Label" class="form-label">Label</label>
                                        <select asp-for="Phone3Label" id="Phone3Label" class="form-select">
                                            <option value="">-- Select Label --</option>
                                            <option value="Mobile">Mobile</option>
                                            <option value="Home">Home</option>
                                            <option value="Work" selected>Work</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">WhatsApp</label>
                                        <div class="form-check form-switch mt-2">
                                            <input asp-for="Phone3IsWhatsApp" class="form-check-input" type="checkbox" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <label asp-for="Phone3Notes" class="form-label">Notes</label>
                                        <textarea asp-for="Phone3Notes" class="form-control" rows="2" placeholder="Add any notes about this number..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-3">
                    <button type="button" class="btn btn-secondary" onclick="prevStep(1)">Back</button>
                    <button type="button" class="btn btn-primary" onclick="nextStep(3)">Next</button>
                </div>
            </div>

            <!-- Step 3: Additional Information -->
            <div class="tab-pane fade" id="step3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title mb-4">Location Details</h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label">Address</label>
                                <input asp-for="Address" class="form-control" placeholder="Type address to search" id="addressInput" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label">City</label>
                                <input asp-for="City" class="form-control" placeholder="Enter city" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label">Location</label>
                                <div id="map" style="height: 400px; width: 100%;" class="border rounded"></div>
                                <small class="form-text text-muted">Click on the map to set the location</small>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Latitude" class="form-label">Latitude</label>
                                <input asp-for="Latitude" class="form-control" placeholder="21.4225" readonly id="latitudeInput" />
                                <span asp-validation-for="Latitude" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Longitude" class="form-label">Longitude</label>
                                <input asp-for="Longitude" class="form-control" placeholder="39.8262" readonly id="longitudeInput" />
                                <span asp-validation-for="Longitude" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="Note" class="form-label">Notes</label>
                                <textarea asp-for="Note" class="form-control" rows="4" placeholder="Add any additional notes..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-3">
                    <button type="button" class="btn btn-secondary" onclick="prevStep(2)">Back</button>
                    <div>
                        <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i> Create
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Leaflet Geocoder (for address search) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
    <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>

    <script>
               let map;
        let marker;
        let completedSteps = []; // Track completed steps

        function initMap() {
            // Default to Jeddah, Saudi Arabia
            const defaultLat = 21.4225;
            const defaultLng = 39.8262;

            // Check if there are existing coordinates
            const existingLat = parseFloat(document.getElementById('latitudeInput').value);
            const existingLng = parseFloat(document.getElementById('longitudeInput').value);

            const initialLat = existingLat || defaultLat;
            const initialLng = existingLng || defaultLng;

            // Initialize map
            map = L.map('map').setView([initialLat, initialLng], 12);

            // Add OpenStreetMap tiles (completely free, no API key needed)
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors',
                maxZoom: 19
            }).addTo(map);

            // Add marker if coordinates exist
            if (existingLat && existingLng) {
                marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map);
                marker.on('dragend', function(e) {
                    const position = marker.getLatLng();
                    updateCoordinates(position.lat, position.lng);
                    reverseGeocode(position.lat, position.lng);
                });
            }

            // Add click event to map
            map.on('click', function(e) {
                placeMarker(e.latlng.lat, e.latlng.lng);
            });

            // Add search control (address search)
            const geocoder = L.Control.Geocoder.nominatim();
            const searchControl = L.Control.geocoder({
                geocoder: geocoder,
                defaultMarkGeocode: false
            }).on('markgeocode', function(e) {
                const latlng = e.geocode.center;
                placeMarker(latlng.lat, latlng.lng);
                map.setView(latlng, 15);
            }).addTo(map);

            // Setup address input autocomplete
            setupAddressSearch();
        }

        function setupAddressSearch() {
            const addressInput = document.getElementById('addressInput');
            let searchTimeout;

            addressInput.addEventListener('input', function() {
                clearTimeout(searchTimeout);
                const query = this.value;

                if (query.length < 3) return;

                searchTimeout = setTimeout(function() {
                    // Search using Nominatim (free geocoding service)
                    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&countrycodes=sa&limit=5`)
                        .then(response => response.json())
                        .then(data => {
                            if (data && data.length > 0) {
                                const result = data[0];
                                const lat = parseFloat(result.lat);
                                const lng = parseFloat(result.lon);
                                placeMarker(lat, lng);
                                map.setView([lat, lng], 15);
                            }
                        })
                        .catch(error => console.error('Geocoding error:', error));
                }, 500);
            });
        }

        function placeMarker(lat, lng) {
            if (marker) {
                marker.setLatLng([lat, lng]);
            } else {
                marker = L.marker([lat, lng], { draggable: true }).addTo(map);
                marker.on('dragend', function(e) {
                    const position = marker.getLatLng();
                    updateCoordinates(position.lat, position.lng);
                    reverseGeocode(position.lat, position.lng);
                });
            }

            updateCoordinates(lat, lng);
            reverseGeocode(lat, lng);
        }

        function updateCoordinates(lat, lng) {
            document.getElementById('latitudeInput').value = lat.toFixed(6);
            document.getElementById('longitudeInput').value = lng.toFixed(6);
        }

        function reverseGeocode(lat, lng) {
            // Use Nominatim reverse geocoding (free service)
            fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`)
                .then(response => response.json())
                .then(data => {
                    if (data && data.display_name) {
                        document.getElementById('addressInput').value = data.display_name;

                        // Extract city from address
                        const address = data.address;
                        let city = address.city || address.town || address.village ||
                                   address.state || address.county || '';

                        if (city) {
                            document.getElementById('City').value = city;
                        }
                    }
                })
                .catch(error => console.error('Reverse geocoding error:', error));
        }

        // Validation function for each step
        function validateStep(stepNumber) {
            let isValid = true;
            let firstInvalidField = null;

            // Clear previous error messages
            const currentStep = document.getElementById(`step${stepNumber}`);
            currentStep.querySelectorAll('.validation-error').forEach(el => el.remove());
            currentStep.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));

            if (stepNumber === 1) {
                // Validate Step 1: Basic Information
                const requiredFields = [
                    { id: 'RegistrationId', name: 'Student' },
                    { id: 'Fullname', name: 'Full Name' },
                    { id: 'MobileNo', name: 'Mobile Number' },
                    { id: 'Password', name: 'Password' }
                ];

                requiredFields.forEach(field => {
                    const element = document.getElementById(field.id) || document.querySelector(`[name="${field.id}"]`);
                    if (element && !element.value.trim()) {
                        isValid = false;
                        element.classList.add('is-invalid');

                        // Add error message
                        const errorDiv = document.createElement('div');
                        errorDiv.className = 'validation-error text-danger small mt-1';
                        errorDiv.textContent = `${field.name} is required`;
                        element.parentElement.appendChild(errorDiv);

                        if (!firstInvalidField) {
                            firstInvalidField = element;
                        }
                    }
                });

                // Validate email format if provided
                const emailField = document.getElementById('Email');
                if (emailField && emailField.value.trim()) {
                    const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                    if (!emailPattern.test(emailField.value)) {
                        isValid = false;
                        emailField.classList.add('is-invalid');
                        const errorDiv = document.createElement('div');
                        errorDiv.className = 'validation-error text-danger small mt-1';
                        errorDiv.textContent = 'Please enter a valid email address';
                        emailField.parentElement.appendChild(errorDiv);
                        if (!firstInvalidField) {
                            firstInvalidField = emailField;
                        }
                    }
                }
            }

            if (stepNumber === 2) {
                // Step 2 validation: At least one phone number with label is required
                const phone1 = document.getElementById('Phone1');
                const phone1Label = document.getElementById('Phone1Label');
                const phone2 = document.getElementById('Phone2');
                const phone2Label = document.getElementById('Phone2Label');
                const phone3 = document.getElementById('Phone3');
                const phone3Label = document.getElementById('Phone3Label');

                // Check if at least one phone number is filled
                const hasPhone1 = phone1 && phone1.value.trim();
                const hasPhone2 = phone2 && phone2.value.trim();
                const hasPhone3 = phone3 && phone3.value.trim();

                if (!hasPhone1 && !hasPhone2 && !hasPhone3) {
                    isValid = false;

                    // Mark phone1 as required since none are filled
                    if (phone1) {
                        phone1.classList.add('is-invalid');
                        const errorDiv = document.createElement('div');
                        errorDiv.className = 'validation-error text-danger small mt-1';
                        errorDiv.textContent = 'At least one phone number is required';
                        phone1.parentElement.appendChild(errorDiv);
                        if (!firstInvalidField) {
                            firstInvalidField = phone1;
                        }
                    }
                } else {
                    // Validate that if a phone number is entered, its label is also selected
                    if (hasPhone1 && phone1Label && !phone1Label.value) {
                        isValid = false;
                        phone1Label.classList.add('is-invalid');
                        const errorDiv = document.createElement('div');
                        errorDiv.className = 'validation-error text-danger small mt-1';
                        errorDiv.textContent = 'Label is required when phone number is provided';
                        phone1Label.parentElement.appendChild(errorDiv);
                        if (!firstInvalidField) {
                            firstInvalidField = phone1Label;
                        }
                    }

                    if (hasPhone2 && phone2Label && !phone2Label.value) {
                        isValid = false;
                        phone2Label.classList.add('is-invalid');
                        const errorDiv = document.createElement('div');
                        errorDiv.className = 'validation-error text-danger small mt-1';
                        errorDiv.textContent = 'Label is required when phone number is provided';
                        phone2Label.parentElement.appendChild(errorDiv);
                        if (!firstInvalidField) {
                            firstInvalidField = phone2Label;
                        }
                    }

                    if (hasPhone3 && phone3Label && !phone3Label.value) {
                        isValid = false;
                        phone3Label.classList.add('is-invalid');
                        const errorDiv = document.createElement('div');
                        errorDiv.className = 'validation-error text-danger small mt-1';
                        errorDiv.textContent = 'Label is required when phone number is provided';
                        phone3Label.parentElement.appendChild(errorDiv);
                        if (!firstInvalidField) {
                            firstInvalidField = phone3Label;
                        }
                    }
                }
            }

            if (stepNumber === 3) {
                // Step 3 validation: Address is required
                const addressField = document.getElementById('addressInput');

                if (addressField && !addressField.value.trim()) {
                    isValid = false;
                    addressField.classList.add('is-invalid');
                    const errorDiv = document.createElement('div');
                    errorDiv.className = 'validation-error text-danger small mt-1';
                    errorDiv.textContent = 'Address is required';
                    addressField.parentElement.appendChild(errorDiv);
                    if (!firstInvalidField) {
                        firstInvalidField = addressField;
                    }
                }
            }

            // Show error message and focus first invalid field
            if (!isValid) {
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-danger alert-dismissible fade show mt-3';
                alertDiv.innerHTML = `
                    <strong>Validation Error!</strong> Please fill in all required fields before proceeding.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                currentStep.insertBefore(alertDiv, currentStep.firstChild);

                if (firstInvalidField) {
                    firstInvalidField.focus();
                    firstInvalidField.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }

                // Auto-dismiss alert after 5 seconds
                setTimeout(() => {
                    alertDiv.remove();
                }, 5000);
            }

            return isValid;
        }

        function nextStep(step) {
            event.preventDefault();

            // Validate current step before moving to next
            const currentStep = step - 1;
            if (!validateStep(currentStep)) {
                return; // Don't proceed if validation fails
            }

            // Mark current step as completed
            if (!completedSteps.includes(currentStep)) {
                completedSteps.push(currentStep);
            }

            // Remove any validation errors from current step
            const currentStepDiv = document.getElementById(`step${currentStep}`);
            currentStepDiv.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
            currentStepDiv.querySelectorAll('.validation-error').forEach(el => el.remove());
            currentStepDiv.querySelectorAll('.alert').forEach(el => el.remove());

            // Move to next step
            const tab = new bootstrap.Tab(document.getElementById(`step${step}-tab`));
            tab.show();
            window.scrollTo(0, 0);

            // Initialize map when step 3 is shown
            if (step === 3 && !map) {
                setTimeout(function() {
                    initMap();
                    // Fix map display issue
                    setTimeout(function() {
                        map.invalidateSize();
                    }, 100);
                }, 100);
            }
        }

        function prevStep(step) {
            event.preventDefault();

            // Remove validation errors when going back
            const allSteps = document.querySelectorAll('.tab-pane');
            allSteps.forEach(stepDiv => {
                stepDiv.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
                stepDiv.querySelectorAll('.validation-error').forEach(el => el.remove());
                stepDiv.querySelectorAll('.alert').forEach(el => el.remove());
            });

            const tab = new bootstrap.Tab(document.getElementById(`step${step}-tab`));
            tab.show();
            window.scrollTo(0, 0);
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Prevent direct clicking on navigation tabs
            const stepTabs = document.querySelectorAll('#stepNav .nav-link');
            stepTabs.forEach((tab, index) => {
                tab.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const targetStep = index + 1;

                    // Only allow clicking on completed steps or the current step
                    if (targetStep === 1 || completedSteps.includes(targetStep - 1)) {
                        // Allow navigation to previous steps
                        const tab = new bootstrap.Tab(this);
                        tab.show();
                        window.scrollTo(0, 0);
                    } else {
                        // Show message that they need to complete previous steps
                        const alertDiv = document.createElement('div');
                        alertDiv.className = 'alert alert-warning alert-dismissible fade show';
                        alertDiv.innerHTML = `
                            <strong>Notice!</strong> Please complete the previous steps before proceeding to this step.
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        `;
                        document.querySelector('.container-fluid').insertBefore(alertDiv, document.querySelector('form'));

                        setTimeout(() => {
                            alertDiv.remove();
                        }, 3000);
                    }

                    return false;
                });
            });

            const step3Tab = document.getElementById('step3-tab');
            step3Tab.addEventListener('shown.bs.tab', function() {
                if (!map) {
                    initMap();
                    setTimeout(function() {
                        map.invalidateSize();
                    }, 100);
                }
            });

            // Disable autofill for email and password fields
            setTimeout(function() {
                const emailField = document.querySelector('input[name="Email"]');
                const passwordField = document.querySelector('input[name="Password"]');

                if (emailField && emailField.value) {
                    emailField.value = '';
                }
                if (passwordField && passwordField.value) {
                    passwordField.value = '';
                }
            }, 100);

            // Remove validation styling when user starts typing
            document.querySelectorAll('input, select, textarea').forEach(field => {
                field.addEventListener('input', function() {
                    this.classList.remove('is-invalid');
                    const errorMsg = this.parentElement.querySelector('.validation-error');
                    if (errorMsg) {
                        errorMsg.remove();
                    }
                });

                field.addEventListener('change', function() {
                    this.classList.remove('is-invalid');
                    const errorMsg = this.parentElement.querySelector('.validation-error');
                    if (errorMsg) {
                        errorMsg.remove();
                    }
                });
            });

            // Form submission validation
            const form = document.getElementById('parentForm');
            form.addEventListener('submit', function(e) {
                // Validate all steps before final submission
                let allValid = true;
                for (let i = 1; i <= 3; i++) {
                    if (!validateStep(i)) {
                        allValid = false;
                        // Show the first step with errors
                        const tab = new bootstrap.Tab(document.getElementById(`step${i}-tab`));
                        tab.show();
                        break;
                    }
                }

                if (!allValid) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>

