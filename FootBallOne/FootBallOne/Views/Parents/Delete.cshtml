@model FootBallOne.Models.Parent

@{
    ViewData["Title"] = "Confirm Delete Parent";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white text-center">
                    <h4>
                        <i class="fas fa-exclamation-triangle me-2"></i> Confirm Deletion
                    </h4>
                </div>
                <div class="card-body">
                    <p class="mb-3 text-center">
                        Are you sure you want to delete the parent:
                        <strong>@Model.Fullname</strong>?
                    </p>
                    <p class="text-muted text-center mb-4">
                        This action is permanent and cannot be undone. All associated phone numbers will also be deleted.
                    </p>

                    <!-- Parent Details -->
                    <div class="mb-3">
                        <h5>Parent Details</h5>
                        <ul class="list-group">
                            <li class="list-group-item">
                                <strong>Full Name:</strong> @Model.Fullname
                            </li>
                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <li class="list-group-item">
                                    <strong>Email:</strong> @Model.Email
                                </li>
                            }
                            <li class="list-group-item">
                                <strong>Mobile Number:</strong> +966 @Model.MobileNo
                            </li>
                            <li class="list-group-item">
                                <strong>Gender:</strong> @Model.Gender
                            </li>
                            @if (!string.IsNullOrEmpty(Model.IqamaID))
                            {
                                <li class="list-group-item">
                                    <strong>ID/Iqama Number:</strong> @Model.IqamaID
                                </li>
                            }
                            <li class="list-group-item">
                                <strong>Status:</strong>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </li>
                            @if (Model.Registration != null)
                            {
                                <li class="list-group-item">
                                    <strong>Student:</strong> @Model.Registration.Name
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(Model.Address))
                            {
                                <li class="list-group-item">
                                    <strong>Address:</strong> @Model.Address
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(Model.City))
                            {
                                <li class="list-group-item">
                                    <strong>City:</strong> @Model.City
                                </li>
                            }
                            @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                            {
                                <li class="list-group-item">
                                    <strong>Location:</strong> Lat: @Model.Latitude.Value.ToString("F6"), Lng: @Model.Longitude.Value.ToString("F6")
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(Model.Note))
                            {
                                <li class="list-group-item">
                                    <strong>Notes:</strong> @Model.Note
                                </li>
                            }
                            <li class="list-group-item">
                                <strong>Created Date:</strong> @Model.CreatedDate.ToString("dd-MMM-yyyy hh:mm tt")
                            </li>
                        </ul>
                    </div>

                    <!-- Phone Numbers -->
                    @if (Model.PhoneNumbers != null && Model.PhoneNumbers.Any())
                    {
                        <div class="mb-3">
                            <h5>Phone Numbers</h5>
                            <table class="table table-bordered table-striped">
                                <thead class="table-light">
                                    <tr>
                                        <th>Phone Number</th>
                                        <th>Label</th>
                                        <th>WhatsApp</th>
                                        <th>Primary</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var phone in Model.PhoneNumbers.OrderBy(p => p.IsPrimary ? 0 : 1))
                                    {
                                        <tr>
                                            <td>+966 @phone.PhoneNo</td>
                                            <td>
                                                <span class="badge bg-info">@phone.Label</span>
                                            </td>
                                            <td class="text-center">
                                                @if (phone.IsWhatsApp)
                                                {
                                                    <i class="fab fa-whatsapp text-success" style="font-size: 1.2rem;"></i>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (phone.IsPrimary)
                                                {
                                                    <span class="badge bg-primary">Primary</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(phone.Notes))
                                                {
                                                    @phone.Notes
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <!-- Warning Message -->
                    <div class="alert alert-warning d-flex align-items-center" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <div>
                            <strong>Warning:</strong> Deleting this parent will permanently remove all associated data including phone numbers.
                        </div>
                    </div>

                    <!-- Delete Form -->
                    <form asp-action="Delete" method="post" class="text-center">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center gap-3">
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="fas fa-trash-alt me-2"></i> Delete Parent
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="fas fa-times-circle me-2"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FontAwesome (optional if already in _Layout) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    .card {
        border: none;
        border-radius: 10px;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
        padding: 1.5rem;
    }

    .list-group-item {
        border-left: none;
        border-right: none;
    }

        .list-group-item:first-child {
            border-top: none;
        }

        .list-group-item:last-child {
            border-bottom: none;
        }

    .table {
        margin-bottom: 0;
    }

    .btn-lg {
        padding: 0.75rem 2rem;
        font-size: 1.1rem;
    }

    .gap-3 {
        gap: 1rem !important;
    }

    .shadow-sm {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075) !important;
    }
</style>