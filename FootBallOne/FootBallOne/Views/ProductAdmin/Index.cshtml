@model FootBallOne.ViewModels.ProductAdminDashboardViewModel

@{
    ViewData["Title"] = "ProductAdmin Dashboard";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<div class="container-fluid my-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5">
                <i class="bi bi-speedometer2"></i> ProductAdmin Dashboard
            </h1>
            <p class="lead text-muted">Manage your e-commerce store</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="btn-group" role="group">
                <a asp-action="CreateProduct" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Add New Product
                </a>
                <a asp-action="Products" class="btn btn-outline-primary">
                    <i class="bi bi-box-seam"></i> Manage Products
                </a>
                <a asp-action="Categories" class="btn btn-outline-primary">
                    <i class="bi bi-tags"></i> Manage Categories
                </a>
                <a asp-action="Orders" class="btn btn-outline-primary">
                    <i class="bi bi-receipt"></i> View Orders
                </a>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <!-- Total Orders -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow-sm border-primary">
                <div class="card-body text-center">
                    <i class="bi bi-cart-check text-primary" style="font-size: 2.5rem;"></i>
                    <h3 class="mt-2 mb-0">@Model.OrderStatistics.TotalOrders</h3>
                    <p class="text-muted mb-0">Total Orders</p>
                </div>
            </div>
        </div>

        <!-- Total Revenue -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow-sm border-success">
                <div class="card-body text-center">
                    <i class="bi bi-currency-rupee text-success" style="font-size: 2.5rem;"></i>
                    <h3 class="mt-2 mb-0">₹@Model.OrderStatistics.TotalRevenue.ToString("N0")</h3>
                    <p class="text-muted mb-0">Total Revenue</p>
                </div>
            </div>
        </div>

        <!-- Total Products -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow-sm border-info">
                <div class="card-body text-center">
                    <i class="bi bi-box-seam text-info" style="font-size: 2.5rem;"></i>
                    <h3 class="mt-2 mb-0">@Model.TotalProducts</h3>
                    <p class="text-muted mb-0">Total Products</p>
                </div>
            </div>
        </div>

        <!-- Pending Orders -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow-sm border-warning">
                <div class="card-body text-center">
                    <i class="bi bi-clock-history text-warning" style="font-size: 2.5rem;"></i>
                    <h3 class="mt-2 mb-0">@Model.OrderStatistics.PendingOrders</h3>
                    <p class="text-muted mb-0">Pending Orders</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary Stats -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Active Products</h6>
                    <h4 class="mb-0">@Model.ActiveProducts</h4>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Low Stock Products</h6>
                    <h4 class="mb-0 text-warning">@Model.LowStockProducts</h4>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Out of Stock</h6>
                    <h4 class="mb-0 text-danger">@Model.OutOfStockProducts</h4>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Average Order Value</h6>
                    <h4 class="mb-0">₹@Model.OrderStatistics.AverageOrderValue.ToString("N2")</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Recent Orders</h5>
                    <a asp-action="Orders" class="btn btn-sm btn-light">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order Number</th>
                                        <th>Date</th>
                                        <th>Customer ID</th>
                                        <th>Items</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.RecentOrders)
                                    {
                                        <tr>
                                            <td><strong>@order.OrderNumber</strong></td>
                                            <td>@order.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td>@order.Id</td>
                                            <td>@order.OrderItems.Count() items</td>
                                            <td><strong>₹@order.TotalAmount.ToString("N2")</strong></td>
                                            <td>
                                                @if (order.OrderStatus == "Pending")
                                                {
                                                    <span class="badge bg-warning text-dark">@order.OrderStatus</span>
                                                }
                                                else if (order.OrderStatus == "Processing")
                                                {
                                                    <span class="badge bg-info">@order.OrderStatus</span>
                                                }
                                                else if (order.OrderStatus == "Shipped")
                                                {
                                                    <span class="badge bg-primary">@order.OrderStatus</span>
                                                }
                                                else if (order.OrderStatus == "Delivered")
                                                {
                                                    <span class="badge bg-success">@order.OrderStatus</span>
                                                }
                                                else if (order.OrderStatus == "Cancelled")
                                                {
                                                    <span class="badge bg-danger">@order.OrderStatus</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="OrderDetails" asp-route-id="@order.OrderId"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye"></i> View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-3">No orders yet</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>