@model FootBallOne.Models.FBProduct

@{
    ViewData["Title"] = "Edit Product";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<div class="container-fluid my-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-6">
                <i class="bi bi-pencil"></i> Edit Product
            </h1>
            <p class="text-muted">@Model.ProductName</p>
        </div>
    </div>

    <form asp-action="EditProduct" method="post">
        <input type="hidden" asp-for="ProductId" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="ViewCount" />

        <div class="row">
            <!-- Main Product Info -->
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Product Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <!-- Product Name -->
                            <div class="col-12">
                                <label asp-for="ProductName" class="form-label"></label>
                                <input asp-for="ProductName" class="form-control" required>
                                <span asp-validation-for="ProductName" class="text-danger"></span>
                            </div>

                            <!-- SKU & Brand -->
                            <div class="col-md-6">
                                <label asp-for="SKU" class="form-label"></label>
                                <input asp-for="SKU" class="form-control" required>
                                <span asp-validation-for="SKU" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Brand" class="form-label"></label>
                                <input asp-for="Brand" class="form-control">
                                <span asp-validation-for="Brand" class="text-danger"></span>
                            </div>

                            <!-- Description -->
                            <div class="col-12">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <!-- Category -->
                            <div class="col-12">
                                <label asp-for="CategoryId" class="form-label"></label>
                                <select asp-for="CategoryId" class="form-select" required>
                                    <option value="">Select Category</option>
                                    @foreach (var category in ViewBag.Categories)
                                    {
                                        <option value="@category.CategoryId"
                                                selected="@(category.CategoryId == Model.CategoryId)">
                                            @category.CategoryName
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <!-- Price & Discount -->
                            <div class="col-md-6">
                                <label asp-for="BasePrice" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="BasePrice" class="form-control" type="number" step="0.01" required>
                                </div>
                                <span asp-validation-for="BasePrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DiscountPercentage" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="DiscountPercentage" class="form-control" type="number"
                                           step="0.01" min="0" max="100">
                                    <span class="input-group-text">%</span>
                                </div>
                                <span asp-validation-for="DiscountPercentage" class="text-danger"></span>
                            </div>

                            <!-- Stock & Min Stock -->
                            <div class="col-md-6">
                                <label asp-for="StockQuantity" class="form-label"></label>
                                <input asp-for="StockQuantity" class="form-control" type="number" min="0" required>
                                <span asp-validation-for="StockQuantity" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MinStockLevel" class="form-label"></label>
                                <input asp-for="MinStockLevel" class="form-control" type="number" min="0" required>
                                <span asp-validation-for="MinStockLevel" class="text-danger"></span>
                            </div>

                            <!-- Weight & Dimensions -->
                            <div class="col-md-6">
                                <label asp-for="Weight" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="Weight" class="form-control" type="number" step="0.01">
                                    <span class="input-group-text">kg</span>
                                </div>
                                <span asp-validation-for="Weight" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Dimensions" class="form-label"></label>
                                <input asp-for="Dimensions" class="form-control"
                                       placeholder="L x W x H">
                                <span asp-validation-for="Dimensions" class="text-danger"></span>
                            </div>

                            <!-- Tags -->
                            <div class="col-12">
                                <label asp-for="Tags" class="form-label"></label>
                                <input asp-for="Tags" class="form-control">
                                <small class="text-muted">Separate tags with commas</small>
                                <span asp-validation-for="Tags" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Settings & Actions -->
            <div class="col-lg-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0">Product Settings</h6>
                    </div>
                    <div class="card-body">
                        <!-- Is Active -->
                        <div class="form-check mb-3">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox">
                            <label asp-for="IsActive" class="form-check-label">
                                Active (visible to customers)
                            </label>
                        </div>

                        <!-- Is Featured -->
                        <div class="form-check mb-3">
                            <input asp-for="IsFeatured" class="form-check-input" type="checkbox">
                            <label asp-for="IsFeatured" class="form-check-label">
                                Featured Product
                            </label>
                        </div>

                        <hr>

                        <!-- Price Preview -->
                        <div class="alert alert-info">
                            <h6 class="mb-2">Price Preview:</h6>
                            <p class="mb-1"><strong>Base Price:</strong> ₹<span id="basePreview">@Model.BasePrice.ToString("N2")</span></p>
                            <p class="mb-1"><strong>Discount:</strong> <span id="discountPreview">@Model.DiscountPercentage</span>%</p>
                            <p class="mb-0"><strong>Final Price:</strong> ₹<span id="finalPreview">@Model.FinalPrice.ToString("N2")</span></p>
                        </div>

                        <hr>

                        <!-- Stats -->
                        <div class="mb-2">
                            <small class="text-muted">Created:</small><br />
                            <small>@Model.CreatedAt.ToString("MMM dd, yyyy")</small>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">Last Updated:</small><br />
                            <small>@Model.UpdatedAt.ToString("MMM dd, yyyy")</small>
                        </div>
                        <div>
                            <small class="text-muted">Views:</small><br />
                            <small>@Model.ViewCount</small>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                            <a asp-action="Products" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Price Preview Calculator
        function updatePricePreview() {
            var basePrice = parseFloat($('#BasePrice').val()) || 0;
            var discount = parseFloat($('#DiscountPercentage').val()) || 0;
            var finalPrice = basePrice - (basePrice * discount / 100);

            $('#basePreview').text(basePrice.toFixed(2));
            $('#discountPreview').text(discount.toFixed(2));
            $('#finalPreview').text(finalPrice.toFixed(2));
        }

        $('#BasePrice, #DiscountPercentage').on('input', updatePricePreview);
    </script>
}