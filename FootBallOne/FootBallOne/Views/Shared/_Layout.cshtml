    <script>
                const wrapper = document.getElementById('app-wrapper');
        const sidebarToggle = document.getElementById('sidebarToggle');

        // Function to update tooltips based on sidebar state
        function updateTooltips() {
            const isCollapsed = wrapper.classList.contains('sidebar-collapsed');
            document.querySelectorAll('.sidebar-link').forEach(link => {
                const label = link.querySelector('.label');
                if (label && isCollapsed) {
                    // Set the title attribute for the tooltip when collapsed
                    link.setAttribute('title', label.textContent.trim());
                } else {
                    // Remove the title attribute when expanded
                    link.removeAttribute('title');
                }
            });
        }

        // Toggle sidebar and update tooltips
        sidebarToggle.addEventListener('click', () => {
            wrapper.classList.toggle('sidebar-collapsed');

            // Close all dropdowns when sidebar collapses
            if (wrapper.classList.contains('sidebar-collapsed')) {
                document.querySelectorAll('.sidebar-item').forEach(item => item.classList.remove('open'));
            }
            updateTooltips(); // Update tooltips after toggling
        });

        // Toggle submenu for dropdown items
        document.querySelectorAll('.caret-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation(); // Prevent the link click from firing
                const item = btn.closest('.sidebar-item');
                const isOpen = item.classList.toggle('open');

                // Close other open dropdowns
                document.querySelectorAll('.sidebar-item').forEach(other => {
                    if (other !== item) other.classList.remove('open');
                }); 
            });
        });

        // Initial call to set tooltips based on initial sidebar state
        updateTooltips();
         
    </script>

