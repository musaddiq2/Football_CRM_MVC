@model FootBallOne.Models.Camp

@{
    ViewData["Title"] = "Confirm Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white text-center">
                    <h4>
                        <i class="fas fa-exclamation-triangle me-2"></i> Confirm Deletion / تأكيد الحذف
                    </h4>
                </div>
                <div class="card-body">
                    <p class="mb-3 text-center">
                        Are you sure you want to delete this camp?<br />
                        <strong>@Model.CampName</strong>
                    </p>
                    <p class="text-muted text-center mb-4">
                        This action is permanent and cannot be undone. / هذا الإجراء دائم ولا يمكن التراجع عنه
                    </p>

                    <!-- Camp Details -->
                    <div class="mb-3">
                        <h5>Details / التفاصيل</h5>
                        <ul class="list-group">
                            <li class="list-group-item"><strong>Branch / الفرع:</strong> @Model.Branch</li>
                            <li class="list-group-item"><strong>Start Date / تاريخ البدء:</strong> @Model.StartDate.ToString("dd-MMM-yyyy")</li>
                            <li class="list-group-item"><strong>End Date / تاريخ الانتهاء:</strong> @Model.EndDate.ToString("dd-MMM-yyyy")</li>
                            <li class="list-group-item"><strong>Ticket Price / سعر التذكرة:</strong> ₹@Model.TicketPrice.ToString("0.00")</li>
                            <li class="list-group-item">
                                <strong>Status / الحالة:</strong>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active / نشط</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive / غير نشط</span>
                                }
                            </li>
                        </ul>
                    </div>

                    <!-- Action Buttons -->
                    <div class="text-center mt-4">
                        <form asp-action="Delete" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="CampID" />
                            <button type="submit" class="btn px-4 py-2 me-2" style="background-color: #d9534f; color: white; border: none; border-radius: 0.375rem; font-size: 15px; font-weight: 400;">
                                <i class="bi bi-trash me-2"></i>Delete / حذف
                            </button>
                        </form>
                        <a asp-action="Index" class="btn px-4 py-2" style="background-color: #6c757d; color: white; border: none; border-radius: 0.375rem; font-size: 15px; font-weight: 400; text-decoration: none;">
                            <i class="bi bi-x-circle me-2"></i>Cancel / إلغاء
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FontAwesome (optional if already in _Layout) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
