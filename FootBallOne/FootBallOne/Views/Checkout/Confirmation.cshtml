@model FootBallOne.ViewModels.OrderConfirmationViewModel

@{
    ViewData["Title"] = "Order Confirmation";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<div class="container my-5">
    <!-- Success Message -->
    <div class="row mb-5">
        <div class="col-12 text-center">
            <div class="mb-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
            </div>
            <h1 class="display-4 mb-3">Order Placed Successfully!</h1>
            <p class="lead text-muted">Thank you for your order</p>
            <p class="text-muted">
                We've received your order and will process it shortly.
            </p>
        </div>
    </div>

    <!-- Order Details Card -->
    <div class="row justify-content-center mb-4">
        <div class="col-lg-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Order Details</h5>
                        <span class="badge bg-light text-dark">@Model.Order.OrderStatus</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <!-- Order Number -->
                        <div class="col-md-4 mb-3">
                            <p class="text-muted mb-1">Order Number</p>
                            <h6 class="mb-0">@Model.Order.OrderNumber</h6>
                        </div>

                        <!-- Order Date -->
                        <div class="col-md-4 mb-3">
                            <p class="text-muted mb-1">Order Date</p>
                            <h6 class="mb-0">@Model.Order.CreatedAt.ToString("MMM dd, yyyy HH:mm")</h6>
                        </div>

                        <!-- Payment Method -->
                        <div class="col-md-4 mb-3">
                            <p class="text-muted mb-1">Payment Method</p>
                            <h6 class="mb-0">@Model.Order.PaymentMethod</h6>
                        </div>
                    </div>

                    <hr>

                    <!-- Order Items -->
                    <h6 class="mb-3">Order Items</h6>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@(item.Product?.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/images/no-image.jpg")"
                                                     alt="@item.ProductName"
                                                     class="rounded me-3"
                                                     style="width: 60px; height: 60px; object-fit: cover;">
                                                <div>
                                                    <h6 class="mb-1">@item.ProductName</h6>
                                                    <small class="text-muted">SKU: @item.SKU</small>
                                                    @if (!string.IsNullOrEmpty(item.Size) || !string.IsNullOrEmpty(item.Color))
                                                    {
                                                        <br />
                                                        <small class="text-muted">
                                                            @if (!string.IsNullOrEmpty(item.Size))
                                                            {
                                                                <span>Size: @item.Size</span>
                                                            }
                                                            @if (!string.IsNullOrEmpty(item.Color))
                                                            {
                                                                <span class="ms-2">Color: @item.Color</span>
                                                            }
                                                        </small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="align-middle">₹@item.UnitPrice.ToString("N2")</td>
                                        <td class="align-middle">@item.Quantity</td>
                                        <td class="align-middle text-end">
                                            <strong>₹@item.TotalPrice.ToString("N2")</strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <hr>

                    <!-- Price Summary -->
                    <div class="row">
                        <div class="col-md-6 offset-md-6">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal:</span>
                                <strong>₹@Model.Order.SubTotal.ToString("N2")</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Shipping:</span>
                                @if (Model.Order.ShippingCost == 0)
                                {
                                    <strong class="text-success">FREE</strong>
                                }
                                else
                                {
                                    <strong>₹@Model.Order.ShippingCost.ToString("N2")</strong>
                                }
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Tax:</span>
                                <strong>₹@Model.Order.TaxAmount.ToString("N2")</strong>
                            </div>
                            @if (Model.Order.DiscountAmount > 0)
                            {
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Discount:</span>
                                    <strong class="text-success">-₹@Model.Order.DiscountAmount.ToString("N2")</strong>
                                </div>
                            }
                            <hr>
                            <div class="d-flex justify-content-between mb-0">
                                <h5>Total:</h5>
                                <h4 class="text-primary">₹@Model.Order.TotalAmount.ToString("N2")</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Shipping Information -->
    <div class="row justify-content-center mb-4">
        <div class="col-lg-10">
            <div class="row g-4">
                <!-- Shipping Address -->
                <div class="col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="bi bi-truck"></i> Shipping Address</h6>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>@Model.Order.ContactName</strong></p>
                            <p class="mb-1">@Model.Order.ShippingAddress</p>
                            <p class="mb-1">@Model.Order.ShippingCity, @Model.Order.ShippingState</p>
                            <p class="mb-1">@Model.Order.ShippingPostalCode</p>
                            <p class="mb-0">@Model.Order.ShippingCountry</p>
                        </div>
                    </div>
                </div>

                <!-- Contact Information -->
                <div class="col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="bi bi-person"></i> Contact Information</h6>
                        </div>
                        <div class="card-body">
                            <p class="mb-1">
                                <i class="bi bi-telephone"></i>
                                <strong>Phone:</strong> @Model.Order.ContactPhone
                            </p>
                            <p class="mb-1">
                                <i class="bi bi-envelope"></i>
                                <strong>Email:</strong> @Model.Order.ContactEmail
                            </p>
                            @if (!string.IsNullOrEmpty(Model.Order.OrderNotes))
                            {
                                <hr>
                                <p class="mb-1"><strong>Order Notes:</strong></p>
                                <p class="mb-0 text-muted">@Model.Order.OrderNotes</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- What's Next Section -->
    <div class="row justify-content-center mb-4">
        <div class="col-lg-10">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> What Happens Next?</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 text-center mb-3">
                            <i class="bi bi-box-seam text-primary" style="font-size: 2rem;"></i>
                            <h6 class="mt-2">Order Processing</h6>
                            <p class="small text-muted">We'll prepare your items for shipment</p>
                        </div>
                        <div class="col-md-4 text-center mb-3">
                            <i class="bi bi-truck text-primary" style="font-size: 2rem;"></i>
                            <h6 class="mt-2">Shipment</h6>
                            <p class="small text-muted">Your order will be dispatched soon</p>
                        </div>
                        <div class="col-md-4 text-center mb-3">
                            <i class="bi bi-house-door text-primary" style="font-size: 2rem;"></i>
                            <h6 class="mt-2">Delivery</h6>
                            <p class="small text-muted">Your order will arrive at your doorstep</p>
                        </div>
                    </div>
                    <div class="alert alert-info mb-0">
                        <small>
                            <i class="bi bi-envelope"></i>
                            A confirmation email has been sent to <strong>@Model.Order.ContactEmail</strong>
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row">
        <div class="col-12 text-center">
            <a asp-controller="Order" asp-action="Details" asp-route-id="@Model.Order.OrderId"
               class="btn btn-primary btn-lg me-2">
                <i class="bi bi-receipt"></i> View Order Details
            </a>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary btn-lg">
                <i class="bi bi-shop"></i> Continue Shopping
            </a>
        </div>
    </div>
</div>