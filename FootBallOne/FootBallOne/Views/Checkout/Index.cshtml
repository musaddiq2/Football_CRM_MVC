@model FootBallOne.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">


<div class="container my-5">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4">
                <i class="bi bi-credit-card"></i> Checkout
            </h1>
            <p class="lead text-muted">Complete your order</p>
        </div>
    </div>

    <!-- Progress Steps -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-center flex-fill">
                    <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center"
                         style="width: 40px; height: 40px;">
                        <i class="bi bi-check"></i>
                    </div>
                    <p class="small mt-2 mb-0">Cart</p>
                </div>
                <div class="flex-fill" style="height: 2px; background: #dee2e6;"></div>
                <div class="text-center flex-fill">
                    <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center"
                         style="width: 40px; height: 40px;">
                        2
                    </div>
                    <p class="small mt-2 mb-0 fw-bold">Checkout</p>
                </div>
                <div class="flex-fill" style="height: 2px; background: #dee2e6;"></div>
                <div class="text-center flex-fill">
                    <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center"
                         style="width: 40px; height: 40px;">
                        3
                    </div>
                    <p class="small mt-2 mb-0">Confirmation</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="PlaceOrder" method="post">
        <div class="row">
            <!-- Checkout Form -->
            <div class="col-lg-8 mb-4">
                <!-- Shipping Information -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-truck"></i> Shipping Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <!-- Full Name -->
                            <div class="col-md-6">
                                <label asp-for="ContactName" class="form-label"></label>
                                <input asp-for="ContactName" class="form-control" placeholder="Enter full name" required>
                                <span asp-validation-for="ContactName" class="text-danger"></span>
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6">
                                <label asp-for="ContactPhone" class="form-label"></label>
                                <input asp-for="ContactPhone" class="form-control" placeholder="Enter phone number" required>
                                <span asp-validation-for="ContactPhone" class="text-danger"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-12">
                                <label asp-for="ContactEmail" class="form-label"></label>
                                <input asp-for="ContactEmail" class="form-control" placeholder="Enter email address" required>
                                <span asp-validation-for="ContactEmail" class="text-danger"></span>
                            </div>

                            <!-- Address -->
                            <div class="col-12">
                                <label asp-for="ShippingAddress" class="form-label"></label>
                                <textarea asp-for="ShippingAddress" class="form-control" rows="3"
                                          placeholder="House No., Street, Area" required></textarea>
                                <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                            </div>

                            <!-- City -->
                            <div class="col-md-4">
                                <label asp-for="ShippingCity" class="form-label"></label>
                                <input asp-for="ShippingCity" class="form-control" placeholder="City" required>
                                <span asp-validation-for="ShippingCity" class="text-danger"></span>
                            </div>

                            <!-- State -->
                            <div class="col-md-4">
                                <label asp-for="ShippingState" class="form-label"></label>
                                <select asp-for="ShippingState" class="form-select" required>
                                    <option value="">Select State</option>
                                    <option value="Maharashtra">Maharashtra</option>
                                    <option value="Gujarat">Gujarat</option>
                                    <option value="Karnataka">Karnataka</option>
                                    <option value="Delhi">Delhi</option>
                                    <option value="Tamil Nadu">Tamil Nadu</option>
                                    <option value="West Bengal">West Bengal</option>
                                    <option value="Uttar Pradesh">Uttar Pradesh</option>
                                    <option value="Rajasthan">Rajasthan</option>
                                    <!-- Add more states as needed -->
                                </select>
                                <span asp-validation-for="ShippingState" class="text-danger"></span>
                            </div>

                            <!-- Postal Code -->
                            <div class="col-md-4">
                                <label asp-for="ShippingPostalCode" class="form-label"></label>
                                <input asp-for="ShippingPostalCode" class="form-control" placeholder="Postal Code" required>
                                <span asp-validation-for="ShippingPostalCode" class="text-danger"></span>
                            </div>

                            <!-- Country -->
                            <div class="col-12">
                                <label asp-for="ShippingCountry" class="form-label"></label>
                                <input asp-for="ShippingCountry" class="form-control" value="India" readonly>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Payment Method -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-wallet2"></i> Payment Method</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="PaymentMethod" id="cod"
                                   value="Cash on Delivery" checked required>
                            <label class="form-check-label" for="cod">
                                <strong>Cash on Delivery (COD)</strong>
                                <p class="small text-muted mb-0">Pay when you receive your order</p>
                            </label>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="radio" name="PaymentMethod" id="online"
                                   value="Online Payment" required>
                            <label class="form-check-label" for="online">
                                <strong>Online Payment</strong>
                                <p class="small text-muted mb-0">Pay securely using Credit/Debit Card, UPI, Net Banking</p>
                            </label>
                        </div>

                        <div class="alert alert-info mb-0">
                            <small>
                                <i class="bi bi-info-circle"></i>
                                All transactions are secure and encrypted
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Order Notes -->
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-chat-left-text"></i> Order Notes (Optional)</h5>
                    </div>
                    <div class="card-body">
                        <textarea asp-for="OrderNotes" class="form-control" rows="3"
                                  placeholder="Any special instructions for delivery?"></textarea>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <!-- Items List -->
                        <h6 class="mb-3">Items (@Model.TotalItems)</h6>
                        <div class="order-items-list mb-3" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var item in Model.CartItems)
                            {
                                <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                                    <img src="@(item.Product?.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/images/no-image.jpg")"
                                         alt="@item.Product?.ProductName"
                                         class="rounded me-2"
                                         style="width: 50px; height: 50px; object-fit: cover;">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0 small">@item.Product?.ProductName</h6>
                                        <small class="text-muted">Qty: @item.Quantity</small>
                                        @if (item.Variant != null)
                                        {
                                            <br />
                                            <small class="text-muted">
                                                @if (!string.IsNullOrEmpty(item.Variant.Size))
                                                {
                                                    <span>Size: @item.Variant.Size</span>
                                                }
                                                @if (!string.IsNullOrEmpty(item.Variant.Color))
                                                {
                                                    <span class="ms-1">Color: @item.Variant.Color</span>
                                                }
                                            </small>
                                        }
                                    </div>
                                    <strong class="small">₹@item.ItemTotal.ToString("N2")</strong>
                                </div>
                            }
                        </div>

                        <hr>

                        <!-- Price Breakdown -->
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <strong>₹@Model.Subtotal.ToString("N2")</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping:</span>
                            @if (Model.ShippingCost == 0)
                            {
                                <strong class="text-success">FREE</strong>
                            }
                            else
                            {
                                <strong>₹@Model.ShippingCost.ToString("N2")</strong>
                            }
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax (@Model.TaxRate%):</span>
                            <strong>₹@Model.TaxAmount.ToString("N2")</strong>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between mb-3">
                            <h5 class="mb-0">Total:</h5>
                            <h4 class="mb-0 text-primary">₹@Model.Total.ToString("N2")</h4>
                        </div>

                        <!-- Place Order Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle"></i> Place Order
                            </button>
                            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Cart
                            </a>
                        </div>

                        <!-- Security Note -->
                        <div class="text-center mt-3">
                            <small class="text-muted">
                                <i class="bi bi-shield-check"></i> Secure Checkout
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}