@model List<FootBallOne.Models.RegistrationManagement>
@{
    ViewData["Title"] = "Stopped Players";
    Layout = "_Layout";
}

<h2 class="mb-4 text-danger">⛔ Stopped Players (Subscription Ended)</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No stopped players found.</div>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Coach</th>
                <th>Phone</th>
                <th>Subscription End</th>
                <th>Payment Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var player in Model)
            {
                <tr>
                    <td>@player.Name</td>
                    <td>@player.CoachName</td>
                    <td>@player.PhoneNo</td>
                    <td>@(player.SubscriptionEnd != null ? player.SubscriptionEnd.Value.ToShortDateString() : "N/A")</td>

                    <td><span class="badge bg-danger">@player.PaymentStatus</span></td>
                </tr>
            }
        </tbody>
    </table>
}
