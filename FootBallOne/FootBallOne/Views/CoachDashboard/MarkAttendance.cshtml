@model List<FootBallOne.Models.CoachAttendance>

@{
    ViewData["Title"] = "Mark Attendance";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FootBallOne</title>
    <!-- Bootstrap CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" xintegrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Google Fonts - Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f2f5; /* Light gray background */
        }

        .container {
            max-width: 900px; /* Max width for better readability */
            background-color: #ffffff;
            padding: 30px;
            border-radius: 15px; /* Rounded corners for the container */
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1); /* Soft shadow */
            margin-top: 50px;
            margin-bottom: 50px;
        }

        h2 {
            color: #2c3e50; /* Darker heading color */
            font-weight: 600;
            text-align: center;
            margin-bottom: 30px;
        }

        .table {
            border-radius: 10px; /* Rounded corners for the table */
            overflow: hidden; /* Ensures rounded corners apply to content */
            margin-bottom: 30px;
        }

            .table thead {
                background-color: #34495e; /* Darker header background */
                color: #ecf0f1; /* Light text color for header */
            }

            .table th, .table td {
                vertical-align: middle;
                padding: 12px 15px;
            }

        .table-hover tbody tr:hover {
            background-color: #e9ecef; /* Lighter hover effect */
        }

        .form-control {
            border-radius: 8px; /* Rounded input fields */
            border-color: #ced4da;
        }

        .form-check-input {
            width: 1.2em;
            height: 1.2em;
            border-radius: 0.25em; /* Slightly rounded checkbox */
            margin-top: 0.25em;
        }

        .btn-success {
            background-color: #28a745; /* Green button */
            border-color: #28a745;
            padding: 10px 25px;
            font-size: 1.1em;
            border-radius: 10px; /* Rounded button */
            transition: background-color 0.3s ease, transform 0.2s ease;
            display: block; /* Make button full width */
            width: fit-content; /* Adjust width to content */
            margin: 0 auto; /* Center the button */
        }

            .btn-success:hover {
                background-color: #218838; /* Darker green on hover */
                border-color: #1e7e34;
                transform: translateY(-2px); /* Slight lift effect */
            }

        .alert {
            border-radius: 10px; /* Rounded alerts */
            text-align: center;
            font-weight: 500;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <h2 class="mb-4">📋 Mark Attendance</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        else if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <form asp-action="MarkAttendance" method="post">
            <div class="table-responsive">
                <!-- Make table responsive -->
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Player</th>
                            <th>Coach</th>
                            <th class="text-center">Present</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <td>
                                    @Model[i].PlayerName
                                    <input type="hidden" name="[@i].PlayerName" value="@Model[i].PlayerName" />
                                </td>
                                <td>
                                    @Model[i].CoachName
                                    <input type="hidden" name="[@i].CoachName" value="@Model[i].CoachName" />
                                </td>
                                <td class="text-center">
                                    <div class="form-check d-flex justify-content-center">
                                        <input class="form-check-input" type="checkbox" name="[@i].IsPresent" value="true" id="isPresent_@i" @(Model[i].IsPresent ? "checked" : "")>
                                        <input type="hidden" name="[@i].IsPresent" value="false" />
                                    </div>
                                </td>
                                <td>
                                    <input type="text" name="[@i].Remarks" value="@Model[i].Remarks" class="form-control" placeholder="Add remarks..." />
                                </td>

                                <!-- ✅ Hidden input to bind attendance date -->
                                <input type="hidden" name="[@i].Date"
                                       value="@(Model[i].Date?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <button type="submit" class="btn btn-success mt-3">Submit Attendance</button>
        </form>
    </div>

    <!-- Bootstrap JS CDN (Optional, for interactive components like dropdowns, tooltips) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" xintegrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
