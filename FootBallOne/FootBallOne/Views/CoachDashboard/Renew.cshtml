@model List<FootBallOne.Models.RegistrationManagement>
@{
    ViewData["Title"] = "Renewal Alerts";
    Layout = "_Layout";
}

<h2 class="mb-4 text-warning">🔔 Players Needing Renewal (Expiring Soon)</h2>

@if (!Model.Any())
{
    <div class="alert alert-success">No upcoming renewals in the next 5 days.</div>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="table-warning">
            <tr>
                <th>Name</th>
                <th>Coach</th>
                <th>Phone</th>
                <th>Subscription End</th>
                <th>Payment Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var player in Model)
            {
                <tr>
                    <td>@player.Name</td>
                    <td>@player.CoachName</td>
                    <td>@player.PhoneNo</td>
                    <td>@(player.SubscriptionEnd.HasValue? player.SubscriptionEnd.Value.ToShortDateString() : "N/A")</td>

                    <td>
                        @if (player.PaymentStatus == "Paid")
                        {
                            <span class="badge bg-success">Paid</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Unpaid</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
