@model FootBallOne.Models.TrainingManagementViewModel

@{
    ViewData["Title"] = "Training Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Training Details</h2>

    <div class="card mb-4 shadow-sm p-3">
        @* Optional Activity Image *@
        @if (!string.IsNullOrEmpty(Model.ActivityImage))
        {
            <div class="mb-3 text-center">
                <img src="@Model.ActivityImage" alt="Activity Image" class="img-fluid rounded" style="max-height:200px;" />
            </div>
        }

        <dl class="row">
            <dt class="col-sm-3">Activity Name</dt>
            <dd class="col-sm-9">@Model.ActivityName</dd>

            <dt class="col-sm-3">Activity Type</dt>
            <dd class="col-sm-9">@Model.ActivityType</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Training Level</dt>
            <dd class="col-sm-9">@Model.TrainingLevel</dd>

            <dt class="col-sm-3">Age Group</dt>
            <dd class="col-sm-9">@Model.AgeGroup</dd>

            <dt class="col-sm-3">Branch</dt>
            <dd class="col-sm-9">@Model.Branch</dd>

            <dt class="col-sm-3">Gender</dt>
            <dd class="col-sm-9">@Model.Gender</dd>

            <dt class="col-sm-3">Facilities</dt>
            <dd class="col-sm-9">@Model.Facilities</dd>

            <dt class="col-sm-3">Start Date</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("dd-MMM-yyyy")</dd>

            <dt class="col-sm-3">End Date</dt>
            <dd class="col-sm-9">@Model.EndDate.ToString("dd-MMM-yyyy")</dd>

            <dt class="col-sm-3">Maximum Capacity</dt>
            <dd class="col-sm-9">@Model.MaximumCapacity</dd>

            <dt class="col-sm-3">Minimum Subscribers</dt>
            <dd class="col-sm-9">@Model.MinimumSubscribers</dd>

            <dt class="col-sm-3">Cost Type</dt>
            <dd class="col-sm-9">@Model.CostType</dd>

            <dt class="col-sm-3">Total Course Cost</dt>
            <dd class="col-sm-9">@Model.TotalCourseCost?.ToString("C")</dd>

            <dt class="col-sm-3">Profit Margin</dt>
            <dd class="col-sm-9">@Model.ProfitMargin?.ToString("C")</dd>

            <dt class="col-sm-3">Terms & Conditions</dt>
            <dd class="col-sm-9">@Model.TermsConditions</dd>

            <dt class="col-sm-3">Trainers</dt>
            <dd class="col-sm-9">@Model.Trainers</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                    @Model.Status
                </span>
            </dd>
        </dl>

        <h4 class="mt-4">Course Schedules</h4>
        @if (Model.CourseSchedules != null && Model.CourseSchedules.Any())
        {
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Day</th>
                        <th>Start Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var schedule in Model.CourseSchedules)
                    {
                        <tr>
                            <td>@schedule.Day</td>
                            <td>@schedule.StartTime.ToString(@"hh\:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No schedules available.</p>
        }

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            <a asp-action="EditTraining" asp-route-id="@Model.TrainingId" class="btn btn-primary">Edit</a>
        </div>
    </div>
</div>
