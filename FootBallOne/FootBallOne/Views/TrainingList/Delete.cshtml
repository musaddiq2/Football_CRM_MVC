@model FootBallOne.Models.TrainingManagementViewModel

@{
    ViewData["Title"] = "Confirm Delete";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Use your shared layout
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white text-center">
                    <h4>
                        <i class="fas fa-exclamation-triangle me-2"></i> Confirm Deletion
                    </h4>
                </div>
                <div class="card-body">
                    <p class="mb-3 text-center">
                        Are you sure you want to delete the training activity:
                        <strong>@Model.ActivityName</strong>?
                    </p>
                    <p class="text-muted text-center mb-4">
                        This action is permanent and cannot be undone.
                    </p>

                    <!-- Training Details -->
                    <div class="mb-3">
                        <h5>Details</h5>
                        <ul class="list-group">
                            <li class="list-group-item"><strong>Type:</strong> @Model.ActivityType</li>
                            <li class="list-group-item"><strong>Start Date:</strong> @Model.StartDate.ToString("dd-MMM-yyyy")</li>
                            <li class="list-group-item"><strong>End Date:</strong> @Model.EndDate.ToString("dd-MMM-yyyy")</li>
                        </ul>
                    </div>

                    <!-- Course Schedules -->
                    @if (Model.CourseSchedules != null && Model.CourseSchedules.Any())
                    {
                        <div class="mb-3">
                            <h5>Course Schedules</h5>
                            <table class="table table-bordered table-striped text-center">
                                <thead class="table-light">
                                    <tr>
                                        <th>Day</th>
                                        <th>Start Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var schedule in Model.CourseSchedules)
                                    {
                                        <tr>
                                            <td>@schedule.Day</td>
                                            <td>@schedule.StartTime.ToString(@"hh\:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <!-- Delete Form -->
                    <form asp-action="Delete" method="post" class="text-center">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="TrainingId" />
                        <div class="d-flex justify-content-center gap-3">
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="fas fa-trash-alt me-2"></i> Delete
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="fas fa-times-circle me-2"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FontAwesome (optional if already in _Layout) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
