@model FootBallOne.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Shopping Cart";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<div class="container my-5">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4">
                <i class="bi bi-cart"></i> Shopping Cart
            </h1>
            <p class="lead text-muted">Review your items before checkout</p>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Validation Errors -->
    @if (Model.ValidationErrors != null && Model.ValidationErrors.Any())
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <h5 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Cart Issues:</h5>
            <ul class="mb-0">
                @foreach (var error in Model.ValidationErrors)
                {
                    <li>@error</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.CartItems != null && Model.CartItems.Any())
    {
        <div class="row">
            <!-- Cart Items -->
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Cart Items (@Model.TotalItems)</h5>
                        <form asp-action="Clear" method="post" onsubmit="return confirm('Are you sure you want to clear your cart?');">
                            <button type="submit" class="btn btn-sm btn-outline-light">
                                <i class="bi bi-trash"></i> Clear Cart
                            </button>
                        </form>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Price</th>
                                        <th style="width: 150px;">Quantity</th>
                                        <th>Total</th>
                                        <th style="width: 100px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.CartItems)
                                    {
                                        var imageUrl = item.Product?.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/images/no-image.jpg";
                                        var itemPrice = item.Product?.FinalPrice ?? 0;
                                        if (item.Variant != null)
                                        {
                                            itemPrice += item.Variant.AdditionalPrice;
                                        }

                                        <tr>
                                            <!-- Product Info -->
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="@imageUrl" alt="@item.Product?.ProductName"
                                                         class="rounded me-3" style="width: 80px; height: 80px; object-fit: cover;">
                                                    <div>
                                                        <h6 class="mb-1">
                                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId"
                                                               class="text-decoration-none text-dark">
                                                                @item.Product?.ProductName
                                                            </a>
                                                        </h6>
                                                        @if (item.Variant != null)
                                                        {
                                                            <small class="text-muted">
                                                                @if (!string.IsNullOrEmpty(item.Variant.Size))
                                                                {
                                                                    <span>Size: @item.Variant.Size</span>
                                                                }
                                                                @if (!string.IsNullOrEmpty(item.Variant.Color))
                                                                {
                                                                    <span class="ms-2">Color: @item.Variant.Color</span>
                                                                }
                                                            </small>
                                                        }
                                                        <div>
                                                            <small class="text-muted">SKU: @item.Product?.SKU</small>
                                                        </div>
                                                        @if (item.Product != null && item.Product.StockQuantity < item.Quantity)
                                                        {
                                                            <div>
                                                                <span class="badge bg-warning text-dark">
                                                                    Only @item.Product.StockQuantity in stock
                                                                </span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </td>

                                            <!-- Price -->
                                            <td class="align-middle">
                                                <strong>₹@itemPrice.ToString("N2")</strong>
                                            </td>

                                            <!-- Quantity -->
                                            <td class="align-middle">
                                                <div class="input-group input-group-sm">
                                                    <button class="btn btn-outline-secondary btn-qty-minus" type="button"
                                                            data-cart-item-id="@item.CartItemId">
                                                        <i class="bi bi-dash"></i>
                                                    </button>
                                                    <input type="number" class="form-control text-center cart-quantity"
                                                           value="@item.Quantity" min="1" max="99"
                                                           data-cart-item-id="@item.CartItemId">
                                                    <button class="btn btn-outline-secondary btn-qty-plus" type="button"
                                                            data-cart-item-id="@item.CartItemId">
                                                        <i class="bi bi-plus"></i>
                                                    </button>
                                                </div>
                                            </td>

                                            <!-- Item Total -->
                                            <td class="align-middle">
                                                <strong class="text-primary">₹@item.ItemTotal.ToString("N2")</strong>
                                            </td>

                                            <!-- Remove -->
                                            <td class="align-middle text-center">
                                                <form asp-action="Remove" method="post" style="display:inline;">
                                                    <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Remove this item from cart?');">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Continue Shopping -->
                <div class="mt-3">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Continue Shopping
                    </a>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <!-- Subtotal -->
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal (@Model.TotalItems items):</span>
                            <strong>₹@Model.Subtotal.ToString("N2")</strong>
                        </div>

                        <!-- Shipping -->
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping:</span>
                            @if (Model.ShippingCost == 0)
                            {
                                <strong class="text-success">FREE</strong>
                            }
                            else
                            {
                                <strong>₹@Model.ShippingCost.ToString("N2")</strong>
                            }
                        </div>

                        <!-- Free Shipping Progress -->
                        @if (!Model.QualifiesForFreeShipping && Model.AmountNeededForFreeShipping > 0)
                        {
                            <div class="alert alert-info p-2 mb-2">
                                <small>
                                    <i class="bi bi-truck"></i>
                                    Add ₹@Model.AmountNeededForFreeShipping.ToString("N2") more to get FREE shipping!
                                </small>
                                <div class="progress mt-2" style="height: 8px;">
                                    <div class="progress-bar bg-success" role="progressbar"
                                         style="width: @((Model.Subtotal / Model.FreeShippingThreshold * 100))%"></div>
                                </div>
                            </div>
                        }
                        else if (Model.QualifiesForFreeShipping)
                        {
                            <div class="alert alert-success p-2 mb-2">
                                <small>
                                    <i class="bi bi-check-circle"></i>
                                    You qualify for FREE shipping!
                                </small>
                            </div>
                        }

                        <!-- Tax -->
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax (@Model.TaxRate%):</span>
                            <strong>₹@Model.TaxAmount.ToString("N2")</strong>
                        </div>

                        <hr>

                        <!-- Total -->
                        <div class="d-flex justify-content-between mb-3">
                            <h5 class="mb-0">Total:</h5>
                            <h4 class="mb-0 text-primary">₹@Model.Total.ToString("N2")</h4>
                        </div>

                        <!-- Checkout Button -->
                        @if (Model.IsValid)
                        {
                            <div class="d-grid gap-2">
                                <a asp-controller="Checkout" asp-action="Index" class="btn btn-success btn-lg">
                                    <i class="bi bi-credit-card"></i> Proceed to Checkout
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger mb-0">
                                <small>Please resolve cart issues before checkout.</small>
                            </div>
                        }

                        <!-- Security Note -->
                        <div class="text-center mt-3">
                            <small class="text-muted">
                                <i class="bi bi-shield-check"></i> Secure checkout
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Empty Cart -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-cart-x text-muted" style="font-size: 5rem;"></i>
                        <h3 class="mt-4">Your cart is empty</h3>
                        <p class="text-muted mb-4">Add some products to get started!</p>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg">
                            <i class="bi bi-shop"></i> Start Shopping
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Quantity Plus Button
            $('.btn-qty-plus').click(function() {
                var cartItemId = $(this).data('cart-item-id');
                var input = $('.cart-quantity[data-cart-item-id="' + cartItemId + '"]');
                var currentQty = parseInt(input.val());
                updateCartQuantity(cartItemId, currentQty + 1);
            });

            // Quantity Minus Button
            $('.btn-qty-minus').click(function() {
                var cartItemId = $(this).data('cart-item-id');
                var input = $('.cart-quantity[data-cart-item-id="' + cartItemId + '"]');
                var currentQty = parseInt(input.val());
                if (currentQty > 1) {
                    updateCartQuantity(cartItemId, currentQty - 1);
                }
            });

            // Manual Quantity Change
            $('.cart-quantity').change(function() {
                var cartItemId = $(this).data('cart-item-id');
                var newQty = parseInt($(this).val());
                if (newQty > 0) {
                    updateCartQuantity(cartItemId, newQty);
                }
            });

            // Update Cart Quantity via AJAX
            function updateCartQuantity(cartItemId, quantity) {
                $.ajax({
                    url: '@Url.Action("UpdateQuantity", "Cart")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        cartItemId: cartItemId,
                        quantity: quantity
                    }),
                    success: function(response) {
                        if (response.success) {
                            // Reload page to update totals
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function() {
                        alert('Failed to update cart. Please try again.');
                    }
                });
            }
        });
    </script>
}

<style>
    .cart-quantity {
        max-width: 60px;
    }

        .cart-quantity::-webkit-inner-spin-button,
        .cart-quantity::-webkit-outer-spin-button {
            opacity: 1;
        }
</style>