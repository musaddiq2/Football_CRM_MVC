@model FootBallOne.Models.Admin
@{
    ViewData["Title"] = "Admin Dashboard";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="text-center mb-4">
        <h1 class="fw-bold text-primary">⚽ Admin Dashboard</h1>
        <p class="text-muted">Welcome, <strong>@Model.Email</strong></p>
        @if (Model.IsSuperAdmin)
        {
            <span class="badge bg-success fs-6">Super Admin</span>
        }
        else
        {
            <span class="badge bg-secondary fs-6">Standard Admin</span>
        }
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4 p-4 text-center">
                <h5 class="fw-bold text-primary mb-3">Academy Info</h5>
                <p><strong>Academy ID:</strong> @Model.AcademyID</p>
                <p><strong>Email:</strong> @Model.Email</p>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4 p-4 text-center">
                <h5 class="fw-bold text-success mb-3">Access Level</h5>
                <p>@(Model.IsSuperAdmin ? "Full Access (Super Admin)" : "Limited Access (Standard Admin)")</p>
            </div>
        </div>
    </div>

    <div class="mt-5 text-center">
        <a href="@Url.Action("Index", "RegistrationManagements")" class="btn btn-primary btn-lg me-2">
            Manage Players
        </a>
        <a href="@Url.Action("Logout", "Admin")" class="btn btn-danger btn-lg">
            Logout
        </a>
    </div>
</div>

<style>
    .card {
        transition: all 0.3s ease-in-out;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0px 6px 20px rgba(0,0,0,0.15);
        }
</style>
