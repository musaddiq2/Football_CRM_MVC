@{
    ViewData["Title"] = "Player Payment";
    var playerId = ViewBag.PlayerId;
    var playerName = ViewBag.PlayerName;
}
@{
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="card shadow-sm p-4">
        <h3>Payment for: @playerName</h3>

        @if (ViewBag.PaymentSuccess != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @ViewBag.PaymentSuccess
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form asp-action="Confirm" method="post">
            <input type="hidden" name="playerId" value="@playerId" />
            <input type="hidden" name="playerName" value="@playerName" />
            <div class="mb-3">
                <label class="form-label">Select Payment Method:</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="paymentMethod" value="Google Pay" checked>
                    <label class="form-check-label">Google Pay</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="paymentMethod" value="PhonePe">
                    <label class="form-check-label">PhonePe</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="paymentMethod" value="Paytm">
                    <label class="form-check-label">Paytm</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="paymentMethod" value="UPI">
                    <label class="form-check-label">Other UPI</label>
                </div>
            </div>
            <button type="submit" class="btn btn-success">Simulate Payment</button>
            <a asp-action="Alerts" asp-controller="Coach" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
