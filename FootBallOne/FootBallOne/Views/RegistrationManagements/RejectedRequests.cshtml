@model List<FootBallOne.Models.PlayerRequest>
@{
    ViewData["Title"] = "Rejected Player Requests";
    Layout = "_Layout";
}

<div class="container mx-auto p-4 sm:p-6 lg:p-8 bg-white shadow-xl rounded-lg max-w-4xl w-full">
    <h2 class="text-3xl font-bold text-gray-800 mb-6 text-center">Rejected Player Requests</h2>

    <div class="overflow-x-auto rounded-lg shadow-md">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gradient-to-r from-red-600 to-red-800 text-white">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider rounded-tl-lg">Name</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Phone</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Email</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider">Reason</th>
                    <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider rounded-tr-lg">Status</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @if (Model != null && Model.Any())
                {
                    foreach (var request in Model)
                    {
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@request.Name</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">@request.PhoneNo</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">@request.Email</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                <span class="text-red-500 font-semibold">@request.Status</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Rejected</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-gray-500">No rejected requests found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
