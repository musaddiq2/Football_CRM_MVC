@model FootBallOne.Models.PlayerRequest
@{
    ViewData["Title"] = "Player Registration Request";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    :root {
        --primary: #22c55e;
        --primary-dark: #16a34a;
        --secondary: #3b82f6;
        --danger: #ef4444;
        --dark: #1e293b;
        --light-bg: #f8fafc;
    }

    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        padding: 20px 0;
    }

    .registration-wrapper {
        max-width: 600px;
        margin: 40px auto;
    }

    .registration-card {
        background: white;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .card-header-section {
        background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
        padding: 50px 40px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .card-header-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            animation: pulse 4s ease-in-out infinite;
        }

    @@keyframes pulse {
        0%, 100%

    {
        transform: scale(1);
        opacity: 0.5;
    }

    50% {
        transform: scale(1.1);
        opacity: 0.8;
    }

    }

    .header-icon {
        width: 90px;
        height: 90px;
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(10px);
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        position: relative;
        z-index: 1;
    }

        .header-icon i {
            font-size: 45px;
            color: white;
        }

    .card-header-section h3 {
        color: white;
        font-size: 32px;
        font-weight: 700;
        margin: 0 0 10px;
        position: relative;
        z-index: 1;
    }

    .card-header-section p {
        color: rgba(255, 255, 255, 0.9);
        font-size: 16px;
        margin: 0;
        position: relative;
        z-index: 1;
    }

    .form-section {
        padding: 45px 40px;
    }

    .form-group-wrapper {
        margin-bottom: 28px;
        position: relative;
    }

    .form-label-custom {
        display: flex;
        align-items: center;
        font-weight: 600;
        color: var(--dark);
        margin-bottom: 10px;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .form-label-custom i {
            margin-right: 8px;
            color: var(--primary);
            font-size: 16px;
        }

    .input-container {
        position: relative;
    }

    .form-control-custom {
        width: 100%;
        padding: 15px 20px;
        border: 2px solid #e2e8f0;
        border-radius: 14px;
        font-size: 16px;
        transition: all 0.3s ease;
        background: var(--light-bg);
        color: var(--dark);
    }

        .form-control-custom::placeholder {
            color: #94a3b8;
        }

        .form-control-custom:focus {
            outline: none;
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 5px rgba(34, 197, 94, 0.1);
            transform: translateY(-1px);
        }

        .form-control-custom:hover {
            border-color: #cbd5e1;
        }

        .form-control-custom.is-invalid {
            border-color: var(--danger);
            background: #fef2f2;
        }

            .form-control-custom.is-invalid:focus {
                box-shadow: 0 0 0 5px rgba(239, 68, 68, 0.1);
            }

        .form-control-custom.is-valid {
            border-color: var(--primary);
            background: #f0fdf4;
        }

    .text-danger {
        display: block;
        color: var(--danger);
        font-size: 13px;
        margin-top: 8px;
        font-weight: 500;
        padding-left: 4px;
    }

    .field-validation-error {
        color: var(--danger) !important;
        font-size: 13px;
        display: block;
        margin-top: 8px;
        font-weight: 500;
    }

    .validation-summary-errors {
        display: none;
    }

    .btn-submit-custom {
        width: 100%;
        padding: 18px;
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        border: none;
        border-radius: 14px;
        color: white;
        font-size: 17px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        margin-top: 15px;
    }

        .btn-submit-custom::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        .btn-submit-custom:hover {
            transform: translateY(-3px);
            box-shadow: 0 20px 40px rgba(34, 197, 94, 0.4);
        }

            .btn-submit-custom:hover::before {
                width: 300px;
                height: 300px;
            }

        .btn-submit-custom:active {
            transform: translateY(-1px);
        }

        .btn-submit-custom i {
            margin-right: 10px;
            font-size: 20px;
            vertical-align: middle;
        }

    .required-indicator {
        color: var(--danger);
        margin-left: 3px;
    }

    @@media (max-width: 768px) {
        .registration-wrapper

    {
        margin: 20px auto;
    }

    .card-header-section {
        padding: 40px 25px;
    }

    .form-section {
        padding: 35px 25px;
    }

    .card-header-section h3 {
        font-size: 26px;
    }

    }
</style>

<div class="registration-wrapper">
    <div class="registration-card">
        <div class="card-header-section">
            <div class="header-icon">
                <i class="bi bi-shield-check"></i>
            </div>
            <h3>Player Registration</h3>
            <p>Join the team and start your football journey</p>
        </div>

        <div class="form-section">
            <form asp-action="RequestRegistration" method="post" id="registrationForm">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="validation-summary-errors"></div>

                <input type="hidden" asp-for="InvitationToken" value="@Model.InvitationToken" />
                <input type="hidden" asp-for="RequestedDate" />
                <input asp-for="Status" type="hidden" value="Pending" />

                <div class="form-group-wrapper">
                    <label asp-for="Name" class="form-label-custom">
                        <i class="bi bi-person-fill"></i>
                        Full Name
                        <span class="required-indicator">*</span>
                    </label>
                    <div class="input-container">
                        <input asp-for="Name" class="form-control-custom" placeholder="Enter your full name" />
                    </div>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group-wrapper">
                    <label asp-for="PhoneNo" class="form-label-custom">
                        <i class="bi bi-telephone-fill"></i>
                        Phone Number
                        <span class="required-indicator">*</span>
                    </label>
                    <div class="input-container">
                        <input asp-for="PhoneNo" class="form-control-custom" placeholder="Enter your phone number" />
                    </div>
                    <span asp-validation-for="PhoneNo" class="text-danger"></span>
                </div>

                <div class="form-group-wrapper">
                    <label asp-for="Email" class="form-label-custom">
                        <i class="bi bi-envelope-fill"></i>
                        Email Address
                        <span class="required-indicator">*</span>
                    </label>
                    <div class="input-container">
                        <input asp-for="Email" class="form-control-custom" type="email" placeholder="you@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group-wrapper">
                    <label asp-for="Password" class="form-label-custom">
                        <i class="bi bi-lock-fill"></i>
                        Password
                        <span class="required-indicator">*</span>
                    </label>
                    <div class="input-container">
                        <input asp-for="Password" class="form-control-custom" type="password" placeholder="Create a strong password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group-wrapper">
                    <label asp-for="Address" class="form-label-custom">
                        <i class="bi bi-geo-fill"></i>
                        Address
                        <span class="required-indicator">*</span>
                    </label>
                    <div class="input-container">
                        <input asp-for="Address" class="form-control-custom" placeholder="Enter your address" />
                    </div>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="form-group-wrapper">
                    <label asp-for="City" class="form-label-custom">
                        <i class="bi bi-pin-map-fill"></i>
                        City
                        <span class="required-indicator">*</span>
                    </label>
                    <div class="input-container">
                        <input asp-for="City" class="form-control-custom" placeholder="Enter your city" />
                    </div>
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>

                <span asp-validation-for="Status" class="text-danger"></span>

                <button type="submit" class="btn-submit-custom">
                    <i class="bi bi-check-circle-fill"></i>
                    Submit Registration
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Add real-time validation feedback
            $('.form-control-custom').on('blur', function() {
                var $input = $(this);
                var $container = $input.closest('.input-container');
                var $icon = $container.find('.validation-icon');
                var $errorSpan = $input.closest('.form-group-wrapper').find('.text-danger, .field-validation-error');

                setTimeout(function() {
                    if ($errorSpan.text().trim() !== '') {
                        $input.removeClass('is-valid').addClass('is-invalid');
                        $icon.removeClass('bi-check-circle-fill valid').addClass('bi-x-circle-fill invalid show');
                    } else if ($input.val().trim() !== '') {
                        $input.removeClass('is-invalid').addClass('is-valid');
                        $icon.removeClass('bi-x-circle-fill invalid').addClass('bi-check-circle-fill valid show');
                    } else {
                        $input.removeClass('is-invalid is-valid');
                        $icon.removeClass('show');
                    }
                }, 100);
            });

            // Clear validation on focus
            $('.form-control-custom').on('focus', function() {
                var $input = $(this);
                var $container = $input.closest('.input-container');
                var $icon = $container.find('.validation-icon');

                if ($input.hasClass('is-invalid')) {
                    $input.removeClass('is-invalid');
                    $icon.removeClass('show');
                }
            });

            // Form submit validation
            $('#registrationForm').on('submit', function(e) {
                var hasErrors = false;
                $('.form-control-custom').each(function() {
                    var $input = $(this);
                    var $errorSpan = $input.closest('.form-group-wrapper').find('.text-danger, .field-validation-error');

                    if ($input.val().trim() === '' || $errorSpan.text().trim() !== '') {
                        hasErrors = true;
                        $input.addClass('is-invalid');
                    }
                });

                if (hasErrors) {
                    $('html, body').animate({
                        scrollTop: $('.is-invalid').first().offset().top - 100
                    }, 500);
                }
            });
        });
    </script>
}