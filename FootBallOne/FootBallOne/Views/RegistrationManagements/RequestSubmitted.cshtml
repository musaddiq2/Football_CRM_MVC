@{
    ViewData["Title"] = "Request Submitted";
    
 

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration Successful!</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background-color: #001f3f; /* Dark blue background */
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            font-family: 'Inter', sans-serif; /* Consistent font */
        }

        .success-card {
            background-color: #fff;
            border-radius: 15px;
            padding: 50px 30px; /* Increased padding for a more spacious feel */
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
            max-width: 600px; /* Max width for the card */
            width: 100%;
            text-align: center; /* Center content within the card */
        }

        .success-icon {
            font-size: 4rem; /* Large icon size */
            color: #28a745; /* Green color for success */
            margin-bottom: 20px;
            display: block; /* Ensure it takes full width and centers */
        }

        .success-card h2 {
            color: #001f3f; /* Dark blue heading */
            font-weight: bold;
            margin-bottom: 15px;
            font-size: 2.2rem; /* Larger heading */
        }

        .success-card p {
            color: #555; /* Slightly darker grey for body text */
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .btn-success-custom {
            background-color: #28a745; /* Green button */
            border-color: #28a745;
            padding: 12px 30px;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: 600;
            transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
        }

            .btn-success-custom:hover {
                background-color: #218838;
                border-color: #1e7e34;
                transform: translateY(-2px); /* Slight lift on hover */
                box-shadow: 0 4px 8px rgba(40, 167, 69, 0.3); /* Green shadow on hover */
            }

        /* Responsive adjustments */
         (max-width: 576px) {
            .success-card

        {
            padding: 30px 20px;
        }

        .success-card h2 {
            font-size: 1.8rem;
        }

        .success-icon {
            font-size: 3rem;
        }

        .success-card p {
            font-size: 1rem;
        }

        .btn-success-custom {
            padding: 10px 20px;
            font-size: 1rem;
        }

        }
    </style>
</head>
<body>
    <div class="success-card">
        <i class="bi bi-check-circle-fill success-icon"></i> <!-- Bootstrap Checkmark Icon -->
        <h2>Your registration request has been submitted successfully!</h2>
        <p>Our team will review your request and get back to you shortly. Thank you for your interest in our Football Academy!</p>
        <a href="/" class="btn btn-success-custom">Go to Home</a>
    </div>

    <!-- Bootstrap 5 JS (optional, not strictly needed for this page) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
