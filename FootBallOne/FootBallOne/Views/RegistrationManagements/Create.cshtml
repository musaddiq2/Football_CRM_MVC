@model FootBallOne.Models.RegistrationManagement
@{
    ViewData["Title"] = "Register Player";
    Layout = "_Layout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(to right,#c9d6ff,#e2e2e2);
        font-family: 'Segoe UI', sans-serif;
    }

    .form-card {
        background: #fff;
        padding: 35px;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .step-indicator {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 8px;
    }

    .step {
        text-align: center;
        flex: 1;
        position: relative;
    }

        .step .circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #e9e9e9;
            color: #333;
            font-weight: 600;
        }

        .step.active .circle {
            background: #000;
            color: #fff;
        }

        .step.completed .circle {
            background: #198754;
            color: #fff;
        }

        .step .label {
            display: block;
            font-size: 0.85rem;
            margin-top: 6px;
            color: #333;
        }

    .step-line {
        position: absolute;
        top: 18px;
        left: 50%;
        right: -50%;
        height: 4px;
        background: #e9e9e9;
        z-index: -1;
    }

    .step:last-child .step-line {
        display: none;
    }

    .step.completed ~ .step .step-line {
        background: #e9e9e9;
    }

    .progress-line {
        position: relative;
        height: 4px;
        background: #e9e9e9;
        border-radius: 2px;
        margin: 12px 0;
    }

    .progress-fill {
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        width: 0%;
        background: #000;
        border-radius: 2px;
        transition: width .35s ease;
    }

    .hidden {
        display: none;
    }

    .btn-custom {
        background: #000;
        color: #fff;
        font-weight: 600;
        border-radius: 50px;
        padding: 10px 30px;
        border: none;
    }

        .btn-custom:hover {
            background: #333;
            color: #fff;
        }

    .form-control, .form-select {
        border-radius: 8px;
    }

    .small-muted {
        font-size: 0.9rem;
        color: #666;
    }

    .summary-row {
        border-bottom: 1px solid #f1f1f1;
        padding: 10px 0;
    }
</style>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="form-card">
                <h3 class="text-center mb-3">Register for Football Academy</h3>

                <!-- Step indicator -->
                <div class="step-indicator" id="stepIndicator">
                    <div class="step active" data-step="1">
                        <div class="circle">1</div>
                        <span class="label">Contact</span>
                        <div class="step-line"></div>
                    </div>
                    <div class="step" data-step="2">
                        <div class="circle">2</div>
                        <span class="label">Details</span>
                        <div class="step-line"></div>
                    </div>
                    <div class="step" data-step="3">
                        <div class="circle">3</div>
                        <span class="label">Confirm Phone</span>
                        <div class="step-line"></div>
                    </div>
                    <div class="step" data-step="4">
                        <div class="circle">4</div>
                        <span class="label">Summary</span>
                    </div>
                </div>

                <div class="progress-line">
                    <div class="progress-fill" id="progressFill" style="width:0%"></div>
                </div>

                @if (TempData["ModelErrors"] != null)
                {
                    <div class="alert alert-danger">@TempData["ModelErrors"]</div>
                }

                <div asp-validation-summary="All" class="text-danger mb-2"></div>

                <!-- Full form posts to Create -->
                <form asp-action="Create" method="post" enctype="multipart/form-data" id="wizardForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <!-- STEP 1 -->
                    <div class="wizard-step" data-step="1">
                        <h5>Step 1 — Email / Phone</h5>
                        <div class="row g-3 mt-2">
                            <div class="col-md-6">
                                <label asp-for="PhoneNo" class="form-label">Phone No <span class="text-danger">*</span></label>
                                <input asp-for="PhoneNo" class="form-control" id="PhoneNo" placeholder="Enter phone number" />
                                <span asp-validation-for="PhoneNo" class="text-danger"></span>
                                <div class="small-muted mt-1">Enter phone to use for confirmation.</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" type="email" class="form-control" id="Email" placeholder="Enter email address" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mt-4 d-flex justify-content-end">
                            <button type="button" class="btn btn-custom" id="next1">Next →</button>
                        </div>
                    </div>

                    <!-- STEP 2 -->
                    <div class="wizard-step hidden" data-step="2">
                        <h5>Step 2 — Player Details</h5>
                        <div class="row g-3 mt-2">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">Full Name <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="Enter player name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label">Subscriber Password <span class="text-danger">*</span></label>
                                <input asp-for="Password" class="form-control" placeholder="Password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label">Category / Age Group</label>
                                <select asp-for="Category" class="form-select" id="CategorySelect">
                                    <option value="">-- Select Category --</option>
                                    <option value="Under-8">Under-8</option>
                                    <option value="Under-10">Under-10</option>
                                    <option value="Under-12">Under-12</option>
                                    <option value="Under-14">Under-14</option>
                                    <option value="Under-16">Under-16</option>
                                    <option value="Under-18">Under-18</option>
                                    <option value="Under-21">Under-21</option>
                                    <option value="Senior">Senior</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="BirthDate" class="form-label">Birth Date</label>
                                <input asp-for="BirthDate" type="date" class="form-control" />
                                <span asp-validation-for="BirthDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SubscriptionStart" class="form-label">Subscription Start</label>
                                <input asp-for="SubscriptionStart" type="date" class="form-control" />
                                <span asp-validation-for="SubscriptionStart" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SubscriptionEnd" class="form-label">Subscription End</label>
                                <input asp-for="SubscriptionEnd" type="date" class="form-control" />
                                <span asp-validation-for="SubscriptionEnd" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="WorkingHours" class="form-label">Working Hours</label>
                                <select asp-for="WorkingHours" class="form-select">
                                    <option value="">-- Select Working Time --</option>
                                    <option value="1 To 3">1 To 3</option>
                                    <option value="3 To 6">3 To 6</option>
                                    <option value="6 To 9">6 To 9</option>
                                    <option value="9 To 12">9 To 12</option>
                                </select>
                                <span asp-validation-for="WorkingHours" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CoachName" class="form-label">Coach Name</label>
                                <input asp-for="CoachName" class="form-control" type="text" placeholder="Enter Coach Name" />
                                <span asp-validation-for="CoachName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Ground" class="form-label">Ground</label>
                                <select asp-for="Ground" class="form-select">
                                    <option value="">-- Select Ground --</option>
                                    <option value="Turf 1">Turf 1</option>
                                    <option value="Turf 2">Turf 2</option>
                                    <option value="Turf 3">Turf 3</option>
                                </select>
                                <span asp-validation-for="Ground" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TimeSlot" class="form-label">Time Slot</label>
                                <select asp-for="TimeSlot" class="form-select">
                                    <option value="">-- Select Time Slot --</option>
                                    <option value="Morning">Morning (6 AM - 12 PM)</option>
                                    <option value="Afternoon">Afternoon (12 PM - 5 PM)</option>
                                    <option value="Evening">Evening (5 PM - 9 PM)</option>
                                    <option value="Night">Night (9 PM - 12 AM)</option>
                                </select>
                                <span asp-validation-for="TimeSlot" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label">Address</label>
                                <input asp-for="Address" class="form-control" placeholder="Enter address" />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="City" class="form-label">City</label>
                                <input asp-for="City" class="form-control" placeholder="Enter city" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PaymentStatus" class="form-label">Payment Status</label>
                                <select asp-for="PaymentStatus" class="form-select" id="PaymentStatusSelect">
                                    <option value="">-- Select Payment Status --</option>
                                    <option value="Paid">Paid</option>
                                    <option value="Not Paid">Not Paid</option>
                                </select>
                                <span asp-validation-for="PaymentStatus" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <hr />
                                <h6 class="mb-3">Fee Details</h6>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="SubscriptionFees" class="form-label">Subscription Fees</label>
                                <input asp-for="SubscriptionFees" type="number" step="0.01" min="0" class="form-control fee-input" id="SubscriptionFees" placeholder="0.00" />
                                <span asp-validation-for="SubscriptionFees" class="text-danger"></span>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="KitFees" class="form-label">Kit Fees</label>
                                <input asp-for="KitFees" type="number" step="0.01" min="0" class="form-control fee-input" id="KitFees" placeholder="0.00" />
                                <span asp-validation-for="KitFees" class="text-danger"></span>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="SugarFees" class="form-label">Sugar Fees</label>
                                <input asp-for="SugarFees" type="number" step="0.01" min="0" class="form-control fee-input" id="SugarFees" placeholder="0.00" />
                                <span asp-validation-for="SugarFees" class="text-danger"></span>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="BagFees" class="form-label">Bag Fees</label>
                                <input asp-for="BagFees" type="number" step="0.01" min="0" class="form-control fee-input" id="BagFees" placeholder="0.00" />
                                <span asp-validation-for="BagFees" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Total Fees</label>
                                <input asp-for="TotalFees" class="form-control fw-bold" id="TotalFees" readonly style="background-color: #f8f9fa;" />
                                <span class="small-muted">Calculated automatically from fees.</span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Profile Image</label>
                                <input type="file" name="imageFile" class="form-control" accept="image/*" />
                                <span class="small-muted">Upload player photo (optional)</span>
                            </div>
                        </div>

                        <div class="mt-4 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" id="prev2">← Back</button>
                            <button type="button" class="btn btn-custom" id="next2">Next →</button>
                        </div>
                    </div>

                    <!-- STEP 3 -->
                    <div class="wizard-step hidden" data-step="3">
                        <h5>Step 3 — Confirm Phone</h5>
                        <div class="mt-3">
                            <p>We need to confirm the phone number you entered:</p>
                            <div class="mb-3">
                                <label class="form-label">Phone to confirm</label>
                                <input type="text" class="form-control" id="confirmPhoneDisplay" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Re-enter phone to confirm <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="confirmPhoneInput" placeholder="Type the phone again to confirm" />
                                <div class="text-danger small mt-1" id="phoneConfirmError" style="display:none;"></div>
                            </div>

                            <div class="mb-2">
                                <small class="small-muted"><i class="bi bi-info-circle"></i> This helps ensure the contact information is correct.</small>
                            </div>
                        </div>

                        <div class="mt-4 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" id="prev3">← Back</button>
                            <button type="button" class="btn btn-custom" id="next3">Confirm →</button>
                        </div>
                    </div>

                    <!-- STEP 4: SUMMARY -->
                    <div class="wizard-step hidden" data-step="4">
                        <h5>Step 4 — Summary</h5>
                        <p class="text-muted">Please review the information before submitting:</p>
                        <div class="mt-3" id="summaryBox">
                            <!-- summary rows filled by JS -->
                        </div>

                        <div class="mt-4 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" id="prev4">← Back</button>
                            <button type="submit" class="btn btn-custom" id="finalSubmit">
                                <i class="bi bi-check-circle"></i> Submit & Save
                            </button>
                        </div>
                    </div>

                </form>

                <div class="text-center mt-3">
                    <a asp-action="Index" class="small-muted"><i class="bi bi-arrow-left"></i> Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/additional-methods.min.js"></script>
<partial name="_ValidationScriptsPartial" />

<script>
    $(function(){
      // show/hide steps helpers
      function goToStep(step) {
        $('.wizard-step').addClass('hidden');
        $('.wizard-step[data-step="'+step+'"]').removeClass('hidden');

        // indicator
        $('.step').each(function(){
          var s = $(this).data('step');
          $(this).removeClass('active completed');
          if(s < step) $(this).addClass('completed');
          if(s == step) $(this).addClass('active');
        });

        // progress fill percent (0,33,66,100)
        var pct = {1:0,2:33,3:66,4:100}[step] || 0;
        $('#progressFill').css('width', pct + '%');
      }

      // init
      goToStep(1);

      // fees calculator
      function calcFees(){
        var s = parseFloat($('#SubscriptionFees').val() || 0);
        var k = parseFloat($('#KitFees').val() || 0);
        var su = parseFloat($('#SugarFees').val() || 0);
        var b = parseFloat($('#BagFees').val() || 0);
        var total = (s + k + su + b) || 0;
        $('#TotalFees').val(total.toFixed(2));
      }
      $('.fee-input').on('input change', calcFees);
      calcFees();

      // Step navigation handlers
      $('#next1').on('click', function(){
        // require Phone/email
        var phone = $('#PhoneNo').val().trim();
        var email = $('#Email').val().trim();
        if(!phone && !email){
          // show error
          if(!phone) {
            $('#PhoneNo').next('.text-danger').text('Phone is required (or provide email).');
          }
          if(!email) {
            $('#Email').next('.text-danger').text('Email is required (or provide phone).');
          }
          return;
        } else {
          // clear errors
          $('#PhoneNo').next('.text-danger').text('');
          $('#Email').next('.text-danger').text('');
        }

        // populate confirm phone display
        $('#confirmPhoneDisplay').val(phone);

        goToStep(2);
      });

      $('#prev2').on('click', function(){ goToStep(1); });

      $('#next2').on('click', function(){
        // validate required field: Name
        var name = $('[name="Name"]').val().trim();
        if(!name) {
          $('[name="Name"]').next('.text-danger').text('Name is required');
          return;
        } else {
          $('[name="Name"]').next('.text-danger').text('');
        }

        calcFees();
        goToStep(3);
      });

      $('#prev3').on('click', function(){ goToStep(2); });

      // Confirm phone step
      $('#next3').on('click', function(){
        var entered = $('#confirmPhoneInput').val().trim();
        var original = $('#confirmPhoneDisplay').val().trim();
        if(entered === "" ) {
          $('#phoneConfirmError').text('Please re-enter the phone to confirm.').show();
          return;
        }
        if(entered !== original) {
          $('#phoneConfirmError').text('Phone does not match. Please check again.').show();
          return;
        }
        $('#phoneConfirmError').hide();

        // Build summary
        var summaryHtml = '';
        function row(label, value){
          return '<div class="summary-row"><strong>'+label+'</strong><div class="small-muted">'+(value||'—')+'</div></div>';
        }

        summaryHtml += row('Name', $('[name="Name"]').val());
        summaryHtml += row('Phone', $('[name="PhoneNo"]').val());
        summaryHtml += row('Email', $('[name="Email"]').val());
        summaryHtml += row('Category', $('#CategorySelect option:selected').text());
        summaryHtml += row('Birth Date', $('[name="BirthDate"]').val());
        summaryHtml += row('Subscription Start', $('[name="SubscriptionStart"]').val());
        summaryHtml += row('Subscription End', $('[name="SubscriptionEnd"]').val());
        summaryHtml += row('Subscription Fees', '₹ ' + ($('#SubscriptionFees').val() || '0.00'));
        summaryHtml += row('Kit Fees', '₹ ' + ($('#KitFees').val() || '0.00'));
        summaryHtml += row('Sugar Fees', '₹ ' + ($('#SugarFees').val() || '0.00'));
        summaryHtml += row('Bag Fees', '₹ ' + ($('#BagFees').val() || '0.00'));
        summaryHtml += row('Total Fees', '₹ ' + $('#TotalFees').val());
        summaryHtml += row('Working Hours', $('[name="WorkingHours"] option:selected').text());
        summaryHtml += row('Coach', $('[name="CoachName"]').val());
        summaryHtml += row('Ground', $('[name="Ground"] option:selected').text());
        summaryHtml += row('Time Slot', $('[name="TimeSlot"] option:selected').text());
        summaryHtml += row('Address', $('[name="Address"]').val());
        summaryHtml += row('City', $('[name="City"]').val());
        summaryHtml += row('Payment Status', $('#PaymentStatusSelect option:selected').text());
        summaryHtml += row('User Password',$('[name="Password"]').val());

        $('#summaryBox').html(summaryHtml);

        goToStep(4);
      });

      $('#prev4').on('click', function(){ goToStep(3); });

      // Final submit
      $('#wizardForm').on('submit', function(e){
        calcFees();
        return true; // allow form submission
      });

    });
</script>