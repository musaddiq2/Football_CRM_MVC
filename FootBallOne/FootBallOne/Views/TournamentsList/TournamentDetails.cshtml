@model FootBallOne.Models.Tournament

<div class="tournament-container">
    <!-- Hero Header -->
    <div class="tournament-hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div class="tournament-icon">
                <i class="bi bi-trophy-fill"></i>
            </div>
            <h1 class="tournament-title">@Model.TournamentName</h1>
            <div class="tournament-status-badge">
                @if (Model.IsActive)
                {
                    <span class="status-active"><i class="bi bi-check-circle-fill"></i> Active Tournament</span>
                }
                else
                {
                    <span class="status-inactive"><i class="bi bi-pause-circle-fill"></i> Inactive</span>
                }
            </div>
        </div>
    </div>

    <div class="container main-content">
        <!-- Description Card -->
        <div class="description-card">
            <div class="section-header">
                <i class="bi bi-journal-text"></i>
                <h3>About This Tournament</h3>
            </div>
            <p class="description-text">@Model.TournamentDescription</p>
        </div>

        <!-- Info Cards Grid -->
        <div class="info-grid">
            <!-- Dates Card -->
            <div class="info-card dates-card">
                <div class="card-icon">
                    <i class="bi bi-calendar-range"></i>
                </div>
                <h4>Tournament Schedule</h4>
                <div class="date-info">
                    <div class="date-item">
                        <span class="date-label">Starts</span>
                        <span class="date-value">@Model.StartDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="date-divider">
                        <i class="bi bi-arrow-right"></i>
                    </div>
                    <div class="date-item">
                        <span class="date-label">Ends</span>
                        <span class="date-value">@Model.EndDate.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- Details Card -->
            <div class="info-card details-card">
                <div class="card-icon">
                    <i class="bi bi-info-circle"></i>
                </div>
                <h4>Tournament Details</h4>
                <div class="detail-list">
                    <div class="detail-item">
                        <span class="detail-label">Status</span>
                        <span class="detail-badge status-badge">@Model.Status</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Branch</span>
                        <span class="detail-value">@Model.Branch</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Registration</span>
                        @if (Model.OpenToEveryone)
                        {
                            <span class="detail-badge open-badge"><i class="bi bi-globe"></i> Open to All</span>
                        }
                        else
                        {
                            <span class="detail-badge invite-badge"><i class="bi bi-lock"></i> Invite Only</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Invited Facilities Section -->
        <div class="facilities-section">
            <div class="section-header">
                <i class="bi bi-building"></i>
                <h3>Invited Facilities</h3>
                @if (Model.InvitedFacilities != null && Model.InvitedFacilities.Any())
                {
                    <span class="facility-count">@Model.InvitedFacilities.Count() Facilities</span>
                }
            </div>

            @if (Model.InvitedFacilities != null && Model.InvitedFacilities.Any())
            {
                <div class="facilities-grid">
                    @foreach (var facility in Model.InvitedFacilities)
                    {
                        <div class="facility-card">
                            <div class="facility-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <div class="facility-content">
                                <div class="facility-field">
                                    <span class="facility-label"><i class="bi bi-building"></i> Facility Name</span>
                                    <h5 class="facility-name">@facility.Invitedfacility</h5>
                                </div>
                                <div class="facility-field">
                                    <span class="facility-label"><i class="bi bi-envelope"></i> Invitation Message</span>
                                    <div class="facility-message">
                                        <span>@facility.InvitationMessage</span>
                                    </div>
                                </div>
                            </div>
                            <div class="facility-status">
                                <i class="bi bi-envelope-check"></i>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <p>No facilities have been invited yet</p>
                </div>
            }
        </div>

       

        <!-- Action Buttons -->
        <div class="action-buttons">
            <a asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-left"></i>
                <span>Back to Lists</span>
            </a>
            <a asp-action="TournamentEdit" asp-route-id="@Model.TournamentID" class="btn-edit">
                <i class="bi bi-pencil-square"></i>
                <span>Edit Tournament</span>
            </a>
        </div>
        <!-- Footer Info -->
        <div class="footer-info">
            <i class="bi bi-clock-history"></i>
            <span>Created on @Model.CreateDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")</span>
        </div>
    </div>
</div>

<style>
