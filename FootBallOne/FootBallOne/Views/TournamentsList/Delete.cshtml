@model FootBallOne.ViewModel.MatchViewModel

@{
    ViewData["Title"] = "Confirm Delete";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Use your shared layout
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white text-center">
                    <h4>
                        <i class="fas fa-exclamation-triangle me-2"></i> Confirm Deletion
                    </h4>
                </div>
                <div class="card-body">
                    <p class="mb-3 text-center">
                        Are you sure you want to delete Match:<br />
                        <strong>@Model.HomeTeam vs @Model.AwayTeam</strong>?

                    </p>
                    <p class="text-muted text-center mb-4">
                        This action is permanent and cannot be undone.
                    </p>

                    <!-- Training Details -->
                    <div class="mb-3">
                        <h5>Details</h5>
                        <ul class="list-group">
                            <li class="list-group-item"><strong>Type:</strong> @Model.Tournament</li>
                            <li class="list-group-item"><strong>Start Date:</strong> @Model.MatchDate.ToString("dd-MMM-yyyy")</li>
                            <li class="list-group-item"><strong>End Date:</strong> @Model.MatchDate.ToString("dd-MMM-yyyy")</li>
                        </ul>
                    </div>

                    <!-- Match Details Section -->
                    <div class="mb-4">
                        <h6 class="mb-3" style="color: #333333; font-size: 15px; font-weight: 600;">Match Details</h6>
                        <div class="border rounded overflow-hidden" style="border-color: #dee2e6 !important;">
                            <table class="table mb-0" style="background-color: #ffffff;">
                                <thead>
                                    <tr style="background-color: #f8f9fa; border-bottom: 1px solid #dee2e6;">
                                        <th class="text-center py-3" style="color: #333333; font-weight: 600; font-size: 14px; border: none;">Home Team</th>
                                        <th class="text-center py-3" style="color: #333333; font-weight: 600; font-size: 14px; border: none;">Away Team</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="background-color: #ffffff;">
                                        <td class="text-center py-3" style="color: #333333; font-size: 14px; border: none;"> <b> @Model.HomeTeam </b></td>
                                        <td class="text-center py-3" style="color: #333333; font-size: 14px; border: none;"> <b> @Model.AwayTeam </b></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                   
                    <!-- Action Buttons -->
                    <div class="text-center mt-4">
                        <form asp-action="DeleteConfirmed2" asp-route-id="@Model.MatchId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tab" value="@ViewBag.ReturnTab" />
                            <button type="submit" class="btn px-4 py-2 me-2" style="background-color: #d9534f; color: white; border: none; border-radius: 0.375rem; font-size: 15px; font-weight: 400;">
                                <i class="bi bi-trash me-2"></i>Delete
                            </button>
                        </form>
                        <a asp-action="Index" asp-route-tab="@ViewBag.ReturnTab" class="btn px-4 py-2" style="background-color: #6c757d; color: white; border: none; border-radius: 0.375rem; font-size: 15px; font-weight: 400; text-decoration: none;">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FontAwesome (optional if already in _Layout) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />