@model FootBallOne.ViewModel.EventViewModel
@{
    ViewData["Title"] = "Event Details";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Adjust if using a different layout
}

<div class="container mt-4">
    <h2 class="mb-4">@Model.Title</h2>

    <div class="card">
        <div class="card-body">
            <dl class="row">

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Start Date</dt>
                <dd class="col-sm-9">@Model.StartDate.ToString("dddd, dd MMMM yyyy")</dd>

                <dt class="col-sm-3">End Date</dt>
                <dd class="col-sm-9">@Model.EndDate.ToString("dddd, dd MMMM yyyy")</dd>

                <dt class="col-sm-3">Branch</dt>
                <dd class="col-sm-9">@Model.Branch</dd>

                <dt class="col-sm-3">Address</dt>
                <dd class="col-sm-9">@Model.Adress, @Model.City</dd>

                <dt class="col-sm-3">Ticket Price</dt>
                <dd class="col-sm-9">@Model.TicketPrice.ToString("C")</dd>

                <dt class="col-sm-3">Available Capacity</dt>
                <dd class="col-sm-9">@Model.AvailableCapacity</dd>

                <dt class="col-sm-3">Facilities Invited</dt>
                <dd class="col-sm-9">@Model.InvitedFacility</dd>

                <dt class="col-sm-3">Invitation Message</dt>
                <dd class="col-sm-9">@Model.InvitationMessage</dd>

                <dt class="col-sm-3">Coordinates</dt>
                <dd class="col-sm-9">
                    Latitude: @Model.Latitude<br />
                    Longitude: @Model.Longitude
                </dd>

                <dt class="col-sm-3">Created Date</dt>
                <dd class="col-sm-9">@Model.CreatedDate.ToString("f")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Index" asp-controller="Events" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>
