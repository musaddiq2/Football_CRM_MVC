@model FootBallOne.Models.CampViewModel
@{
    ViewData["Title"] = "Create Camp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Camp</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f8fafc;
            color: #334155;
        }

        .header {
            background: white;
            padding: 20px 40px;
            border-bottom: 1px solid #e2e8f0;
        }

        .breadcrumb {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 8px;
        }

            .breadcrumb a {
                color: #64748b;
                text-decoration: none;
            }

                .breadcrumb a:hover {
                    color: #0891b2;
                }

        .page-title {
            font-size: 24px;
            font-weight: 700;
            color: #1e293b;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            min-height: calc(100vh - 120px);
        }

        .progress-container {
            padding: 40px 80px 30px;
            background: white;
        }

        .progress-steps {
            display: flex;
            justify-content: space-between;
            position: relative;
            max-width: 800px;
            margin: 0 auto;
        }

            .progress-steps::before {
                content: '';
                position: absolute;
                top: 20px;
                left: 20px;
                right: 20px;
                height: 2px;
                background: #e2e8f0;
                z-index: 1;
            }

        .progress-line {
            position: absolute;
            top: 20px;
            left: 20px;
            height: 2px;
            background: #0891b2;
            z-index: 2;
            transition: width 0.3s ease;
        }

        .step {
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            z-index: 3;
            flex: 1;
            cursor: pointer;
        }

        .step-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
            border: 2px solid #e2e8f0;
            background: white;
            transition: all 0.3s ease;
            color: #64748b;
        }

        .step.active .step-circle {
            background: #0891b2;
            color: white;
            border-color: #0891b2;
        }

        .step.completed .step-circle {
            background: #0891b2;
            color: white;
            border-color: #0891b2;
        }

        .step-label {
            margin-top: 12px;
            font-size: 14px;
            font-weight: 500;
            color: #64748b;
            text-align: center;
        }

        .step.active .step-label {
            color: #0891b2;
            font-weight: 600;
        }

        .step.completed .step-label {
            color: #0891b2;
        }

        .form-content {
            padding: 40px 80px 60px;
            max-width: 800px;
            margin: 0 auto;
        }

        .step-content {
            display: none;
        }

            .step-content.active {
                display: block;
            }

        .form-group {
            margin-bottom: 32px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #374151;
            font-size: 14px;
        }

        .required {
            color: #ef4444;
        }

        input[type="text"],
        input[type="number"],
        input[type="date"],
        textarea,
        select {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 14px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            background: white;
            font-family: inherit;
        }

            input:focus,
            textarea:focus,
            select:focus {
                outline: none;
                border-color: #0891b2;
                box-shadow: 0 0 0 3px rgb(8 145 178 / 0.1);
            }

            input.error,
            textarea.error,
            select.error {
                border-color: #ef4444 !important;
                box-shadow: 0 0 0 3px rgb(239 68 68 / 0.1) !important;
            }

        textarea {
            resize: vertical;
            min-height: 120px;
        }

        select {
            appearance: none;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
            background-position: right 12px center;
            background-repeat: no-repeat;
            background-size: 16px;
            padding-right: 40px;
        }

        .activities-section h3,
        .facilities-section h3 {
            margin-bottom: 24px;
            color: #374151;
            font-size: 16px;
            font-weight: 500;
        }

        .activity-item,
        .facility-item {
            display: grid;
            grid-template-columns: 1fr 2fr auto;
            gap: 20px;
            align-items: start;
            margin-bottom: 20px;
            padding: 20px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: #f8fafc;
        }

        .delete-btn {
            background: transparent;
            color: #ef4444;
            border: none;
            width: 32px;
            height: 32px;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            transition: background-color 0.2s ease;
            margin-top: 32px;
        }

            .delete-btn:hover {
                background: #fef2f2;
            }

        .copy-icon {
            color: #6b7280;
            font-size: 16px;
            cursor: pointer;
            margin-top: 32px;
            margin-right: 8px;
        }

            .copy-icon:hover {
                color: #374151;
            }

        .add-btn {
            background: #f8fafc;
            color: #64748b;
            border: 1px solid #e2e8f0;
            padding: 12px 24px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 500;
            font-size: 14px;
            transition: all 0.2s ease;
            margin-top: 16px;
            display: inline-block;
        }

            .add-btn:hover {
                background: #f1f5f9;
                color: #475569;
            }

        .map-container {
            width: 100%;
            height: 300px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            margin-bottom: 20px;
            position: relative;
            overflow: hidden;
        }

        .form-navigation {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 30px 80px 40px;
            background: white;
            border-top: 1px solid #e2e8f0;
        }

        .nav-btn {
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 14px;
        }

        .btn-back {
            background: white;
            color: #64748b;
            border: 1px solid #e2e8f0;
        }

            .btn-back:hover:not(:disabled) {
                background: #f8fafc;
                color: #475569;
            }

        .btn-next {
            background: #0891b2;
            color: white;
            min-width: 80px;
        }

            .btn-next:hover:not(:disabled) {
                background: #0e7490;
            }

        .nav-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .action-buttons {
            display: flex;
            gap: 16px;
        }

        .btn-cancel {
            background: white;
            color: #64748b;
            border: 1px solid #e2e8f0;
        }

            .btn-cancel:hover {
                background: #f8fafc;
            }

        .btn-create-another {
            background: white;
            color: #0891b2;
            border: 1px solid #0891b2;
        }

            .btn-create-another:hover {
                background: #f0f9ff;
            }

        .btn-create {
            background: #0891b2;
            color: white;
        }

            .btn-create:hover {
                background: #0e7490;
            }

        .success-message {
            background-color: #d4edda;
            border: 1px solid #c3e6cb;
            color: #155724;
            padding: 15px;
            border-radius: 4px;
            margin-bottom: 20px;
            display: none;
        }

        .error-message {
            color: #ef4444;
            font-size: 12px;
            margin-top: 4px;
            display: none;
        }

        .step-error {
            margin-bottom: 15px;
            font-weight: 400;
            padding: 10px;
            background: rgba(239, 68, 68, 0.1);
            border-radius: 4px;
            color: #ef4444;
            font-size: 14px;
            display: none;
        }

        .facility-item select.error + .error-message {
            display: block;
        }

        .clearfix::after {
            content: "";
            display: table;
            clear: both;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="breadcrumb">
            <a href="@Url.Action("Index", "Calendar")">Camps</a> > <span>Create</span>
        </div>
        <h1 class="page-title">Create Camp</h1>
    </div>

    <div class="container">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <h4>Please fix the following errors:</h4>
                @Html.ValidationSummary(false)
            </div>
        }

        <!-- Success Message -->
        <div id="successMessage" class="success-message">
            Camp created successfully!
        </div>

        <!-- Progress Bar -->
        <div class="progress-container">
            <div class="progress-steps">
                <div class="progress-line" id="progressLine"></div>
                <div class="step active" data-step="1" id="stepIndicator1">
                    <div class="step-circle">01</div>
                    <div class="step-label">Basic Information</div>
                </div>
                <div class="step" data-step="2" id="stepIndicator2">
                    <div class="step-circle">02</div>
                    <div class="step-label">Details</div>
                </div>
                <div class="step" data-step="3" id="stepIndicator3">
                    <div class="step-circle">03</div>
                    <div class="step-label">Location</div>
                </div>
                <div class="step" data-step="4" id="stepIndicator4">
                    <div class="step-circle">04</div>
                    <div class="step-label">Invited Facilities</div>
                </div>
            </div>
        </div>

        <!-- Form Start -->
        @using (Html.BeginForm("CreateCamp", "Calendar", FormMethod.Post, new { id = "campForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-content">
                <!-- STEP 1: Basic Info -->
                <div class="step-content active" id="step1">
                    <div class="step-error" id="step1Error"></div>
                    <div class="form-group">
                        <label for="CampName">Camp Name <span class="required">*</span></label>
                        @Html.TextBoxFor(m => m.CampName, new { @class = "form-control", id = "campName" })
                        <div class="error-message" id="campNameError">Camp name is required</div>
                    </div>
                    <div class="form-group">
                        <label for="CampDescription">Camp Description</label>
                        @Html.TextAreaFor(m => m.CampDescription, new { @class = "form-control", id = "description", placeholder = "Enter camp description..." })
                    </div>
                    <div class="form-group form-row">
                        <div>
                            <label for="StartDate">Start Date <span class="required">*</span></label>
                            @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "startDate" })
                            <div class="error-message" id="startDateError">Start date is required</div>
                        </div>
                        <div>
                            <label for="EndDate">End Date <span class="required">*</span></label>
                            @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", id = "endDate" })
                            <div class="error-message" id="endDateError">End date is required and must be after start date</div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="Branch">Branch <span class="required">*</span></label>
                        @Html.DropDownListFor(m => m.Branch, new SelectList(new[] {
                    new { Value = "", Text = "Select Branch" },
                    new { Value = "الفرع الرئيسي", Text = "الفرع الرئيسي" }
                    }, "Value", "Text"), null, new { @class = "form-control", id = "branch" })
                        <div class="error-message" id="branchError">Please select a branch</div>
                    </div>
                </div>

                <!-- STEP 2: Details -->
                <div class="step-content" id="step2">
                    <div class="step-error" id="step2Error"></div>
                    <div class="form-group form-row">
                        <div>
                            <label for="Capacity">Capacity</label>
                            @Html.TextBoxFor(m => m.Capacity, new { @class = "form-control", type = "number", min = "1", id = "capacity" })
                        </div>
                        <div>
                            <label for="TicketPrice">Ticket Price (VAT incl.) <span class="required">*</span></label>
                            @Html.TextBoxFor(m => m.TicketPrice, new { @class = "form-control", type = "number", step = "0.01", min = "0", id = "ticketPrice" })
                            <div class="error-message" id="ticketPriceError">Ticket price must be 0 or greater</div>
                        </div>
                    </div>
                    <div class="activities-section">
                        <h3>Activities</h3>
                        <div id="activitiesContainer">
                            <div class="activity-item">
                                <div>
                                    <label>Activity</label>
                                    <input type="text" name="Activities[0].ActivityName" class="form-control" placeholder="Enter activity name" />
                                </div>
                                <div>
                                    <label>Activity Description</label>
                                    <textarea name="Activities[0].ActivityDescription" class="form-control" placeholder="Enter activity description"></textarea>
                                </div>
                                <div style="display: flex; align-items: center;">
                                    <span class="copy-icon" onclick="duplicateActivity(this)" title="Duplicate">📋</span>
                                    <button type="button" class="delete-btn" onclick="removeActivity(this)" title="Delete">🗑</button>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="add-btn" onclick="addActivity()">Add to activities</button>
                    </div>
                </div>

                <!-- STEP 3: Location -->
                <div class="step-content" id="step3">
                    <div class="step-error" id="step3Error"></div>
                    <h3>Location Details</h3>
                    <div class="form-group form-row">
                        <div>
                            <label for="Address">Address <span class="required">*</span></label>
                            @Html.TextBoxFor(m => m.Address, new { @class = "form-control", id = "address", list = "addressSuggestions", placeholder = "Start typing an address or city..." })
                            <datalist id="addressSuggestions"></datalist>
                            <div class="error-message" id="addressError">Address is required</div>
                        </div>
                        <div>
                            <label for="City">City <span class="required">*</span></label>
                            @Html.TextBoxFor(m => m.City, new { @class = "form-control", id = "city" })
                            <div class="error-message" id="cityError">City is required</div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Location</label>
                        <div class="map-container" id="map"></div>
                    </div>
                    <div class="form-group form-row">
                        <div>
                            <label for="Latitude">Latitude</label>
                            @Html.TextBoxFor(m => m.Latitude, new { @class = "form-control", type = "number", step = "any", id = "latitude" })
                        </div>
                        <div>
                            <label for="Longitude">Longitude</label>
                            @Html.TextBoxFor(m => m.Longitude, new { @class = "form-control", type = "number", step = "any", id = "longitude" })
                        </div>
                    </div>
                </div>

                <!-- STEP 4: Invited Facilities -->
                <div class="step-content" id="step4">
                    <div class="step-error" id="step4Error"></div>
                    <div class="facilities-section">
                        <h3>Invited Facilities</h3>
                        <div id="facilitiesContainer">
                            <div class="facility-item">
                                <div>
                                    <label>Invited Facility <span class="required">*</span></label>
                                    <select name="InvitedFacilities[0].FacilityName" class="form-control" required>
                                        <option value="">Select an option</option>
                                        <option value="facility1">Sports Complex A</option>
                                        <option value="facility2">Training Center B</option>
                                        <option value="facility3">Academy C</option>
                                        <option value="facility4">Fitness Center D</option>
                                        <option value="facility5">Recreation Center E</option>
                                    </select>
                                    <div class="error-message" id="facilityError0">Please select a facility</div>
                                </div>
                                <div>
                                    <label>Invitation Message</label>
                                    <textarea name="InvitedFacilities[0].InvitationMessage" class="form-control" placeholder="Enter invitation message..."></textarea>
                                </div>
                                <div style="display: flex; align-items: center;">
                                    <span class="copy-icon" onclick="duplicateFacility(this)" title="Duplicate">📋</span>
                                    <button type="button" class="delete-btn" onclick="removeFacility(this)" title="Delete">🗑</button>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="add-btn" onclick="addFacility()">Add to invited Facilities</button>
                    </div>
                </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="form-navigation">
                <button type="button" class="nav-btn btn-back" id="backBtn" onclick="previousStep()">Back</button>
                <div class="action-buttons" id="nextActions">
                    <button type="button" class="nav-btn btn-next" id="nextBtn" onclick="nextStep()">Next</button>
                </div>
                <div class="action-buttons" id="finalActions" style="display: none;">
                    <button type="button" class="nav-btn btn-cancel" onclick="cancelForm()">Cancel</button>
                    <button type="button" class="nav-btn btn-create-another" onclick="createAndAnother()">Create & Create Another</button>
                    <button type="submit" class="nav-btn btn-create" id="submitBtn">Create</button>
                </div>
            </div>
        }
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let currentStep = 1;
            let activityCount = 1;
            let facilityCount = 1;
            let map = null;
            let marker = null;
            let addressSuggestionsData = [];

            // Validation functions
            function validateStep1() {
                let isValid = true;
                const stepError = document.getElementById('step1Error');
                stepError.style.display = 'none';
                stepError.textContent = '';

                const campName = document.getElementById('campName');
                const campNameError = document.getElementById('campNameError');
                if (!campName.value.trim()) {
                    campName.classList.add('error');
                    campNameError.style.display = 'block';
                    isValid = false;
                } else {
                    campName.classList.remove('error');
                    campNameError.style.display = 'none';
                }

                const startDate = document.getElementById('startDate');
                const startDateError = document.getElementById('startDateError');
                if (!startDate.value) {
                    startDate.classList.add('error');
                    startDateError.style.display = 'block';
                    isValid = false;
                } else {
                    startDate.classList.remove('error');
                    startDateError.style.display = 'none';
                }

                const endDate = document.getElementById('endDate');
                const endDateError = document.getElementById('endDateError');
                if (!endDate.value) {
                    endDate.classList.add('error');
                    endDateError.textContent = 'End date is required';
                    endDateError.style.display = 'block';
                    isValid = false;
                } else if (startDate.value && new Date(endDate.value) <= new Date(startDate.value)) {
                    endDate.classList.add('error');
                    endDateError.textContent = 'End date must be after start date';
                    endDateError.style.display = 'block';
                    isValid = false;
                } else {
                    endDate.classList.remove('error');
                    endDateError.style.display = 'none';
                }

                const branch = document.getElementById('branch');
                const branchError = document.getElementById('branchError');
                if (!branch.value) {
                    branch.classList.add('error');
                    branchError.style.display = 'block';
                    isValid = false;
                } else {
                    branch.classList.remove('error');
                    branchError.style.display = 'none';
                }

                if (!isValid) {
                    stepError.textContent = 'Please fill in all required fields in Step 1 before proceeding.';
                    stepError.style.display = 'block';
                    setTimeout(() => stepError.style.display = 'none', 5000);
                }

                return isValid;
            }

            function validateStep2() {
                let isValid = true;
                const stepError = document.getElementById('step2Error');
                stepError.style.display = 'none';
                stepError.textContent = '';

                const ticketPrice = document.getElementById('ticketPrice');
                const ticketPriceError = document.getElementById('ticketPriceError');
                if (!ticketPrice.value || parseFloat(ticketPrice.value) < 0) {
                    ticketPrice.classList.add('error');
                    ticketPriceError.style.display = 'block';
                    isValid = false;
                } else {
                    ticketPrice.classList.remove('error');
                    ticketPriceError.style.display = 'none';
                }

                const capacity = document.getElementById('capacity');
                if (capacity.value && capacity.value < 1) {
                    capacity.classList.add('error');
                    isValid = false;
                } else {
                    capacity.classList.remove('error');
                }

                if (!isValid) {
                    stepError.textContent = 'Please fill in all required fields in Step 2 before proceeding.';
                    stepError.style.display = 'block';
                    setTimeout(() => stepError.style.display = 'none', 5000);
                }

                return isValid;
            }

            function validateStep3() {
                let isValid = true;
                const stepError = document.getElementById('step3Error');
                stepError.style.display = 'none';
                stepError.textContent = '';

                const address = document.getElementById('address');
                const addressError = document.getElementById('addressError');
                if (!address.value.trim()) {
                    address.classList.add('error');
                    addressError.style.display = 'block';
                    isValid = false;
                } else {
                    address.classList.remove('error');
                    addressError.style.display = 'none';
                }

                const city = document.getElementById('city');
                const cityError = document.getElementById('cityError');
                if (!city.value.trim()) {
                    city.classList.add('error');
                    cityError.style.display = 'block';
                    isValid = false;
                } else {
                    city.classList.remove('error');
                    cityError.style.display = 'none';
                }

                if (!isValid) {
                    stepError.textContent = 'Please fill in all required fields in Step 3 before proceeding.';
                    stepError.style.display = 'block';
                    setTimeout(() => stepError.style.display = 'none', 5000);
                }

                return isValid;
            }

            function validateStep4() {
                let isValid = true;
                const stepError = document.getElementById('step4Error');
                stepError.style.display = 'none';
                stepError.textContent = '';

                const facilitySelects = document.querySelectorAll('select[name^="InvitedFacilities"]');
                let hasValidFacility = false;

                facilitySelects.forEach((select, index) => {
                    const error = document.getElementById(`facilityError${index}`);
                    if (!select.value) {
                        select.classList.add('error');
                        error.style.display = 'block';
                        isValid = false;
                    } else {
                        select.classList.remove('error');
                        error.style.display = 'none';
                        hasValidFacility = true;
                    }
                });

                if (!hasValidFacility) {
                    stepError.textContent = 'Please select at least one facility in Step 4 before proceeding.';
                    stepError.style.display = 'block';
                    setTimeout(() => stepError.style.display = 'none', 5000);
                    isValid = false;
                }

                return isValid;
            }

            // Initialize map
            function initializeMap() {
                if (map) return;

                map = L.map('map').setView([21.4225, 39.8262], 13);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                }).addTo(map);

                map.on('click', function (e) {
                    const lat = e.latlng.lat;
                    const lng = e.latlng.lng;

                    document.getElementById('latitude').value = lat.toFixed(6);
                    document.getElementById('longitude').value = lng.toFixed(6);
                    document.getElementById('address').value = '';
                    document.getElementById('city').value = '';
                    clearSuggestions();

                    if (marker) {
                        map.removeLayer(marker);
                    }
                    marker = L.marker([lat, lng]).addTo(map);
                    map.panTo([lat, lng]);
                });

                const initialLat = parseFloat(document.getElementById('latitude').value);
                const initialLng = parseFloat(document.getElementById('longitude').value);
                if (!isNaN(initialLat) && !isNaN(initialLng)) {
                    map.setView([initialLat, initialLng], 13);
                    marker = L.marker([initialLat, initialLng]).addTo(map);
                }
            }

            // Address suggestion logic
            function clearSuggestions() {
                const suggestionsList = document.getElementById('addressSuggestions');
                suggestionsList.innerHTML = '';
                addressSuggestionsData = [];
            }

            async function fetchAddressSuggestions(query) {
                if (query.length < 3) {
                    clearSuggestions();
                    return;
                }

                try {
                    const response = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&format=json&addressdetails=1&limit=5`);
                    const results = await response.json();
                    clearSuggestions();
                    addressSuggestionsData = results;

                    const suggestionsList = document.getElementById('addressSuggestions');
                    results.forEach(result => {
                        const option = document.createElement('option');
                        option.value = result.display_name;
                        option.dataset.lat = result.lat;
                        option.dataset.lon = result.lon;
                        suggestionsList.appendChild(option);
                    });
                } catch (error) {
                    console.error('Error fetching address suggestions:', error);
                }
            }

            // Form initialization
            updateProgressBar();
            updateNavigationButtons();
            updateStepStatus();

            // Set default values
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('startDate').min = today;
            document.getElementById('endDate').min = today;

            if (!document.getElementById('latitude').value) {
                document.getElementById('latitude').value = '21.4225';
            }
            if (!document.getElementById('longitude').value) {
                document.getElementById('longitude').value = '39.8262';
            }

            // Real-time validation
            document.getElementById('campName').addEventListener('input', function () {
                const error = document.getElementById('campNameError');
                if (this.value.trim()) {
                    this.classList.remove('error');
                    error.style.display = 'none';
                } else {
                    this.classList.add('error');
                    error.style.display = 'block';
                }
            });

            document.getElementById('startDate').addEventListener('input', function () {
                const error = document.getElementById('startDateError');
                const endDate = document.getElementById('endDate');
                const endDateError = document.getElementById('endDateError');
                if (this.value) {
                    this.classList.remove('error');
                    error.style.display = 'none';
                    endDate.min = this.value;
                    if (endDate.value && new Date(endDate.value) <= new Date(this.value)) {
                        endDate.classList.add('error');
                        endDateError.textContent = 'End date must be after start date';
                        endDateError.style.display = 'block';
                    } else if (endDate.value) {
                        endDate.classList.remove('error');
                        endDateError.style.display = 'none';
                    }
                } else {
                    this.classList.add('error');
                    error.style.display = 'block';
                }
            });

            document.getElementById('endDate').addEventListener('input', function () {
                const error = document.getElementById('endDateError');
                const startDate = document.getElementById('startDate');
                if (!this.value) {
                    this.classList.add('error');
                    error.textContent = 'End date is required';
                    error.style.display = 'block';
                } else if (startDate.value && new Date(this.value) <= new Date(startDate.value)) {
                    this.classList.add('error');
                    error.textContent = 'End date must be after start date';
                    error.style.display = 'block';
                } else {
                    this.classList.remove('error');
                    error.style.display = 'none';
                }
            });

            document.getElementById('branch').addEventListener('change', function () {
                const error = document.getElementById('branchError');
                if (this.value) {
                    this.classList.remove('error');
                    error.style.display = 'none';
                } else {
                    this.classList.add('error');
                    error.style.display = 'block';
                }
            });

            document.getElementById('ticketPrice').addEventListener('input', function () {
                const error = document.getElementById('ticketPriceError');
                if (this.value && parseFloat(this.value) >= 0) {
                    this.classList.remove('error');
                    error.style.display = 'none';
                } else {
                    this.classList.add('error');
                    error.style.display = 'block';
                }
            });

            document.getElementById('capacity').addEventListener('input', function () {
                if (this.value && this.value < 1) {
                    this.classList.add('error');
                } else {
                    this.classList.remove('error');
                }
            });

            document.getElementById('address').addEventListener('input', function () {
                const error = document.getElementById('addressError');
                fetchAddressSuggestions(this.value.trim());
                if (this.value.trim()) {
                    this.classList.remove('error');
                    error.style.display = 'none';
                } else {
                    this.classList.add('error');
                    error.style.display = 'block';
                }
            });

            document.getElementById('city').addEventListener('input', function () {
                const error = document.getElementById('cityError');
                if (this.value.trim()) {
                    this.classList.remove('error');
                    error.style.display = 'none';
                } else {
                    this.classList.add('error');
                    error.style.display = 'block';
                }
            });

            document.getElementById('address').addEventListener('change', function () {
                const selectedOption = Array.from(document.getElementById('addressSuggestions').options).find(option => option.value === this.value);
                if (selectedOption) {
                    const result = addressSuggestionsData.find(data => data.display_name === selectedOption.value);
                    if (result) {
                        const lat = parseFloat(result.lat);
                        const lon = parseFloat(result.lon);
                        document.getElementById('latitude').value = lat.toFixed(6);
                        document.getElementById('longitude').value = lon.toFixed(6);
                        const addressDetails = result.address || {};
                        const city = addressDetails.city || addressDetails.town || addressDetails.village || '';
                        document.getElementById('city').value = city;
                        if (marker) {
                            map.removeLayer(marker);
                        }
                        marker = L.marker([lat, lon]).addTo(map);
                        map.setView([lat, lon], 13);
                        document.getElementById('address').classList.remove('error');
                        document.getElementById('addressError').style.display = 'none';
                        document.getElementById('city').classList.remove('error');
                        document.getElementById('cityError').style.display = 'none';
                    }
                }
            });

            // Step navigation
            window.nextStep = function () {
                if (validateCurrentStep()) {
                    if (currentStep < 4) {
                        document.getElementById(`step${currentStep}`).classList.remove('active');
                        currentStep++;
                        document.getElementById(`step${currentStep}`).classList.add('active');
                        updateProgressBar();
                        updateNavigationButtons();
                        updateStepStatus();
                        if (currentStep === 3) {
                            initializeMap();
                            setTimeout(() => map.invalidateSize(), 200);
                        }
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                }
            };

            window.previousStep = function () {
                if (currentStep > 1) {
                    document.getElementById(`step${currentStep}`).classList.remove('active');
                    currentStep--;
                    document.getElementById(`step${currentStep}`).classList.add('active');
                    updateProgressBar();
                    updateNavigationButtons();
                    updateStepStatus();
                    if (currentStep === 3) {
                        initializeMap();
                        setTimeout(() => map.invalidateSize(), 200);
                    }
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            };

            function validateCurrentStep() {
                if (currentStep === 1) return validateStep1();
                if (currentStep === 2) return validateStep2();
                if (currentStep === 3) return validateStep3();
                if (currentStep === 4) return validateStep4();
                return false;
            }

            // Step click navigation
            document.querySelectorAll('.step').forEach(step => {
                step.addEventListener('click', function () {
                    const targetStep = parseInt(this.getAttribute('data-step'));
                    if (targetStep === 1 || (targetStep === 2 && validateStep1()) ||
                        (targetStep === 3 && validateStep1() && validateStep2()) ||
                        (targetStep === 4 && validateStep1() && validateStep2() && validateStep3())) {
                        document.getElementById(`step${currentStep}`).classList.remove('active');
                        currentStep = targetStep;
                        document.getElementById(`step${currentStep}`).classList.add('active');
                        updateProgressBar();
                        updateNavigationButtons();
                        updateStepStatus();
                        if (currentStep === 3) {
                            initializeMap();
                            setTimeout(() => map.invalidateSize(), 200);
                        }
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                });
            });

            // Form submission
            document.getElementById('campForm').addEventListener('submit', function (e) {
                e.preventDefault();
                if (currentStep !== 4) {
                    const stepError = document.getElementById(`step${currentStep}Error`);
                    stepError.textContent = 'Please complete all steps before submitting.';
                    stepError.style.display = 'block';
                    setTimeout(() => stepError.style.display = 'none', 5000);
                    return;
                }
                if (validateStep1() && validateStep2() && validateStep3() && validateStep4()) {
                    const submitBtn = document.getElementById('submitBtn');
                    submitBtn.textContent = 'Creating...';
                    submitBtn.disabled = true;
                    document.getElementById('successMessage').style.display = 'block';
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    setTimeout(() => this.submit(), 1500);
                } else {
                    const stepError = document.getElementById('step4Error');
                    stepError.textContent = 'Please complete all required fields in Step 4 before submitting.';
                    stepError.style.display = 'block';
                    setTimeout(() => stepError.style.display = 'none', 5000);
                }
            });

            // Create and another
            window.createAndAnother = function () {
                if (validateStep1() && validateStep2() && validateStep3() && validateStep4()) {
                    const form = document.getElementById('campForm');
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'createAnother';
                    input.value = 'true';
                    form.appendChild(input);
                    document.getElementById('successMessage').style.display = 'block';
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    setTimeout(() => form.submit(), 1500);
                } else {
                    const stepError = document.getElementById('step4Error');
                    stepError.textContent = 'Please complete all required fields in Step 4 before submitting.';
                    stepError.style.display = 'block';
                    setTimeout(() => stepError.style.display = 'none', 5000);
                }
            };

            // Facility real-time validation
            function validateFacilities() {
                const facilitySelects = document.querySelectorAll('select[name^="InvitedFacilities"]');
                facilitySelects.forEach((select, index) => {
                    const error = document.getElementById(`facilityError${index}`);
                    select.addEventListener('change', function () {
                        if (this.value) {
                            this.classList.remove('error');
                            error.style.display = 'none';
                        } else {
                            this.classList.add('error');
                            error.style.display = 'block';
                        }
                    });
                });
            }

            // Activity Functions
            window.addActivity = function () {
                const container = document.getElementById('activitiesContainer');
                const activityIndex = activityCount++;
                const activityDiv = document.createElement('div');
                activityDiv.className = 'activity-item';
                activityDiv.innerHTML = `
                    <div>
                        <label>Activity</label>
                        <input type="text" name="Activities[${activityIndex}].ActivityName" class="form-control" placeholder="Enter activity name" />
                    </div>
                    <div>
                        <label>Activity Description</label>
                        <textarea name="Activities[${activityIndex}].ActivityDescription" class="form-control" placeholder="Enter activity description"></textarea>
                    </div>
                    <div style="display: flex; align-items: center;">
                        <span class="copy-icon" onclick="duplicateActivity(this)" title="Duplicate">📋</span>
                        <button type="button" class="delete-btn" onclick="removeActivity(this)" title="Delete">🗑</button>
                    </div>
                `;
                container.appendChild(activityDiv);
            };

            window.duplicateActivity = function (el) {
                const parent = el.closest('.activity-item');
                const clone = parent.cloneNode(true);
                const newIndex = activityCount++;
                clone.querySelectorAll('input, textarea').forEach(input => {
                    if (input.name.includes('Activities')) {
                        input.name = input.name.replace(/\[\d+\]/, `[${newIndex}]`);
                        input.value = '';
                    }
                });
                parent.after(clone);
            };

            window.removeActivity = function (el) {
                const parent = el.closest('.activity-item');
                const container = document.getElementById('activitiesContainer');
                if (container.children.length > 1) {
                    parent.remove();
                } else {
                    const stepError = document.getElementById('step2Error');
                    stepError.textContent = 'At least one activity must remain.';
                    stepError.style.display = 'block';
                    setTimeout(() => stepError.style.display = 'none', 5000);
                }
            };

            // Facility Functions
            window.addFacility = function () {
                const container = document.getElementById('facilitiesContainer');
                const index = facilityCount++;
                const facilityDiv = document.createElement('div');
                facilityDiv.className = 'facility-item';
                facilityDiv.innerHTML = `
                    <div>
                        <label>Invited Facility <span class="required">*</span></label>
                        <select name="InvitedFacilities[${index}].FacilityName" class="form-control" required>
                            <option value="">Select an option</option>
                            <option value="facility1">Sports Complex A</option>
                            <option value="facility2">Training Center B</option>
                            <option value="facility3">Academy C</option>
                            <option value="facility4">Fitness Center D</option>
                            <option value="facility5">Recreation Center E</option>
                        </select>
                        <div class="error-message" id="facilityError${index}">Please select a facility</div>
                    </div>
                    <div>
                        <label>Invitation Message</label>
                        <textarea name="InvitedFacilities[${index}].InvitationMessage" class="form-control" placeholder="Enter invitation message..."></textarea>
                    </div>
                    <div style="display: flex; align-items: center;">
                        <span class="copy-icon" onclick="duplicateFacility(this)" title="Duplicate">📋</span>
                        <button type="button" class="delete-btn" onclick="removeFacility(this)" title="Delete">🗑</button>
                    </div>
                `;
                container.appendChild(facilityDiv);
                validateFacilities();
            };

            window.duplicateFacility = function (el) {
                const parent = el.closest('.facility-item');
                const clone = parent.cloneNode(true);
                const newIndex = facilityCount++;
                clone.querySelectorAll('select, textarea').forEach(input => {
                    if (input.name.includes('InvitedFacilities')) {
                        input.name = input.name.replace(/\[\d+\]/, `[${newIndex}]`);
                        if (input.tagName === 'SELECT') input.selectedIndex = 0;
                        else input.value = '';
                    }
                });
                clone.querySelector('.error-message').id = `facilityError${newIndex}`;
                parent.after(clone);
                validateFacilities();
            };

            window.removeFacility = function (el) {
                const parent = el.closest('.facility-item');
                const container = document.getElementById('facilitiesContainer');
                if (container.children.length > 1) {
                    parent.remove();
                } else {
                    const stepError = document.getElementById('step4Error');
                    stepError.textContent = 'At least one facility must remain.';
                    stepError.style.display = 'block';
                    setTimeout(() => stepError.style.display = 'none', 5000);
                }
            };

            window.cancelForm = function () {
                if (confirm("Are you sure you want to cancel? All data will be lost.")) {
                    window.location.href = '/Calendar/Index';
                }
            };

            function updateProgressBar() {
                const progressLine = document.getElementById('progressLine');
                const percentage = ((currentStep - 1) / 3) * 100;
                progressLine.style.width = `${percentage}%`;
            }

            function updateNavigationButtons() {
                const backBtn = document.getElementById('backBtn');
                const nextActions = document.getElementById('nextActions');
                const finalActions = document.getElementById('finalActions');
                backBtn.style.opacity = currentStep === 1 ? '0' : '1';
                backBtn.style.pointerEvents = currentStep === 1 ? 'none' : 'auto';
                nextActions.style.display = currentStep === 4 ? 'none' : 'block';
                finalActions.style.display = currentStep === 4 ? 'flex' : 'none';
            }

            function updateStepStatus() {
                document.querySelectorAll('.step').forEach((step, index) => {
                    step.classList.remove('active', 'completed');
                    const stepNumber = index + 1;
                    const circle = step.querySelector('.step-circle');
                    if (stepNumber < currentStep) {
                        step.classList.add('completed');
                        circle.innerHTML = '✔';
                    } else if (stepNumber === currentStep) {
                        step.classList.add('active');
                        circle.innerHTML = String(stepNumber).padStart(2, '0');
                    } else {
                        circle.innerHTML = String(stepNumber).padStart(2, '0');
                    }
                });
            }

            // Initialize validation for initial facility
            validateFacilities();

            // Handle server validation errors
            if (document.querySelector('.validation-summary-errors, .field-validation-error')) {
                currentStep = 4;
                document.getElementById('step4').classList.add('active');
                document.getElementById('step1').classList.remove('active');
                updateProgressBar();
                updateNavigationButtons();
                updateStepStatus();
            }
        });
    </script>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}