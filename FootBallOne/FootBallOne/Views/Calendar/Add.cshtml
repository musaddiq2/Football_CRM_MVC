@model FootBallOne.Models.CreateEventViewModel

@{
    ViewData["Title"] = "Create Event";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Event</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            background: white;
            min-height: 100vh;
        }

        .breadcrumb {
            background: transparent;
            padding: 0;
            margin-bottom: 20px;
            font-size: 14px;
            color: #6c757d;
        }

            .breadcrumb a {
                color: #6c757d;
                text-decoration: none;
            }

        h1 {
            font-size: 28px;
            font-weight: 400;
            color: #212529;
            margin: 0 0 40px 0;
        }

        .steps-container {
            display: flex;
            justify-content: flex-start;
            margin-bottom: 50px;
            gap: 80px;
            padding: 0 20px;
        }

        .step {
            display: flex;
            align-items: center;
            font-size: 14px;
            color: #6c757d;
            position: relative;
            cursor: pointer;
        }

            .step.active {
                color: #17a2b8;
            }

            .step.completed {
                color: #28a745;
            }

        .step-number {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 400;
            margin-right: 12px;
            font-size: 14px;
            border: 2px solid #e9ecef;
            color: #6c757d;
            background: white;
        }

        .step.active .step-number {
            background-color: #17a2b8;
            border-color: #17a2b8;
            color: white;
        }

        .step.completed .step-number {
            background-color: #28a745;
            border-color: #28a745;
            color: white;
        }

            .step.completed .step-number:before {
                content: "✓";
                font-size: 16px;
            }

        .form-container {
            max-width: 900px;
            padding: 0 20px;
        }

        .step-content {
            display: none;
        }

            .step-content.active {
                display: block;
            }

        .form-group {
            margin-bottom: 30px;
        }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                font-size: 14px;
                font-weight: 400;
                color: #495057;
            }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            font-size: 14px;
            background-color: white;
            box-sizing: border-box;
            font-family: inherit;
        }

            .form-control:focus {
                outline: none;
                border-color: #80bdff;
                box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
            }

            .form-control.error {
                border-color: #dc3545;
                box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.1);
            }

        textarea.form-control {
            height: 100px;
            resize: vertical;
            font-family: inherit;
        }

        .form-row {
            display: flex;
            gap: 20px;
        }

            .form-row .form-group {
                flex: 1;
            }

        select.form-control {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");
            background-position: right 12px center;
            background-repeat: no-repeat;
            background-size: 16px;
            padding-right: 40px;
            appearance: none;
        }

        .btn-next, .btn-submit {
            background-color: #17a2b8;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 400;
            cursor: pointer;
            float: right;
            margin-top: 20px;
        }

            .btn-next:hover, .btn-submit:hover {
                background-color: #138496;
            }

            .btn-next:disabled, .btn-submit:disabled {
                background-color: #6c757d;
                cursor: not-allowed;
            }

        .error-message {
            color: #dc3545;
            font-size: 12px;
            margin-top: 4px;
            display: none;
        }

        .success-message {
            background-color: #d4edda;
            border: 1px solid #c3e6cb;
            color: #155724;
            padding: 15px;
            border-radius: 4px;
            margin-bottom: 20px;
            display: none;
        }

        .step-error {
            margin-bottom: 15px;
            font-weight: 400;
            padding: 10px;
            background: rgba(220, 53, 69, 0.1);
            border-radius: 4px;
            color: #dc3545;
            font-size: 14px;
            display: none;
        }

        input[type="datetime-local"] {
            font-family: inherit;
        }

        .clearfix::after {
            content: "";
            display: table;
            clear: both;
        }

        #map {
            height: 400px;
            margin-top: 20px;
        }

        #autocomplete-list {
            border: 1px solid #ccc;
            max-height: 150px;
            overflow-y: auto;
            position: absolute;
            background: white;
            width: 100%;
            z-index: 1000;
        }

        .autocomplete-item {
            padding: 5px;
            cursor: pointer;
        }

            .autocomplete-item:hover {
                background-color: #eee;
            }

        .autocomplete-container {
            position: relative;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Breadcrumb -->
        <div class="breadcrumb">
            <a href="@Url.Action("Index", "Calendar")">Events</a> > Create
        </div>

        <!-- Page Title -->
        <h1>Create Event</h1>

        <!-- Success Message -->
        <div id="successMessage" class="success-message">
            Event created successfully!
        </div>

        <!-- Steps Navigation -->
        <div class="steps-container">
            <div class="step active" id="step1">
                <div class="step-number">01</div>
                <span>Basic Information</span>
            </div>
            <div class="step" id="step2">
                <div class="step-number">02</div>
                <span>Details</span>
            </div>
            <div class="step" id="step3">
                <div class="step-number">03</div>
                <span>Invited Facilities</span>
            </div>
        </div>

        <!-- Form -->
        @using (Html.BeginForm("Add", "Calendar", FormMethod.Post, new { id = "eventForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-container">
                <!-- Step 1: Basic Information -->
                <div class="step-content active" id="step1Content">
                    <div class="step-error" id="step1Error"></div>
                    <div class="form-group">
                        <label for="Title">Event Name*</label>
                        @Html.TextBoxFor(m => m.Title, new { @class = "form-control", id = "eventName" })
                        <div class="error-message" id="eventNameError">Event name is required</div>
                    </div>

                    <div class="form-group">
                        <label for="Description">Event Description</label>
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", id = "eventDescription" })
                    </div>

                    <div class="form-group">
                        <label for="TicketPrice">Ticket Price</label>
                        @Html.TextBoxFor(m => m.TicketPrice, new { @class = "form-control", type = "number", step = "0.01", id = "ticketPrice" })
                        <div class="error-message" id="ticketPriceError">Please enter a valid price (0 or greater)</div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="StartDate">Start Date*</label>
                            @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local", id = "startDate" })
                            <div class="error-message" id="startDateError">Start date is required</div>
                        </div>
                        <div class="form-group">
                            <label for="EndDate">End Date*</label>
                            @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local", id = "endDate" })
                            <div class="error-message" id="endDateError">End date is required and must be after start date</div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="Branch">Branch*</label>
                        @Html.DropDownListFor(m => m.Branch, new SelectList(new[] { "الفرع الرئيسي" }), "Select Branch", new { @class = "form-control", id = "branch" })
                        <div class="error-message" id="branchError">Please select a branch</div>
                    </div>

                    <div class="clearfix">
                        <button type="button" class="btn-next" id="nextStep1">Next</button>
                    </div>
                </div>

                <!-- Step 2: Details -->
                <div class="step-content" id="step2Content">
                    <div class="step-error" id="step2Error"></div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="AvailableCapacity">Available Capacity*</label>
                            @Html.TextBoxFor(m => m.AvailableCapacity, new { @class = "form-control", type = "number", min = "1", id = "capacity" })
                            <div class="error-message" id="capacityError">Capacity must be at least 1</div>
                        </div>
                        <div class="form-group">
                            <label for="EventType">Event Type*</label>
                            @Html.DropDownListFor(m => m.EventType, new SelectList(new[] { "Festival", "WorkShop", "Seminar", "Conference", "Competition", "Training Course", "Trip", "Exhibition", "Other Event" }), "Select", new { @class = "form-control", id = "eventType" })
                            <div class="error-message" id="eventTypeError">Please select an event type</div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group autocomplete-container" style="flex: 1; min-width: 300px;">
                            <label for="Adress">Address*</label>
                            @Html.TextBoxFor(m => m.Adress, new { @class = "form-control", id = "address", autocomplete = "off" })
                            <div id="autocomplete-list"></div>
                            <div class="error-message" id="addressError">Address is required</div>
                        </div>
                        <div class="form-group" style="flex: 1; min-width: 200px;">
                            <label for="City">City*</label>
                            @Html.TextBoxFor(m => m.City, new { @class = "form-control", id = "city" })
                            <div class="error-message" id="cityError">City is required</div>
                        </div>
                    </div>

                    <div id="map"></div>

                    <div class="form-row">
                        <div class="form-group" style="flex: 1; min-width: 150px;">
                            <label for="Latitude">Latitude</label>
                            @Html.TextBoxFor(m => m.Latitude, new { @class = "form-control", type = "number", step = "any", id = "latitude" })
                        </div>
                        <div class="form-group" style="flex: 1; min-width: 150px;">
                            <label for="Longitude">Longitude</label>
                            @Html.TextBoxFor(m => m.Longitude, new { @class = "form-control", type = "number", step = "any", id = "longitude" })
                        </div>
                    </div>

                    <div class="clearfix">
                        <button type="button" class="btn-next" id="nextStep2">Next</button>
                    </div>
                </div>

                <!-- Step 3: Invited Facilities -->
                <div class="step-content" id="step3Content">
                    <div class="step-error" id="step3Error"></div>
                    <div class="form-group">
                        <label for="InvitedFacility">Invited Facility</label>
                        @Html.TextBoxFor(m => m.InvitedFacility, new { @class = "form-control", id = "invitedFacility" })
                    </div>

                    <div class="form-group">
                        <label for="InvitationMessage">Invitation Message</label>
                        @Html.TextAreaFor(m => m.InvitationMessage, new { @class = "form-control", id = "invitationMessage" })
                    </div>

                    <div class="clearfix">
                        <button type="submit" class="btn-submit" id="submitForm">Submit</button>
                    </div>
                </div>
            </div>
        }
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let currentStep = 1;
            const totalSteps = 3;

            // Validation functions
            function validateStep1() {
                let isValid = true;
                const stepError = document.getElementById('step1Error');

                // Clear previous step error
                stepError.style.display = 'none';
                stepError.textContent = '';

                // Event Name
                const eventName = document.getElementById('eventName');
                const eventNameError = document.getElementById('eventNameError');
                if (!eventName.value.trim()) {
                    eventName.classList.add('error');
                    eventNameError.style.display = 'block';
                    isValid = false;
                } else {
                    eventName.classList.remove('error');
                    eventNameError.style.display = 'none';
                }

                // Start Date
                const startDate = document.getElementById('startDate');
                const startDateError = document.getElementById('startDateError');
                if (!startDate.value) {
                    startDate.classList.add('error');
                    startDateError.style.display = 'block';
                    isValid = false;
                } else {
                    startDate.classList.remove('error');
                    startDateError.style.display = 'none';
                }

                // End Date
                const endDate = document.getElementById('endDate');
                const endDateError = document.getElementById('endDateError');
                if (!endDate.value) {
                    endDate.classList.add('error');
                    endDateError.textContent = 'End date is required';
                    endDateError.style.display = 'block';
                    isValid = false;
                } else if (new Date(endDate.value) <= new Date(startDate.value)) {
                    endDate.classList.add('error');
                    endDateError.textContent = 'End date must be after start date';
                    endDateError.style.display = 'block';
                    isValid = false;
                } else {
                    endDate.classList.remove('error');
                    endDateError.style.display = 'none';
                }

                // Branch
                const branch = document.getElementById('branch');
                const branchError = document.getElementById('branchError');
                if (!branch.value) {
                    branch.classList.add('error');
                    branchError.style.display = 'block';
                    isValid = false;
                } else {
                    branch.classList.remove('error');
                    branchError.style.display = 'none';
                }

                // Ticket Price (optional, but must be non-negative if provided)
                const ticketPrice = document.getElementById('ticketPrice');
                const ticketPriceError = document.getElementById('ticketPriceError');
                if (ticketPrice.value && ticketPrice.value < 0) {
                    ticketPrice.classList.add('error');
                    ticketPriceError.style.display = 'block';
                    isValid = false;
                } else {
                    ticketPrice.classList.remove('error');
                    ticketPriceError.style.display = 'none';
                }

                // Display step-wide error
                if (!isValid) {
                    stepError.textContent = 'Please fill in all required fields in Step 1 before proceeding.';
                    stepError.style.display = 'block';
                    setTimeout(() => stepError.style.display = 'none', 5000);
                }

                return isValid;
            }

            function validateStep2() {
                let isValid = true;
                const stepError = document.getElementById('step2Error');

                // Clear previous step error
                stepError.style.display = 'none';
                stepError.textContent = '';

                // Capacity
                const capacity = document.getElementById('capacity');
                const capacityError = document.getElementById('capacityError');
                if (!capacity.value || capacity.value < 1) {
                    capacity.classList.add('error');
                    capacityError.style.display = 'block';
                    isValid = false;
                } else {
                    capacity.classList.remove('error');
                    capacityError.style.display = 'none';
                }

                // Event Type
                const eventType = document.getElementById('eventType');
                const eventTypeError = document.getElementById('eventTypeError');
                if (!eventType.value) {
                    eventType.classList.add('error');
                    eventTypeError.style.display = 'block';
                    isValid = false;
                } else {
                    eventType.classList.remove('error');
                    eventTypeError.style.display = 'none';
                }

                // Address
                const address = document.getElementById('address');
                const addressError = document.getElementById('addressError');
                if (!address.value.trim()) {
                    address.classList.add('error');
                    addressError.style.display = 'block';
                    isValid = false;
                } else {
                    address.classList.remove('error');
                    addressError.style.display = 'none';
                }

                // City
                const city = document.getElementById('city');
                const cityError = document.getElementById('cityError');
                if (!city.value.trim()) {
                    city.classList.add('error');
                    cityError.style.display = 'block';
                    isValid = false;
                } else {
                    city.classList.remove('error');
                    cityError.style.display = 'none';
                }

                // Display step-wide error
                if (!isValid) {
                    stepError.textContent = 'Please fill in all required fields in Step 2 before proceeding.';
                    stepError.style.display = 'block';
                    setTimeout(() => stepError.style.display = 'none', 5000);
                }

                return isValid;
            }

            function validateStep3() {
                // Step 3 has no required fields, so always valid
                return true;
            }

            function showStep(step) {
                // Hide all step contents
                document.querySelectorAll('.step-content').forEach(content => {
                    content.classList.remove('active');
                });

                // Remove active/completed classes from all steps
                document.querySelectorAll('.step').forEach(stepEl => {
                    stepEl.classList.remove('active', 'completed');
                });

                // Show current step content
                document.getElementById(`step${step}Content`).classList.add('active');
                document.getElementById(`step${step}`).classList.add('active');

                // Mark previous steps as completed
                for (let i = 1; i < step; i++) {
                    document.getElementById(`step${i}`).classList.add('completed');
                    document.getElementById(`step${i}`).querySelector('.step-number').textContent = '✓';
                }

                // Update step number for non-completed steps
                for (let i = step; i <= totalSteps; i++) {
                    document.getElementById(`step${i}`).querySelector('.step-number').textContent = `0${i}`;
                }

                currentStep = step;

                // Invalidate map size when showing Step 2
                if (step === 2) {
                    setTimeout(() => map.invalidateSize(), 200);
                }
            }

            // Step Navigation
            document.getElementById('nextStep1').addEventListener('click', function () {
                if (validateStep1()) {
                    showStep(2);
                }
            });

            document.getElementById('nextStep2').addEventListener('click', function () {
                if (validateStep2()) {
                    showStep(3);
                }
            });

            // Step Click Navigation
            document.getElementById('step1').addEventListener('click', function () {
                showStep(1);
            });

            document.getElementById('step2').addEventListener('click', function () {
                if (validateStep1()) {
                    showStep(2);
                }
            });

            document.getElementById('step3').addEventListener('click', function () {
                if (validateStep1() && validateStep2()) {
                    showStep(3);
                }
            });

            // Form submission
            document.getElementById('eventForm').addEventListener('submit', function (e) {
                e.preventDefault();
                if (validateStep1() && validateStep2() && validateStep3()) {
                    document.getElementById('successMessage').style.display = 'block';
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    setTimeout(() => this.submit(), 1500);
                } else {
                    const stepError = document.getElementById(`step${currentStep}Error`);
                    stepError.textContent = `Please complete all required fields in Step ${currentStep} before submitting.`;
                    stepError.style.display = 'block';
                    setTimeout(() => stepError.style.display = 'none', 5000);
                }
            });

            // Real-time validation
            document.getElementById('eventName').addEventListener('input', function () {
                const error = document.getElementById('eventNameError');
                if (this.value.trim()) {
                    this.classList.remove('error');
                    error.style.display = 'none';
                } else {
                    this.classList.add('error');
                    error.style.display = 'block';
                }
            });

            document.getElementById('startDate').addEventListener('input', function () {
                const error = document.getElementById('startDateError');
                const endDate = document.getElementById('endDate');
                const endDateError = document.getElementById('endDateError');
                if (this.value) {
                    this.classList.remove('error');
                    error.style.display = 'none';
                    // Re-validate end date if start date changes
                    if (endDate.value && new Date(endDate.value) <= new Date(this.value)) {
                        endDate.classList.add('error');
                        endDateError.textContent = 'End date must be after start date';
                        endDateError.style.display = 'block';
                    } else if (endDate.value) {
                        endDate.classList.remove('error');
                        endDateError.style.display = 'none';
                    }
                } else {
                    this.classList.add('error');
                    error.style.display = 'block';
                }
            });

            document.getElementById('endDate').addEventListener('input', function () {
                const error = document.getElementById('endDateError');
                const startDate = document.getElementById('startDate');
                if (!this.value) {
                    this.classList.add('error');
                    error.textContent = 'End date is required';
                    error.style.display = 'block';
                } else if (startDate.value && new Date(this.value) <= new Date(startDate.value)) {
                    this.classList.add('error');
                    error.textContent = 'End date must be after start date';
                    error.style.display = 'block';
                } else {
                    this.classList.remove('error');
                    error.style.display = 'none';
                }
            });

            document.getElementById('branch').addEventListener('change', function () {
                const error = document.getElementById('branchError');
                if (this.value) {
                    this.classList.remove('error');
                    error.style.display = 'none';
                } else {
                    this.classList.add('error');
                    error.style.display = 'block';
                }
            });

            document.getElementById('ticketPrice').addEventListener('input', function () {
                const error = document.getElementById('ticketPriceError');
                if (this.value && this.value < 0) {
                    this.classList.add('error');
                    error.style.display = 'block';
                } else {
                    this.classList.remove('error');
                    error.style.display = 'none';
                }
            });

            document.getElementById('capacity').addEventListener('input', function () {
                const error = document.getElementById('capacityError');
                if (this.value && this.value >= 1) {
                    this.classList.remove('error');
                    error.style.display = 'none';
                } else {
                    this.classList.add('error');
                    error.style.display = 'block';
                }
            });

            document.getElementById('eventType').addEventListener('change', function () {
                const error = document.getElementById('eventTypeError');
                if (this.value) {
                    this.classList.remove('error');
                    error.style.display = 'none';
                } else {
                    this.classList.add('error');
                    error.style.display = 'block';
                }
            });

            document.getElementById('address').addEventListener('input', function () {
                const error = document.getElementById('addressError');
                if (this.value.trim()) {
                    this.classList.remove('error');
                    error.style.display = 'none';
                } else {
                    this.classList.add('error');
                    error.style.display = 'block';
                }
            });

            document.getElementById('city').addEventListener('input', function () {
                const error = document.getElementById('cityError');
                if (this.value.trim()) {
                    this.classList.remove('error');
                    error.style.display = 'none';
                } else {
                    this.classList.add('error');
                    error.style.display = 'block';
                }
            });

            // Set default values
            const now = new Date();
            const startDateInput = document.getElementById('startDate');
            const endDateInput = document.getElementById('endDate');

            if (!startDateInput.value) {
                const startDate = new Date(now);
                startDateInput.value = startDate.toISOString().slice(0, 16);
            }

            if (!endDateInput.value) {
                const endDate = new Date(now);
                endDate.setHours(endDate.getHours() + 2);
                endDateInput.value = endDate.toISOString().slice(0, 16);
            }

            if (!document.getElementById('capacity').value) {
                document.getElementById('capacity').value = '50';
            }

            // Map and Autocomplete
            const initLat = parseFloat(document.getElementById('latitude').value) || 24.7136; // Default: Riyadh
            const initLng = parseFloat(document.getElementById('longitude').value) || 46.6753;

            const map = L.map('map').setView([initLat, initLng], 13);

            L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; <a href="https://carto.com/">CARTO</a> | © OpenStreetMap contributors',
                subdomains: 'abcd',
                maxZoom: 19
            }).addTo(map);

            let marker;

            function placeMarker(lat, lng) {
                if (marker) {
                    marker.setLatLng([lat, lng]);
                } else {
                    marker = L.marker([lat, lng]).addTo(map);
                }
            }

            // Place initial marker
            placeMarker(initLat, initLng);

            // Autocomplete using Nominatim
            $('#address').on('input', function () {
                const query = $(this).val();
                const list = $('#autocomplete-list');

                if (query.length < 3) {
                    list.empty();
                    return;
                }

                $.getJSON('https://nominatim.openstreetmap.org/search', {
                    q: query,
                    format: 'json',
                    addressdetails: 1,
                    limit: 5
                }).done(function (data) {
                    list.empty();

                    data.forEach(function (item) {
                        const displayName = item.display_name;
                        const city = item.address.city || item.address.town || item.address.village || '';
                        const lat = item.lat;
                        const lon = item.lon;

                        const option = $('<div>')
                            .addClass('autocomplete-item')
                            .text(displayName)
                            .data('lat', lat)
                            .data('lon', lon)
                            .data('city', city);

                        option.on('click', function () {
                            $('#address').val(displayName);
                            $('#city').val(city);
                            $('#latitude').val(lat);
                            $('#longitude').val(lon);
                            placeMarker(lat, lon);
                            map.setView([lat, lon], 13);
                            list.empty();
                            // Clear address and city errors
                            $('#address').removeClass('error');
                            $('#addressError').hide();
                            $('#city').removeClass('error');
                            $('#cityError').hide();
                        });

                        list.append(option);
                    });
                });
            });

            // Close autocomplete if clicked outside
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#autocomplete-list, #address').length) {
                    $('#autocomplete-list').empty();
                }
            });
        });
    </script>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}