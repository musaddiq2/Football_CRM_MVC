@model IEnumerable<FootBallOne.Models.Coach>

@{
    ViewData["Title"] = "Coaches";
    
    Layout = "_Layout";

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Coaches</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            padding: 20px;
        }

        .img-thumbnail {
            border-radius: 0.375rem;
            border: 1px solid #dee2e6;
        }
    </style>
</head>
<body>
    <div class="w-full max-w-7xl bg-white rounded-xl shadow-lg p-8">

        <!-- Header -->
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-900">Coaches</h1>
            <a href="@Url.Action("Create", "Coach")"
               class="px-4 py-2 bg-indigo-600 text-white rounded-md shadow hover:bg-indigo-700 transition duration-200">
                + Create New Coach
            </a>
        </div>

        <!-- Search bar (optional, static for now) -->
        <form method="get" class="mb-6 flex gap-4">
            <input type="text" name="searchString" class="flex-1 px-3 py-2 border rounded-md shadow-sm"
                   placeholder="Search by name or email..." />
            <button type="submit"
                    class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-200">
                Search
            </button>
        </form>

        <!-- Check if there is data -->
        @if (!Model.Any())
        {
            <p class="text-center text-red-500 font-semibold">No coaches found.</p>
        }
        else
        {
            <!-- Table -->
            <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-800 text-white">
                        <tr>
                            <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Photo</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Full Name</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Age</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Phone</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Email</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Specialization</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Exp. Years</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Players</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Joining Date</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold uppercase">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <img src="@item.PhotoFile" alt="Coach Photo"
                                         class="w-14 h-14 object-cover rounded-md img-thumbnail" />
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-900">@item.FullName</td>
                                <td class="px-6 py-4 text-sm text-gray-900">@item.Age</td>
                                <td class="px-6 py-4 text-sm text-gray-900">@item.PhoneNumber</td>
                                <td class="px-6 py-4 text-sm text-gray-900">@item.Email</td>
                                <td class="px-6 py-4 text-sm text-gray-900">@item.Specialization</td>
                                <td class="px-6 py-4 text-sm text-gray-900">@item.ExperienceYears</td>
                                <td class="px-6 py-4 text-sm text-gray-900">@item.AssignedPlayers</td>
                                <td class="px-6 py-4 text-sm text-gray-900">
                                    @item.JoiningDate.ToString("yyyy-MM-dd")
                                </td>
                                <td class="px-6 py-4 text-sm font-medium space-x-2">
                                    <a asp-action="Edit" asp-route-id="@item.CoachId"
                                       class="text-yellow-600 hover:text-yellow-800">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.CoachId"
                                       class="text-blue-600 hover:text-blue-800">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.CoachId"
                                       class="text-red-600 hover:text-red-800">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</body>
</html>
