@model FootBallOne.Models.FootballAcademy
@{
    ViewData["Title"] = "Academy Profile";
}

<div class="container my-5">
    <h2 class="mb-4">Academy Profile</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form asp-action="UpdateProfile" method="post">
        <div class="mb-3">
            <label asp-for="AcademyName" class="form-label">Academy Name</label>
            <input asp-for="AcademyName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="AcademyAddress" class="form-label">Address</label>
            <input asp-for="AcademyAddress" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Location" class="form-label">Location</label>
            <input asp-for="Location" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Capacity" class="form-label">Capacity</label>
            <input asp-for="Capacity" type="number" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="ContactNo" class="form-label">Contact Number</label>
            <input asp-for="ContactNo" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="HeadCoach" class="form-label">Head Coach</label>
            <input asp-for="HeadCoach" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Update Profile</button>
        <a asp-action="Logout" class="btn btn-danger ms-2">Logout</a>
    </form>
</div>
