@{
    ViewData["Title"] = "Player Login";
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            font-family: 'Segoe UI', sans-serif;
            color: #fff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .esports-card {
            background: rgba(255, 255, 255, 0.08);
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(12px);
            animation: fadeIn 1s ease-in-out;
        }

        .esports-title {
            text-align: center;
            font-weight: bold;
            font-size: 1.8rem;
            background: linear-gradient(90deg, #ff8c00, #ff0080);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1.5rem;
        }

        .esports-label {
            font-weight: 600;
            margin-bottom: 0.3rem;
            display: block;
            color: #ffd700;
        }

        .esports-input {
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            border-radius: 10px;
            padding: 0.75rem;
            transition: 0.3s;
        }

            .esports-input:focus {
                border-color: #ff8c00;
                box-shadow: 0 0 10px rgba(255, 140, 0, 0.6);
            }

        .esports-button {
            background: linear-gradient(90deg, #ff8c00, #ff0080);
            border: none;
            padding: 0.75rem;
            border-radius: 10px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: 0.3s;
            color: white;
        }

            .esports-button:hover {
                background: linear-gradient(90deg, #ff0080, #ff8c00);
                box-shadow: 0 0 15px rgba(255, 140, 0, 0.7);
                transform: scale(1.02);
            }

        .esports-alert {
            background-color: rgba(255, 0, 0, 0.2);
            border: 1px solid rgba(255, 0, 0, 0.4);
            padding: 0.7rem;
            text-align: center;
            color: #ff4d4d;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="esports-card">
                 

                    @if (ViewBag.Error != null)
                    {
                        <div class="esports-alert">@ViewBag.Error</div>
                    }

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="esports-label">Email</label>
                            <input name="email" type="email" class="form-control esports-input" placeholder="Enter your email" required />
                        </div>
                        <div class="mb-4">
                            <label class="esports-label">Password</label>
                            <input name="password" type="password" class="form-control esports-input" placeholder="Enter your password" required />
                        </div>
                        <button type="submit" class="btn w-100 esports-button">
                            <i class="bi bi-box-arrow-in-right me-2"></i> ACCESS
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
