@model FootBallOne.Models.RegistrationManagement
@{
    ViewData["Title"] = "Player Dashboard";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Model.Name</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* --- Color Palette & Global Styles --- */
        :root {
            --primary-blue: #007bff;
            --secondary-green: #28a745;
            --accent-orange: #ffc107;
            --light-bg: #f8f9fa;
            --dark-text: #343a40;
            --card-bg: #ffffff;
            --gradient-start: #e0f7fa;
            --gradient-end: #cbf0f8;
            --shadow-light: rgba(0, 0, 0, 0.08);
            --shadow-medium: rgba(0, 0, 0, 0.12);
            --blue-hover: #0056b3;
            --success-light: #d4edda;
            --danger-light: #f8d7da;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(to bottom right, var(--gradient-start), var(--gradient-end));
            color: var(--dark-text);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 0;
            overflow-x: hidden;
        }

        /* --- Dashboard Container --- */
        .dashboard-container {
            max-width: 1200px;
            width: 100%;
            margin: auto;
            padding: 40px;
            background-color: rgba(255, 255, 255, 0.95);
            border-radius: 25px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            transition: transform 0.4s ease-out, box-shadow 0.4s ease-out;
            border: 1px solid rgba(255, 255, 255, 0.5);
        }

            .dashboard-container:hover {
                transform: translateY(-10px);
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25);
            }

        /* --- Headings --- */
        h2, h5 {
            font-weight: 700;
            color: var(--dark-text);
        }

        .welcome-greeting {
            color: var(--primary-blue);
            font-size: 2.8rem;
            margin-bottom: 2.5rem;
            letter-spacing: -1px;
            text-shadow: 2px 2px 5px rgba(0, 123, 255, 0.2);
            font-weight: 800;
        }

        /* --- Section Headings with Icons --- */
        .section-heading {
            display: flex;
            align-items: center;
            font-size: 1.6rem;
            margin-bottom: 25px;
            color: var(--dark-text);
            font-weight: 600;
            border-bottom: 2px solid var(--accent-orange);
            padding-bottom: 10px;
            margin-left: -5px;
            margin-right: -5px;
        }

            .section-heading i {
                font-size: 2rem;
                color: var(--accent-orange);
                margin-right: 15px;
                text-shadow: 1px 1px 3px rgba(0,0,0,0.1);
                animation: bounceIn 0.8s ease-out forwards;
                opacity: 0;
            }

            .section-heading[data-aos].aos-animate i {
                opacity: 1;
                animation: bounceIn 0.8s ease-out forwards;
            }

        @@keyframes bounceIn {
            0%

        {
            opacity: 0;
            transform: scale(0.3);
        }

        50% {
            opacity: 1;
            transform: scale(1.05);
        }

        70% {
            transform: scale(0.9);
        }

        100% {
            transform: scale(1);
        }

        }

        /* --- Card Styles --- */
        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 25px var(--shadow-light);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            background-color: var(--card-bg);
            padding: 25px;
            height: 100%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }

            .card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 8px;
                background: linear-gradient(to right, var(--primary-blue), var(--secondary-green));
                border-top-left-radius: 20px;
                border-top-right-radius: 20px;
            }

            .card:hover {
                transform: translateY(-8px);
                box-shadow: 0 18px 40px var(--shadow-medium);
            }

        /* --- Profile Image --- */
        .profile-image-container {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            overflow: hidden;
            margin: 0 auto 25px;
            border: 6px solid var(--primary-blue);
            box-shadow: 0 0 20px rgba(0, 123, 255, 0.5);
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            position: relative;
        }

            .profile-image-container::after {
                content: '\f4dc';
                font-family: "bootstrap-icons";
                position: absolute;
                bottom: 5px;
                right: 5px;
                background-color: var(--accent-orange);
                color: white;
                border-radius: 50%;
                padding: 8px;
                font-size: 1.2rem;
                display: flex;
                align-items: center;
                justify-content: center;
                transform: scale(0);
                opacity: 0;
                transition: transform 0.3s ease, opacity 0.3s ease;
            }

            .profile-image-container:hover {
                transform: scale(1.08) rotate(3deg);
                border-color: var(--accent-orange);
                box-shadow: 0 0 25px rgba(255, 193, 7, 0.7);
            }

                .profile-image-container:hover::after {
                    transform: scale(1);
                    opacity: 1;
                }

            .profile-image-container img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                filter: grayscale(0%);
                transition: filter 0.3s ease;
            }

        /* --- Info Items --- */
        .info-item {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
            font-size: 1.15rem;
            color: var(--dark-text);
            transition: color 0.2s ease, transform 0.2s ease;
            position: relative;
            padding-bottom: 5px;
        }

            .info-item::after {
                content: '';
                position: absolute;
                left: 0;
                bottom: 0;
                width: 0;
                height: 2px;
                background-color: var(--secondary-green);
                transition: width 0.3s ease-out;
            }

            .info-item:hover {
                color: var(--primary-blue);
                transform: translateX(5px);
            }

                .info-item:hover::after {
                    width: 100%;
                }

            .info-item i {
                color: var(--secondary-green);
                margin-right: 20px;
                font-size: 1.4rem;
                width: 30px;
                text-align: center;
                flex-shrink: 0;
                transition: transform 0.2s ease, color 0.2s ease;
            }

            .info-item:hover i {
                transform: scale(1.1);
                color: var(--primary-blue);
            }

            .info-item strong {
                color: var(--primary-blue);
                font-weight: 600;
                margin-right: 8px;
            }

        /* --- Badges --- */
        .badge {
            font-size: 1rem;
            padding: 9px 18px;
            border-radius: 25px;
            font-weight: 600;
            letter-spacing: 0.5px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .status-badge {
            padding: 8px 15px;
            border-radius: 20px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-width: 120px;
            justify-content: center;
            transition: all 0.3s ease;
        }

            .status-badge.bg-success {
                background-color: var(--secondary-green) !important;
                color: white;
                border: 1px solid var(--secondary-green);
            }

            .status-badge.bg-danger {
                background-color: #dc3545 !important;
                color: white;
                border: 1px solid #dc3545;
            }

            .status-badge:hover {
                transform: scale(1.05);
                box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            }

        /* --- Action Buttons --- */
        .action-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 25px;
            flex-wrap: wrap;
        }

        .action-btn {
            padding: 12px 30px;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            min-width: 150px;
            justify-content: center;
        }

            .action-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 6px 20px rgba(0,0,0,0.15);
            }

        .btn-cart {
            background: linear-gradient(135deg, var(--primary-blue), #0056b3);
            color: white;
        }

            .btn-cart:hover {
                background: linear-gradient(135deg, #0056b3, var(--primary-blue));
                color: white;
            }

        .btn-logout {
            background: linear-gradient(135deg, #dc3545, #c82333);
            color: white;
        }

            .btn-logout:hover {
                background: linear-gradient(135deg, #c82333, #dc3545);
                color: white;
            }

        .btn-shop {
            background: linear-gradient(135deg, var(--secondary-green), #218838);
            color: white;
        }

            .btn-shop:hover {
                background: linear-gradient(135deg, #218838, var(--secondary-green));
                color: white;
            }

        /* --- Floating Cart Button --- */
        .floating-cart {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--accent-orange), #e0a800);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            cursor: pointer;
            transition: all 0.3s ease;
            z-index: 1000;
            text-decoration: none;
            color: white;
        }

            .floating-cart:hover {
                transform: scale(1.1);
                box-shadow: 0 6px 25px rgba(0,0,0,0.3);
                color: white;
            }

            .floating-cart i {
                font-size: 1.5rem;
            }

        .cart-count {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #dc3545;
            color: white;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 700;
            border: 2px solid white;
        }

        /* --- Fees Table --- */
        .fees-table {
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 8px 20px var(--shadow-light);
            background-color: var(--card-bg);
        }

            .fees-table table {
                width: 100%;
                border-collapse: separate;
                border-spacing: 0 12px;
            }

            .fees-table th,
            .fees-table td {
                padding: 18px 25px;
                vertical-align: middle;
                border-bottom: none;
                font-size: 1.05rem;
            }

            .fees-table thead th {
                background-color: var(--primary-blue);
                color: white;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                border-top-left-radius: 15px;
                border-top-right-radius: 15px;
                position: sticky;
                top: 0;
                z-index: 1;
            }

            .fees-table tbody tr {
                background-color: var(--card-bg);
                transition: all 0.2s ease-in-out;
                box-shadow: 0 3px 8px rgba(0,0,0,0.05);
                border-radius: 10px;
            }

                .fees-table tbody tr:hover {
                    background-color: #e9f7fe;
                    transform: translateY(-3px);
                    box-shadow: 0 6px 15px rgba(0,0,0,0.1);
                }

            .fees-table .total-fees-row {
                background-color: var(--primary-blue);
                color: white;
                font-size: 1.3rem;
                font-weight: 700;
                border-bottom-left-radius: 15px;
                border-bottom-right-radius: 15px;
                box-shadow: 0 -5px 15px rgba(0, 123, 255, 0.3);
                position: sticky;
                bottom: 0;
                z-index: 1;
            }

                .fees-table .total-fees-row td {
                    padding-top: 25px;
                    padding-bottom: 25px;
                    border-bottom: none;
                }

        /* --- Horizontal Rule --- */
        .hr {
            border-top: 1px dashed rgba(0, 0, 0, 0.15);
            margin: 30px 0;
        }

        /* --- Responsive Adjustments --- */
        @@media (max-width: 991px) {
            .dashboard-container

        {
            padding: 30px;
        }

        .welcome-greeting {
            font-size: 2.2rem;
        }

        .section-heading {
            font-size: 1.4rem;
        }

            .section-heading i {
                font-size: 1.7rem;
            }

        .profile-image-container {
            width: 140px;
            height: 140px;
        }

        .info-item {
            font-size: 1.05rem;
        }

            .info-item i {
                font-size: 1.3rem;
            }

        .fees-table th,
        .fees-table td {
            padding: 15px 20px;
            font-size: 0.95rem;
        }

        }

        @@media (max-width: 767px) {
            body

        {
            padding: 20px 0;
        }

        .dashboard-container {
            padding: 20px;
            border-radius: 15px;
        }

        .welcome-greeting {
            font-size: 1.8rem;
            margin-bottom: 2rem;
        }

        .section-heading {
            font-size: 1.3rem;
            margin-bottom: 20px;
        }

            .section-heading i {
                font-size: 1.5rem;
            }

        .card {
            padding: 20px;
            border-radius: 15px;
        }

        .profile-image-container {
            width: 100px;
            height: 100px;
            margin-bottom: 15px;
            border-width: 4px;
        }

        .info-item {
            flex-direction: column;
            align-items: flex-start;
            font-size: 0.95rem;
            margin-bottom: 10px;
        }

            .info-item i {
                margin-bottom: 5px;
                margin-right: 0;
            }

        .fees-table th,
        .fees-table td {
            padding: 10px 15px;
            font-size: 0.85rem;
        }

        .fees-table .total-fees-row {
            font-size: 1.1rem;
        }

        .action-buttons {
            margin-top: 20px;
        }

        .action-btn {
            padding: 10px 20px;
            min-width: 120px;
            font-size: 0.9rem;
        }

        .floating-cart {
            width: 50px;
            height: 50px;
            bottom: 20px;
            right: 20px;
        }

        }
    </style>
</head>
<body>
    <div class="dashboard-container" data-aos="fade-up" data-aos-duration="1000">
        <h2 class="text-center welcome-greeting" data-aos="fade-down" data-aos-delay="200">
            👋 Welcome, @Model.Name
        </h2>

        <!-- ✅ ACTION BUTTONS -->
        <div class="action-buttons" data-aos="fade-down" data-aos-delay="250">
            <a href="/Cart" class="action-btn btn-cart">
                <i class="bi bi-cart-fill"></i>
                Shopping Cart
            </a>
            <a href="/Product" class="action-btn btn-shop">
                <i class="bi bi-shop"></i>
                Browse Products
            </a>
            <a href="/CC/Logout" class="action-btn btn-logout">
                <i class="bi bi-box-arrow-right"></i>
                Logout
            </a>
        </div>

        <div class="row g-4 mb-5 mt-4">
            <!-- Profile Section (Left Column) -->
            <div class="col-lg-5 col-md-6" data-aos="fade-right" data-aos-delay="300">
                <div class="card">
                    <div class="card-body text-center d-flex flex-column align-items-center flex-grow-1">
                        <div class="profile-image-container">
                            <img src="@Model.ImageFile" alt="Player Image" class="img-fluid"
                                 onerror="this.onerror=null;this.src='https://via.placeholder.com/160/007bff/ffffff?text=Player';">
                        </div>
                        <h4 class="card-title text-dark mb-2">@Model.Name</h4>
                        <p class="text-muted mb-4">Player ID: #@Model.Id</p>

                        <!-- Shopping buttons inside profile card -->
                        <div class="d-grid gap-2 w-100 px-3 mb-3">
                            <a href="/Cart" class="btn btn-primary">
                                <i class="bi bi-cart-fill"></i> View Shopping Cart
                            </a>
                            <a href="/Product" class="btn btn-outline-primary">
                                <i class="bi bi-shop"></i> Shop Now
                            </a>
                        </div>

                        <hr class="w-75 mx-auto my-4 hr" />
                        <div class="text-start w-100 px-3 flex-grow-1 d-flex flex-column justify-content-center">
                            <div class="info-item" data-aos="fade-left" data-aos-delay="400">
                                <i class="bi bi-envelope-fill"></i>
                                <div><strong>Email:</strong> <a href="mailto:@Model.Email" class="text-decoration-none text-dark">@Model.Email</a></div>
                            </div>
                            <div class="info-item" data-aos="fade-left" data-aos-delay="450">
                                <i class="bi bi-phone-fill"></i>
                                <div><strong>Phone No:</strong> <a href="tel:@Model.PhoneNo" class="text-decoration-none text-dark">@Model.PhoneNo</a></div>
                            </div>
                            <div class="info-item" data-aos="fade-left" data-aos-delay="500">
                                <i class="bi bi-geo-alt-fill"></i>
                                <div><strong>Address:</strong> @Model.Address, @Model.City</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Subscription Section (Right Column) -->
            <div class="col-lg-7 col-md-6" data-aos="fade-left" data-aos-delay="400">
                <div class="card">
                    <div class="card-body d-flex flex-column">
                        <h5 class="section-heading" data-aos="fade-left" data-aos-delay="500">
                            <i class="bi bi-calendar-check"></i> Subscription Details
                        </h5>
                        <div class="mb-4">
                            <div class="info-item" data-aos="fade-left" data-aos-delay="550">
                                <i class="bi bi-grid-fill"></i>
                                <div><strong>Category:</strong> <span class="badge bg-primary px-3 py-2">@Model.Category</span></div>
                            </div>
                            <div class="info-item" data-aos="fade-left" data-aos-delay="600">
                                <i class="bi bi-calendar-event-fill"></i>
                                <div><strong>Start Date:</strong> @(Model.SubscriptionStart?.ToShortDateString() ?? "N/A")</div>
                            </div>
                            <div class="info-item" data-aos="fade-left" data-aos-delay="650">
                                <i class="bi bi-calendar-x-fill"></i>
                                <div><strong>End Date:</strong> @(Model.SubscriptionEnd?.ToShortDateString() ?? "N/A")</div>
                            </div>
                        </div>

                        <hr class="my-4 hr" />

                        <h5 class="section-heading mt-4" data-aos="fade-left" data-aos-delay="700">
                            <i class="bi bi-cash-coin"></i> Payment Status
                        </h5>
                        <div class="info-item mb-4" data-aos="fade-left" data-aos-delay="750">
                            <i class="bi bi-credit-card-fill"></i>
                            <div>
                                <strong>Status:</strong>
                                @if (Model.PaymentStatus == "Paid")
                                {
                                    <span class="status-badge bg-success text-white">
                                        <i class="bi bi-check-circle-fill"></i> Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge bg-danger text-white">
                                        <i class="bi bi-x-circle-fill"></i> Not Paid
                                    </span>
                                }
                            </div>
                        </div>

                        <hr class="my-4 hr" />

                        <h5 class="section-heading mt-4" data-aos="fade-left" data-aos-delay="800">
                            <i class="bi bi-person-fill"></i> Coaching & Schedule
                        </h5>
                        <div class="info-item" data-aos="fade-left" data-aos-delay="850">
                            <i class="bi bi-person-circle"></i>
                            <div><strong>Coach:</strong> @Model.CoachName</div>
                        </div>
                        <div class="info-item" data-aos="fade-left" data-aos-delay="900">
                            <i class="bi bi-clock-fill"></i>
                            <div><strong>Working Hours:</strong> @Model.WorkingHours</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fees Breakdown Section -->
        <div class="card mt-5" data-aos="fade-up" data-aos-delay="1000">
            <div class="card-body p-4">
                <h5 class="section-heading text-center mb-4">
                    <i class="bi bi-wallet-fill"></i> Fees Breakdown
                </h5>
                <div class="table-responsive fees-table">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Fee Type</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr data-aos="fade-up" data-aos-delay="1100">
                                <td>Subscription Fees</td>
                                <td class="text-end">@(Model.SubscriptionFees?.ToString("C2") ?? "N/A")</td>
                            </tr>
                            <tr data-aos="fade-up" data-aos-delay="1150">
                                <td>Kit Fees</td>
                                <td class="text-end">@(Model.KitFees?.ToString("C2") ?? "N/A")</td>
                            </tr>
                            <tr data-aos="fade-up" data-aos-delay="1200">
                                <td>Sugar Fees</td>
                                <td class="text-end">@(Model.SugarFees?.ToString("C2") ?? "N/A")</td>
                            </tr>
                            <tr data-aos="fade-up" data-aos-delay="1250">
                                <td>Bag Fees</td>
                                <td class="text-end">@(Model.BagFees?.ToString("C2") ?? "N/A")</td>
                            </tr>
                            <tr class="total-fees-row" data-aos="fade-up" data-aos-delay="1300">
                                <td><strong>Total Fees</strong></td>
                                <td class="text-end"><strong>@Model.TotalFees.ToString("C2")</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ FLOATING CART BUTTON -->
    <a href="/Cart" class="floating-cart" title="Go to Shopping Cart">
        <i class="bi bi-cart-fill"></i>
        <span class="cart-count" id="cartCount" style="display: none;">0</span>
    </a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true,
            offset: 100
        });

        // Load cart item count
        fetch('/Cart/GetCartCount')
            .then(response => response.json())
            .then(data => {
                if (data.count > 0) {
                    document.getElementById('cartCount').textContent = data.count;
                    document.getElementById('cartCount').style.display = 'flex';
                }
            })
            .catch(err => console.log('Could not load cart count'));
    </script>
</body>
</html>