@model FootBallOne.Models.Login

@{
    ViewData["Title"] = "Create Account";
}
@{
    Layout = "_Layout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    body {
        background-color: #f8f9fa;
    }

    .form-panel {
        background-color: #fff;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    }

    .info-panel {
        background-color: #0f0f0f;
        color: #ffffff;
        padding: 40px;
        border-radius: 10px;
    }

    .form-control:focus {
        box-shadow: none;
        border-color: #007bff;
    }

    .form-title {
        font-weight: 600;
    }

    .text-small {
        font-size: 0.9rem;
        color: gray;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 d-flex shadow-lg rounded-4 overflow-hidden">
            <!-- Form Panel -->
            <div class="col-md-6 p-4 form-panel">
                <h3 class="form-title mb-3">Create Your Account</h3>
                <p class="text-small mb-4">Welcome back! Please enter your details</p>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>


                    <div class="mb-3">
                  @*       <label asp-for="Name" class="form-label"></label> *@
                        <input type="hidden" name="AcademyID" value="@ViewBag.AcademyID" />
                     @*    <span asp-validation-for="Name" class="text-danger"></span> *@
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Age" class="form-label">Age</label>
                        <input asp-for="Age" class="form-control" />
                        <span asp-validation-for="Age" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNo" class="form-label">Phone Number</label>
                        <input asp-for="PhoneNo" class="form-control" />
                        <span asp-validation-for="PhoneNo" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input type="checkbox" class="form-check-input" id="termsCheck">
                        <label class="form-check-label" for="termsCheck">I accepted all terms & conditions.</label>
                    </div>

                    <button type="submit" class="btn btn-dark w-100">Enter</button>

                    <p class="text-center mt-3">
                        Already have an account? <a href="/LOGIN/SignIn/" class="text-decoration-none">Sign in</a>
                    </p>
                </form>
            </div>

            <!-- Info Panel -->
            <div class="col-md-6 p-5 info-panel text-center d-flex flex-column justify-content-center">
                <h2 class="mb-3">Welcome To Football Academy</h2>
                <p>Join now and level up your game. Learn with the best coaches and teammates in town!</p>
                <img src="~/full-shot-man-playing-football.jpg" alt="Football Player" class="img-fluid rounded">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
