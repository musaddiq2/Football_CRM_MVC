@model List<FootBallOne.Models.AttendanceSummaryViewModel>
@{
    ViewData["Title"] = "Attendance Summary";
    Layout = "_Layout";
}

<div class="container mx-auto p-6">
    <h2 class="text-3xl font-bold mb-6 text-center">Attendance Summary</h2>
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 border">
            <thead class="bg-gray-100">
                <tr>
                    <th class="px-4 py-3 text-left text-sm font-semibold">Date</th>
                    <th class="px-4 py-3 text-left text-sm font-semibold">Total Records</th>
                    <th class="px-4 py-3 text-left text-sm font-semibold text-green-600">Total Present</th>
                    <th class="px-4 py-3 text-left text-sm font-semibold text-red-500">Total Absent</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="px-4 py-3">@item.Date.ToString("dd MMM yyyy")</td>
                        <td class="px-4 py-3">@item.TotalRecords</td>
                        <td class="px-4 py-3">@item.TotalPresent</td>
                        <td class="px-4 py-3">@item.TotalAbsent</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
