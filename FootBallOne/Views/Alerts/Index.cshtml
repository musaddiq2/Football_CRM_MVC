@model FootBallOne.Models.AlertsViewModel

@{
    ViewData["Title"] = "Player Alerts";
}
@{
    Layout = "_Layout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    .row-expired {
        background-color: #ffe5e5 !important;
    }

    .row-warning {
        background-color: #fff9db !important;
    }

        .row-expired:hover,
        .row-warning:hover {
            filter: brightness(0.98);
        }

    .toast.fade {
        transition: opacity 0.6s ease-in-out, transform 0.6s ease-in-out;
    }

    .toast.showing {
        opacity: 0;
        transform: translateY(-20px);
    }

    .toast.show {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<h2 class="text-primary mb-4">📢 Player Alerts Dashboard</h2>

<!-- Toast container -->
<div class="position-fixed top-0 end-0 p-3" style="z-index: 1100">
    <div id="toastSuccess" class="toast text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle-fill me-2"></i> <span id="toastMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<!-- Expired Subscriptions -->
<h4 class="text-warning">📅 Expired Subscriptions</h4>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Player</th>
            <th>Subscription End</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="expiredTableBody">
        @if (!Model.ExpiredSubscriptions.Any())
        {
            <tr>
                <td colspan="3" class="text-center text-muted">No expired subscriptions found.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model.ExpiredSubscriptions)
            {
                <tr class="row-expired">
                    <td>@item.Name</td>
                    <td>@(item.SubscriptionEnd?.ToString("dd/MM/yyyy") ?? "N/A")</td>

                    <td>
                        <a asp-controller="RegistrationManagements"
                           asp-action="Payment"
                           asp-route-playerId="@item.Id"
                           asp-route-playerName="@item.Name"
                           class="btn btn-sm btn-primary me-1"
                           title="Open payment page">
                            <i class="bi bi-cash me-1"></i> Pay Now
                        </a>

                        <button class="btn btn-success btn-sm ajax-pay" data-id="@item.Id" title="Extend by 1 month">
                            <i class="bi bi-clock me-1"></i> Pay 1 Month
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<hr class="my-5" />

<!-- Expiring Soon Subscriptions -->
<h4 class="text-info">⏳ Expiring Soon (within 7 days)</h4>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Player</th>
            <th>Subscription End</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="soonTableBody">
        @if (!Model.ExpiringSoonSubscriptions.Any())
        {
            <tr>
                <td colspan="3" class="text-center text-muted">No subscriptions expiring soon.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model.ExpiringSoonSubscriptions)
            {
                <tr class="row-warning">
                    <td>@item.Name</td>
                    <td>@(item.SubscriptionEnd?.ToString("dd/MM/yyyy") ?? "N/A")</td>

                    <td>
                        <a asp-controller="RegistrationManagements"
                           asp-action="Payment"
                           asp-route-playerId="@item.Id"
                           asp-route-playerName="@item.Name"
                           class="btn btn-sm btn-primary me-1"
                           title="Open payment page">
                            <i class="bi bi-cash me-1"></i> Pay Now
                        </a>

                        <button class="btn btn-success btn-sm ajax-pay" data-id="@item.Id" title="Extend by 1 month">
                            <i class="bi bi-clock me-1"></i> Pay 1 Month
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function showToast(message) {
            const toastEl = document.getElementById('toastSuccess');
            const toastMsg = document.getElementById('toastMessage');
            toastMsg.textContent = message;
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }

        // AJAX "Pay 1 Month" handler
        document.querySelectorAll('.ajax-pay').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.getAttribute('data-id');

                const response = await fetch('/Alerts/PayOneMonth', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: `id=${id}`
                });

                if (response.ok) {
                    showToast("Payment recorded. Subscription extended by 1 month!");

                    // Animate and remove row
                    const row = btn.closest("tr");
                    row.style.transition = "opacity 0.5s ease";
                    row.style.opacity = "0";
                    setTimeout(() => row.remove(), 500);
                } else {
                    showToast("❌ Error occurred during payment.");
                }
            });
        });

        // Enable tooltips
        document.querySelectorAll('[title]').forEach(el => {
            new bootstrap.Tooltip(el);
        });
    </script>
}
