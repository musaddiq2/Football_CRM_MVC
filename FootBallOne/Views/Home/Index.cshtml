<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mediano - Sports Academy Management Platform</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-purple: #6c5ce7;
            --dark-blue: #0a0e27;
            --light-purple: #a29bfe;
            --text-white: #ffffff;
            --text-gray: #b8b8c8;
            --overlay-dark: rgba(10, 14, 39, 0.92);
            --card-bg: rgba(25, 30, 60, 0.8);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--dark-blue);
            color: var(--text-white);
            overflow-x: hidden;
        }

        /* Hero Section */
        .hero-section {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .hero-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--overlay-dark) 0%, rgba(108, 92, 231, 0.3) 100%), url('https://images.unsplash.com/photo-1624526267942-ab0ff8a3e972?q=80&w=2070&auto=format&fit=crop') center/cover no-repeat;
            z-index: 0;
        }

            .hero-background::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: radial-gradient(circle at 20% 50%, rgba(108, 92, 231, 0.15) 0%, transparent 50%), radial-gradient(circle at 80% 80%, rgba(162, 155, 254, 0.1) 0%, transparent 50%);
            }

        /* Floating Particles */
        .particle {
            position: absolute;
            border-radius: 50%;
            background: rgba(162, 155, 254, 0.3);
        }

            .particle:nth-child(1) {
                width: 80px;
                height: 80px;
                top: 10%;
                left: 10%;
            }

            .particle:nth-child(2) {
                width: 60px;
                height: 60px;
                top: 60%;
                left: 80%;
            }

            .particle:nth-child(3) {
                width: 100px;
                height: 100px;
                top: 80%;
                left: 20%;
            }

            .particle:nth-child(4) {
                width: 40px;
                height: 40px;
                top: 30%;
                left: 70%;
            }

        /* Navigation Bar */
        .navbar-custom {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 1.5rem 0;
            background: rgba(10, 14, 39, 0.8);
            backdrop-filter: blur(20px);
            z-index: 1000;
            transition: all 0.3s ease;
            border-bottom: 1px solid rgba(162, 155, 254, 0.1);
        }

            .navbar-custom.scrolled {
                padding: 1rem 0;
                background: rgba(10, 14, 39, 0.95);
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            }

        .navbar-brand {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text-white) !important;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: transform 0.3s ease;
        }

            .navbar-brand:hover {
                transform: scale(1.05);
            }

        .brand-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--primary-purple), var(--light-purple));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nav-link {
            color: var(--text-gray) !important;
            margin: 0 1rem;
            font-weight: 500;
            position: relative;
            transition: color 0.3s ease;
        }

            .nav-link::after {
                content: '';
                position: absolute;
                bottom: -5px;
                left: 0;
                width: 0;
                height: 2px;
                background: var(--primary-purple);
                transition: width 0.3s ease;
            }

            .nav-link:hover {
                color: var(--text-white) !important;
            }

                .nav-link:hover::after {
                    width: 100%;
                }

        /* Dropdown Button Styling */
        .btn-control-panel {
            background: linear-gradient(135deg, var(--primary-purple), var(--light-purple));
            color: var(--text-white);
            padding: 0.8rem 2rem;
            border-radius: 50px;
            border: none;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(108, 92, 231, 0.4);
            position: relative;
            overflow: hidden;
        }

            .btn-control-panel::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
                transition: left 0.5s ease;
            }

            .btn-control-panel:hover::before {
                left: 100%;
            }

            .btn-control-panel:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 30px rgba(108, 92, 231, 0.6);
            }

        /* Custom Dropdown Menu */
        .dropdown-menu-custom {
            background-color: rgba(25, 30, 60, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(162, 155, 254, 0.3);
            border-radius: 15px;
            padding: 0.5rem 0;
            margin-top: 0.5rem;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
            min-width: 200px;
        }

        .dropdown-item-custom {
            color: var(--text-white);
            padding: 0.8rem 1.5rem;
            font-weight: 500;
            transition: all 0.3s ease;
            border-radius: 10px;
            margin: 0.2rem 0.5rem;
        }

            .dropdown-item-custom:hover {
                background: linear-gradient(135deg, var(--primary-purple), var(--light-purple));
                color: var(--text-white);
                transform: translateX(5px);
            }

        /* Hero Content */
        .hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            max-width: 1200px;
            padding: 0 2rem;
            opacity: 0;
            transform: translateY(50px);
            transition: opacity 1s ease, transform 1s ease;
        }

            .hero-content.visible {
                opacity: 1;
                transform: translateY(0);
            }

        .hero-title {
            font-size: 4.5rem;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 2rem;
            background: linear-gradient(135deg, var(--text-white), var(--light-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-subtitle {
            font-size: 1.3rem;
            color: var(--text-gray);
            margin-bottom: 3rem;
            line-height: 1.8;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }

        .hero-buttons {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-primary-custom {
            background: linear-gradient(135deg, var(--primary-purple), var(--light-purple));
            color: var(--text-white);
            padding: 1.2rem 3rem;
            border-radius: 50px;
            border: none;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            box-shadow: 0 10px 40px rgba(108, 92, 231, 0.4);
            position: relative;
            overflow: hidden;
        }

            .btn-primary-custom::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 0;
                height: 0;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.2);
                transform: translate(-50%, -50%);
                transition: width 0.6s ease, height 0.6s ease;
            }

            .btn-primary-custom:hover::before {
                width: 400px;
                height: 400px;
            }

            .btn-primary-custom:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 50px rgba(108, 92, 231, 0.6);
            }

        .btn-secondary-custom {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            color: var(--text-white);
            padding: 1.2rem 3rem;
            border-radius: 50px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

            .btn-secondary-custom:hover {
                background: rgba(255, 255, 255, 0.2);
                border-color: var(--primary-purple);
                transform: translateY(-5px);
                box-shadow: 0 10px 30px rgba(108, 92, 231, 0.3);
            }

        /* Floating Info Card */
        .floating-card {
            position: absolute;
            left: 5%;
            top: 50%;
            transform: translateY(-50%);
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            padding: 2rem;
            border-radius: 20px;
            border: 1px solid rgba(162, 155, 254, 0.2);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            z-index: 3;
            max-width: 300px;
        }

            .floating-card h3 {
                font-size: 1.3rem;
                margin-bottom: 1rem;
                color: var(--text-white);
            }

            .floating-card ul {
                list-style: none;
                padding: 0;
            }

            .floating-card li {
                padding: 0.5rem 0;
                color: var(--text-gray);
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

                .floating-card li::before {
                    content: '✓';
                    color: var(--primary-purple);
                    font-weight: bold;
                }

        /* Features Section */
        .features-section {
            padding: 8rem 0;
            background: linear-gradient(180deg, var(--dark-blue) 0%, rgba(25, 30, 60, 0.5) 100%);
            position: relative;
        }

        .section-title {
            text-align: center;
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, var(--text-white), var(--light-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .section-subtitle {
            text-align: center;
            font-size: 1.2rem;
            color: var(--text-gray);
            margin-bottom: 5rem;
        }

        .feature-card {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            padding: 3rem 2rem;
            border-radius: 20px;
            border: 1px solid rgba(162, 155, 254, 0.2);
            transition: all 0.4s ease;
            height: 100%;
            position: relative;
            overflow: hidden;
            opacity: 0;
            transform: translateY(50px);
        }

            .feature-card.animate-in {
                opacity: 1;
                transform: translateY(0);
            }

            .feature-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(135deg, rgba(108, 92, 231, 0.1), transparent);
                opacity: 0;
                transition: opacity 0.4s ease;
            }

            .feature-card:hover::before {
                opacity: 1;
            }

            .feature-card:hover {
                transform: translateY(-15px);
                box-shadow: 0 20px 60px rgba(108, 92, 231, 0.3);
                border-color: var(--primary-purple);
            }

        .feature-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--primary-purple), var(--light-purple));
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 2rem;
            font-size: 2rem;
            transition: transform 0.4s ease;
        }

        .feature-card:hover .feature-icon {
            transform: scale(1.1) rotate(5deg);
        }

        .feature-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--text-white);
        }

        .feature-description {
            color: var(--text-gray);
            line-height: 1.8;
        }

        /* Plans Section */
        .plans-section {
            padding: 8rem 0;
            background: var(--dark-blue);
        }

        .plan-card {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            padding: 3rem;
            border-radius: 20px;
            border: 1px solid rgba(162, 155, 254, 0.2);
            transition: all 0.4s ease;
            height: 100%;
            opacity: 0;
            transform: translateY(50px);
        }

            .plan-card.animate-in {
                opacity: 1;
                transform: translateY(0);
            }

            .plan-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 20px 60px rgba(108, 92, 231, 0.4);
                border-color: var(--primary-purple);
            }

        .plan-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--primary-purple), var(--light-purple));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            font-size: 1.5rem;
        }

        .plan-title {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: var(--text-white);
        }

        .plan-description {
            color: var(--text-gray);
            line-height: 1.8;
        }

        /* Custom Plan CTA */
        .custom-plan-card {
            background: linear-gradient(135deg, var(--primary-purple), var(--light-purple));
            padding: 4rem;
            border-radius: 20px;
            text-align: center;
            margin-top: 4rem;
        }

            .custom-plan-card h3 {
                font-size: 2rem;
                margin-bottom: 1rem;
            }

            .custom-plan-card p {
                font-size: 1.1rem;
                margin-bottom: 2rem;
                opacity: 0.9;
            }

        /* Footer */
        .footer {
            background: rgba(10, 14, 39, 0.95);
            padding: 4rem 0 2rem;
            border-top: 1px solid rgba(162, 155, 254, 0.1);
        }

        .footer-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            color: var(--text-white);
        }

        .footer-link {
            color: var(--text-gray);
            text-decoration: none;
            display: block;
            padding: 0.5rem 0;
            transition: color 0.3s ease, transform 0.3s ease;
        }

            .footer-link:hover {
                color: var(--primary-purple);
                transform: translateX(5px);
            }

        .social-icons a {
            color: var(--text-gray);
            font-size: 1.5rem;
            margin-right: 1rem;
            transition: all 0.3s ease;
        }

            .social-icons a:hover {
                color: var(--primary-purple);
                transform: translateY(-5px);
            }

        /* Responsive */
         {
            .hero-title

        {
            font-size: 3rem;
        }

        .floating-card {
            position: static;
            transform: none;
            margin: 2rem auto;
        }

        .section-title {
            font-size: 2.5rem;
        }

        }

         {
            .hero-title

        {
            font-size: 2.2rem;
        }

        .hero-subtitle {
            font-size: 1rem;
        }

        .hero-buttons {
            flex-direction: column;
        }

        .btn-primary-custom,
        .btn-secondary-custom {
            width: 100%;
        }

        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand" href="#">
                <div class="brand-icon">
                    <i class="bi bi-trophy-fill"></i>
                </div>
                Mediano
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="#">Prices</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">العربية</a>
                    </li>
                    <li class="nav-item dropdown">
                        <button class="btn btn-control-panel dropdown-toggle" type="button" id="controlPanelDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Access the control panel
                        </button>
                        <ul class="dropdown-menu dropdown-menu-custom dropdown-menu-end" aria-labelledby="controlPanelDropdown">
                            <li><a class="dropdown-item dropdown-item-custom" href="/Admin/Login"><i class="bi bi-unlock me-2"></i>Admin Login</a></li>
                            <li><a class="dropdown-item dropdown-item-custom" href="/Security/Index"><i class="bi bi-building-add me-2"></i>Create Academy</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-background">
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
        </div>

        <div class="floating-card d-none d-lg-block">
            <h3><i class="bi bi-people-fill me-2"></i>User Management</h3>
            <ul>
                <li>Multiple roles</li>
                <li>Advanced permissions</li>
                <li>Team collaboration</li>
                <li>Activity tracking</li>
            </ul>
        </div>

        <div class="hero-content">
            <h1 class="hero-title">Take your sports academy to new levels</h1>
            <p class="hero-subtitle">
                An integrated platform specifically designed for sports academies and training centers,
                enabling efficient management, seamless operations, and exceptional trainee experiences.
            </p>
            <div class="hero-buttons">
                <button class="btn btn-primary-custom">
                    <i class="bi bi-rocket-takeoff me-2"></i>Start your journey now
                </button>
                <button class="btn btn-secondary-custom">
                    <i class="bi bi-info-circle me-2"></i>Find out more
                </button>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section">
        <div class="container">
            <h2 class="section-title">Advanced tools for managing sports academies</h2>
            <p class="section-subtitle">Everything you need to manage your academy efficiently.</p>

            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                        <h3 class="feature-title">Analytics and Insights</h3>
                        <p class="feature-description">
                            Advanced analytics to track performance, attendance trends, and academy growth indicators.
                        </p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                        <h3 class="feature-title">Track attendance and absence</h3>
                        <p class="feature-description">
                            Instant tracking of attendance and absence of subscribers and staff with detailed reports and analysis.
                        </p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-people"></i>
                        </div>
                        <h3 class="feature-title">Training Course Management</h3>
                        <p class="feature-description">
                            Comprehensive course management with smart scheduling, curriculum tracking, and participant progress monitoring.
                        </p>
                    </div>
                </div>

                <div class="col-lg-6 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-credit-card"></i>
                        </div>
                        <h3 class="feature-title">Payment Management</h3>
                        <p class="feature-description">
                            Secure payment collection, subscription management, and comprehensive financial reporting.
                        </p>
                    </div>
                </div>

                <div class="col-lg-6 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-building"></i>
                        </div>
                        <h3 class="feature-title">Sports facilities reservation</h3>
                        <p class="feature-description">
                            Easy scheduling and management of all sports facilities, fields and equipment.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Plans Section -->
    <section class="plans-section">
        <div class="container">
            <h2 class="section-title">All plans include</h2>

            <div class="row g-4 mt-5">
                <div class="col-lg-3 col-md-6">
                    <div class="plan-card">
                        <div class="plan-icon">
                            <i class="bi bi-arrow-repeat"></i>
                        </div>
                        <h3 class="plan-title">Regular updates</h3>
                        <p class="plan-description">
                            Stay up to date with automatic updates and new features.
                        </p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="plan-card">
                        <div class="plan-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <h3 class="plan-title">Data security</h3>
                        <p class="plan-description">
                            Enterprise-level security with data encryption and regular backups.
                        </p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="plan-card">
                        <div class="plan-icon">
                            <i class="bi bi-cloud"></i>
                        </div>
                        <h3 class="plan-title">Cloud hosting</h3>
                        <p class="plan-description">
                            Secure and reliable cloud infrastructure with 99.9% availability guarantee.
                        </p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="plan-card">
                        <div class="plan-icon">
                            <i class="bi bi-headset"></i>
                        </div>
                        <h3 class="plan-title">24/7 technical support</h3>
                        <p class="plan-description">
                            Get help when you need it from our dedicated support team.
                        </p>
                    </div>
                </div>
            </div>

            <div class="custom-plan-card">
                <h3>Do you need a custom plan?</h3>
                <p>We can create a custom solution for your specific needs.</p>
                <p>Our team will work with you to design a plan that perfectly fits your academic requirements.</p>
                <button class="btn btn-secondary-custom">
                    <i class="bi bi-envelope me-2"></i>Contact us
                </button>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-6 mb-4">
                    <h5 class="footer-title">LEGAL AFFAIRS</h5>
                    <a href="#" class="footer-link">privacy policy</a>
                    <a href="#" class="footer-link">Terms and Conditions</a>
                </div>

                <div class="col-lg-3 col-md-6 mb-4">
                    <h5 class="footer-title">THE COMPANY</h5>
                    <a href="#" class="footer-link">About Mediano</a>
                    <a href="#" class="footer-link">Blog</a>
                    <a href="#" class="footer-link">Jobs</a>
                </div>

                <div class="col-lg-3 col-md-6 mb-4">
                    <h5 class="footer-title">TECHNICAL SUPPORT</h5>
                    <a href="#" class="footer-link">Prices</a>
                    <a href="#" class="footer-link">Documentation</a>
                    <a href="#" class="footer-link">Guidelines</a>
                    <a href="#" class="footer-link">System status</a>
                </div>

                <div class="col-lg-3 col-md-6 mb-4">
                    <h5 class="footer-title">OUR SOLUTIONS</h5>
                    <a href="#" class="footer-link">Training Course Management</a>
                    <a href="#" class="footer-link">Track attendance and absence</a>
                    <a href="#" class="footer-link">Sports facilities reservation</a>
                    <a href="#" class="footer-link">Reports and statistics</a>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-md-6">
                    <div class="navbar-brand mb-3">
                        <div class="brand-icon">
                            <i class="bi bi-trophy-fill"></i>
                        </div>
                        Mediano
                    </div>
                    <p style="color: var(--text-gray);">We transform sports management into a simple, efficient, and powerful experience.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="social-icons mb-3">
                        <a href="#"><i class="bi bi-snapchat"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-twitter"></i></a>
                    </div>
                </div>
            </div>

            <div class="row mt-4 pt-4" style="border-top: 1px solid rgba(162, 155, 254, 0.1);">
                <div class="col-12 text-center">
                    <p style="color: var(--text-gray); margin-bottom: 0;">&copy; 2025 Mediano. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Navbar scroll effect
        window.addEventListener('scroll', function() {
            const navbar = document.querySelector('.navbar-custom');
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Initialize hero content animation
        window.addEventListener('load', function() {
            const heroContent = document.querySelector('.hero-content');
            if (heroContent) {
                setTimeout(() => {
                    heroContent.classList.add('visible');
                }, 100);
            }
        });

        // Scroll Animation Observer with reset on scroll up
        const createScrollObserver = () => {
            const observerOptions = {
                threshold: 0.15,
                rootMargin: '0px 0px -50px 0px'
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        // Add animation class when element enters viewport
                        entry.target.classList.add('animate-in');
                    } else {
                        // Remove animation class when element leaves viewport (going up)
                        if (entry.boundingClientRect.top > 0) {
                            entry.target.classList.remove('animate-in');
                        }
                    }
                });
            }, observerOptions);

            return observer;
        };

        // Apply observer to feature cards
        const featureObserver = createScrollObserver();
        document.querySelectorAll('.feature-card').forEach((card, index) => {
            card.style.transitionDelay = `${index * 0.1}s`;
            featureObserver.observe(card);
        });

        // Apply observer to plan cards
        const planObserver = createScrollObserver();
        document.querySelectorAll('.plan-card').forEach((card, index) => {
            card.style.transitionDelay = `${index * 0.1}s`;
            planObserver.observe(card);
        });

        // Parallax effect for hero background
        let ticking = false;
        window.addEventListener('scroll', function() {
            if (!ticking) {
                window.requestAnimationFrame(function() {
                    const scrolled = window.pageYOffset;
                    const heroBackground = document.querySelector('.hero-background');
                    if (heroBackground) {
                        heroBackground.style.transform = `translateY(${scrolled * 0.5}px)`;
                    }
                    ticking = false;
                });
                ticking = true;
            }
        });

        // Animate particles with JavaScript instead of CSS keyframes
        function animateParticles() {
            const particles = document.querySelectorAll('.particle');
            particles.forEach((particle, index) => {
                let pos = 0;
                let direction = 1;
                let rotation = 0;
                const speed = 0.5 + (index * 0.2);
                const delay = index * 1000;

                setTimeout(() => {
                    setInterval(() => {
                        pos += direction * speed;
                        rotation += 2;

                        if (pos > 100 || pos < -100) {
                            direction *= -1;
                        }

                        const translateY = Math.sin(pos / 20) * 50;
                        const translateX = Math.cos(pos / 20) * 30;
                        const opacity = 0.3 + (Math.sin(pos / 50) * 0.3);

                        particle.style.transform = `translateY(${translateY}px) translateX(${translateX}px) rotate(${rotation}deg)`;
                        particle.style.opacity = opacity;
                    }, 50);
                }, delay);
            });
        }

        // Start particle animation
        animateParticles();

        // Animate hero background gradient
        function animateGradient() {
            const heroBackground = document.querySelector('.hero-background::before');
            let opacity = 0.5;
            let direction = 1;

            setInterval(() => {
                opacity += direction * 0.01;
                if (opacity >= 1 || opacity <= 0.5) {
                    direction *= -1;
                }
            }, 100);
        }

        // Animate brand icon rotation
        function animateBrandIcon() {
            const brandIcons = document.querySelectorAll('.brand-icon');
            brandIcons.forEach(icon => {
                let rotation = 0;
                setInterval(() => {
                    rotation += 1;
                    icon.style.transform = `rotateY(${rotation}deg)`;
                }, 30);
            });
        }

        animateBrandIcon();

        // Button ripple effect
        document.querySelectorAll('.btn-primary-custom, .btn-secondary-custom, .btn-control-panel').forEach(button => {
            button.addEventListener('click', function(e) {
                const ripple = document.createElement('span');
                const rect = this.getBoundingClientRect();
                const size = Math.max(rect.width, rect.height);
                const x = e.clientX - rect.left - size / 2;
                const y = e.clientY - rect.top - size / 2;

                ripple.style.width = ripple.style.height = size + 'px';
                ripple.style.left = x + 'px';
                ripple.style.top = y + 'px';
                ripple.style.position = 'absolute';
                ripple.style.borderRadius = '50%';
                ripple.style.background = 'rgba(255, 255, 255, 0.5)';
                ripple.style.transform = 'scale(0)';
                ripple.style.pointerEvents = 'none';

                // Animate ripple with JavaScript
                let scale = 0;
                const animate = () => {
                    scale += 0.1;
                    ripple.style.transform = `scale(${scale})`;
                    ripple.style.opacity = 1 - (scale / 4);

                    if (scale < 4) {
                        requestAnimationFrame(animate);
                    } else {
                        ripple.remove();
                    }
                };

                this.appendChild(ripple);
                animate();
            });
        });

        // Mouse move parallax effect on floating card
        const floatingCard = document.querySelector('.floating-card');
        if (floatingCard) {
            let currentX = 0;
            let currentY = 0;
            let targetX = 0;
            let targetY = 0;

            document.addEventListener('mousemove', (e) => {
                targetX = (e.clientX / window.innerWidth - 0.5) * 20;
                targetY = (e.clientY / window.innerHeight - 0.5) * 20;
            });

            function animateFloatingCard() {
                currentX += (targetX - currentX) * 0.1;
                currentY += (targetY - currentY) * 0.1;

                floatingCard.style.transform = `translateY(-50%) translateX(${currentX}px) translateY(${currentY}px)`;
                requestAnimationFrame(animateFloatingCard);
            }

            animateFloatingCard();
        }

        // Add glow effect to hero title
        function animateTitleGlow() {
            const heroTitle = document.querySelector('.hero-title');
            if (heroTitle) {
                let glowIntensity = 20;
                let direction = 1;

                setInterval(() => {
                    glowIntensity += direction * 2;
                    if (glowIntensity >= 40 || glowIntensity <= 20) {
                        direction *= -1;
                    }
                    heroTitle.style.filter = `drop-shadow(0 0 ${glowIntensity}px rgba(162, 155, 254, 0.5))`;
                }, 100);
            }
        }

        animateTitleGlow();

        // Navbar collapse on mobile after clicking link
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', function() {
                const navbarCollapse = document.getElementById('navbarNav');
                if (navbarCollapse && navbarCollapse.classList.contains('show')) {
                    const bsCollapse = new bootstrap.Collapse(navbarCollapse);
                    bsCollapse.hide();
                }
            });
        });
    </script>
</body>
</html>