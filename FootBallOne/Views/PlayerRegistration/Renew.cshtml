@model FootBallOne.Models.RegistrationManagement

@{
    ViewData["Title"] = "Renew Registration";
}

<h2>Renew Player Subscription</h2>

<form asp-action="Renew" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="SubscriptionEnd">New Subscription End Date</label>
        <input asp-for="SubscriptionEnd" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="PaymentStatus">Payment Status</label>
        <select asp-for="PaymentStatus" class="form-select">
            <option>Paid</option>
            <option>Unpaid</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Renew</button>
</form>