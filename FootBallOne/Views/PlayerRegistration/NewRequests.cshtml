@model IEnumerable<FootBallOne.Models.Login>

@{
    ViewData["Title"] = "New Player Requests";
}

<h2>New Player Registration Requests</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Age</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var player in Model)
        {
            <tr>
                <td>@player.Name</td>
                <td>@player.Age</td>
                <td>@player.Email</td>
                <td>@player.PhoneNo</td>
                <td>
                    <a asp-action="Accept" asp-route-id="@player.Id" class="btn btn-success btn-sm">Accept</a>
                    <a asp-action="Reject" asp-route-id="@player.Id" class="btn btn-danger btn-sm">Reject</a>
                </td>
            </tr>
        }
    </tbody>
</table>