@model FootBallOne.Models.EditLinkModel

@{
    ViewData["Title"] = "Edit Link";
    var linkId = ViewBag.LinkId;
    var currentImage = ViewBag.CurrentImage;
    var currentExpiration = ViewBag.CurrentExpiration;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .edit-container {
        max-width: 800px;
        margin: 30px auto;
        padding: 0 20px;
    }

    .card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .card-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 24px;
        border-bottom: none;
    }

    .card-title {
        font-size: 24px;
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .card-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 24px;
    }

    .form-label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 8px;
    }

    .required {
        color: #ef4444;
    }

    .form-control {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 14px;
        color: #111827;
        transition: all 0.2s;
        font-family: inherit;
    }

        .form-control:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

    textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    .help-text {
        font-size: 13px;
        color: #6b7280;
        margin-top: 6px;
        display: block;
    }

    .expiration-group {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .radio-btn {
        padding: 10px 20px;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        color: #374151;
        cursor: pointer;
        background: white;
        transition: all 0.2s;
    }

        .radio-btn:hover {
            border-color: #667eea;
            background: #f3f4f6;
        }

        .radio-btn.active {
            background: #667eea;
            color: white;
            border-color: #667eea;
        }

    .section-divider {
        margin: 32px 0;
        border-top: 2px solid #e5e7eb;
        padding-top: 24px;
    }

    .section-title {
        font-size: 16px;
        font-weight: 600;
        color: #111827;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .section-icon {
        font-size: 18px;
    }

    .image-upload-area {
        border: 2px dashed #d1d5db;
        border-radius: 8px;
        padding: 32px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s;
        background: #f9fafb;
    }

        .image-upload-area:hover {
            border-color: #667eea;
            background: #f3f4f6;
        }

        .image-upload-area.has-file {
            border-color: #667eea;
            background: #ede9fe;
        }

    .upload-icon {
        font-size: 48px;
        margin-bottom: 12px;
    }

    .upload-text {
        color: #374151;
        font-size: 15px;
        font-weight: 500;
    }

    .file-name {
        color: #667eea;
        font-size: 14px;
        margin-top: 12px;
        font-weight: 500;
    }

    .current-image-preview {
        margin-bottom: 20px;
        padding: 16px;
        background: #f9fafb;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
    }

    .current-image-label {
        font-size: 13px;
        font-weight: 600;
        color: #6b7280;
        margin-bottom: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .current-image-preview img {
        max-width: 100%;
        max-height: 250px;
        border-radius: 8px;
        border: 2px solid #e5e7eb;
        display: block;
        margin: 0 auto;
    }

    .alert-danger {
        padding: 16px;
        margin-bottom: 24px;
        background-color: #fee2e2;
        border: 2px solid #ef4444;
        border-radius: 8px;
        color: #991b1b;
    }

        .alert-danger strong {
            display: block;
            margin-bottom: 8px;
            font-size: 15px;
        }

        .alert-danger ul {
            margin: 8px 0 0 20px;
            padding: 0;
        }

        .alert-danger li {
            margin: 4px 0;
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 24px;
        border-top: 2px solid #e5e7eb;
        margin-top: 32px;
    }

    .btn {
        padding: 12px 28px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-cancel {
        background: white;
        color: #374151;
        border: 2px solid #d1d5db;
    }

        .btn-cancel:hover {
            background: #f9fafb;
            border-color: #9ca3af;
        }

    .btn-save {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        box-shadow: 0 4px 6px rgba(102, 126, 234, 0.3);
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(102, 126, 234, 0.4);
        }

    .text-danger {
        color: #ef4444;
        font-size: 13px;
        margin-top: 6px;
        display: block;
    }

    @@media (max-width: 768px) {
        .edit-container {
            padding: 0 15px;
        }

        .card-body {
            padding: 20px;
        }

        .expiration-group {
            gap: 8px;
        }

        .radio-btn {
            padding: 8px 16px;
            font-size: 13px;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="edit-container">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">
                <span>✏ Edit Invitation Link</span>
            </h2>
        </div>

        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@linkId" method="post" enctype="multipart/form-data" id="editForm">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-danger">
                        <strong>⚠ Please correct the following errors:</strong>
                        <ul>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <!-- Basic Information -->
                <div class="form-group">
                    <label class="form-label">Name <span class="required">*</span></label>
                    <input asp-for="Name" type="text" class="form-control" placeholder="Enter link name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" placeholder="Enter a brief description about this invitation link"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                    <small class="help-text">Optional: Provide context about this invitation link</small>
                </div>

                <div class="form-group">
                    <label class="form-label">Expiration Period <span class="required">*</span></label>
                    <input asp-for="ExpirationPeriod" type="hidden" value="@(Model.ExpirationPeriod ?? "1 Week")" />
                    <div class="expiration-group">
                        <button type="button" class="radio-btn @(currentExpiration == "1 Day" ? "active" : "")" data-value="1 Day">1 Day</button>
                        <button type="button" class="radio-btn @(currentExpiration == "3 Days" ? "active" : "")" data-value="3 Days">3 Days</button>
                        <button type="button" class="radio-btn @(currentExpiration == "1 Week" || string.IsNullOrEmpty(currentExpiration) ? "active" : "")" data-value="1 Week">1 Week</button>
                        <button type="button" class="radio-btn @(currentExpiration == "1 Month" ? "active" : "")" data-value="1 Month">1 Month</button>
                        <button type="button" class="radio-btn @(currentExpiration == "Custom" ? "active" : "")" data-value="Custom">Custom</button>
                    </div>
                    <span asp-validation-for="ExpirationPeriod" class="text-danger"></span>
                    <small class="help-text">Select when this invitation link should expire</small>
                </div>

                <!-- Sharing Options -->
                <div class="section-divider">
                    <h3 class="section-title">
                        <span class="section-icon">🔗</span>
                        Sharing Options
                    </h3>

                    <div class="form-group">
                        <label class="form-label">Share Title</label>
                        <input asp-for="ShareTitle" type="text" class="form-control" placeholder="Enter a title for sharing" />
                        <span asp-validation-for="ShareTitle" class="text-danger"></span>
                        <small class="help-text">This title will appear when the link is shared on social media</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Share Description</label>
                        <textarea asp-for="ShareDescription" class="form-control" placeholder="Enter a description for sharing"></textarea>
                        <span asp-validation-for="ShareDescription" class="text-danger"></span>
                        <small class="help-text">This description will appear when the link is shared</small>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Share Image</label>

                        @if (!string.IsNullOrEmpty(currentImage))
                        {
                            <div class="current-image-preview">
                                <div class="current-image-label">Current Image</div>
                                <img src="@currentImage" alt="Current Share Image" />
                            </div>
                        }

                        <div class="image-upload-area" id="uploadArea" onclick="document.getElementById('imageInput').click()">
                            <div class="upload-icon">📷</div>
                            <div class="upload-text">@(string.IsNullOrEmpty(currentImage) ? "Click to upload an image" : "Click to upload a new image")</div>
                            <div class="file-name" id="fileName" style="display: none;"></div>
                        </div>
                        <input type="file" name="Image" id="imageInput" accept="image/*" style="display: none;" />
                        <small class="help-text">
                            @(string.IsNullOrEmpty(currentImage) ? "Upload an image to be displayed when sharing (Optional)" : "Upload a new image to replace the current one (Optional)")
                        </small>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="form-actions">
                    <button type="button" class="btn btn-cancel" onclick="window.location.href='@Url.Action("List", "LinkInvitation")'">
                        ❌ Cancel
                    </button>
                    <button type="submit" class="btn btn-save" id="submitBtn">
                        ✅ Update Link
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function() {
            // Remove any validation for Image field
            if ($.validator && $.validator.unobtrusive) {
                $('input[name="Image"]').rules('remove');
            }
        });

        // Radio button functionality
        document.querySelectorAll('.radio-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.radio-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                document.querySelector('input[name="ExpirationPeriod"]').value = this.getAttribute('data-value');
            });
        });

        // Image upload handling
        document.getElementById('imageInput').addEventListener('change', function(e) {
            const uploadArea = document.getElementById('uploadArea');
            const fileName = document.getElementById('fileName');

            if (this.files && this.files[0]) {
                uploadArea.classList.add('has-file');
                fileName.textContent = '📎 ' + this.files[0].name;
                fileName.style.display = 'block';
            } else {
                uploadArea.classList.remove('has-file');
                fileName.style.display = 'none';
            }
        });
    </script>
}