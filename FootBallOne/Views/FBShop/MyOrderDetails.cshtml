    @model FootBallOne.Models.FBOrder
    @{
        ViewData["Title"] = "Order Details";
    }
<!-- Bootstrap 5 -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<!-- Font Awesome (for icons like fa-truck, fa-times, etc.) -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />

    <div class="container">
        <div class="row mb-4">
            <div class="col-md-6">
                <h2>📦 Order Details</h2>
            </div>
            <div class="col-md-6 text-right">
                <a asp-action="MyOrders" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to My Orders
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <!-- Order Information -->
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Order #@Model.OrderNumber</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Order Date:</strong> @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</p>
                                <p>
                                    <strong>Order Status:</strong>
                                    <span class="badge badge-@(Model.OrderStatus switch { "Pending" => "warning", "Confirmed" => "info", "Shipped" => "primary", "Delivered" => "success", "Cancelled" => "danger", _ => "secondary" })">
                                        @Model.OrderStatus
                                    </span>
                                </p>
                            </div>
                            <div class="col-md-6">
                                <p>
                                    <strong>Payment Status:</strong>
                                    <span class="badge badge-@(Model.PaymentStatus == "Paid" ? "success" : "warning")">
                                        @Model.PaymentStatus
                                    </span>
                                </p>
                                <p><strong>Payment Method:</strong> @Model.PaymentMethod</p>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.TrackingNumber))
                        {
                            <div class="alert alert-info mt-3">
                                <strong><i class="fas fa-truck"></i> Tracking Number:</strong> @Model.TrackingNumber
                            </div>
                        }
                    </div>
                </div>

                <!-- Order Items -->
                <div class="card mb-4">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">Order Items</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var item in Model.OrderItems)
                        {
                            var primaryImage = item.Product?.ProductImages?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? "/images/no-image.png";
                            <div class="row border-bottom py-3">
                                <div class="col-md-2">
                                    <img src="@primaryImage" class="img-fluid" style="max-height: 80px;" />
                                </div>
                                <div class="col-md-5">
                                    <h6>@item.ProductName</h6>
                                    <small class="text-muted">SKU: @item.SKU</small><br />
                                    @if (!string.IsNullOrEmpty(item.Size) || !string.IsNullOrEmpty(item.Color))
                                    {
                                        <small class="text-muted">@item.VariantInfo</small>
                                    }
                                </div>
                                <div class="col-md-2 text-center">
                                    <p class="mb-0">₹@item.UnitPrice.ToString("N2")</p>
                                    <small class="text-muted">Unit Price</small>
                                </div>
                                <div class="col-md-1 text-center">
                                    <p class="mb-0"><strong>x @item.Quantity</strong></p>
                                </div>
                                <div class="col-md-2 text-right">
                                    <p class="mb-0"><strong>₹@item.TotalPrice.ToString("N2")</strong></p>
                                </div>
                            </div>
                        }

                        <div class="row mt-3">
                            <div class="col-md-8"></div>
                            <div class="col-md-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Subtotal:</span>
                                    <strong>₹@Model.SubTotal.ToString("N2")</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Shipping:</span>
                                    <span>₹@Model.ShippingCost.ToString("N2")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Tax (GST):</span>
                                    <span>₹@Model.TaxAmount.ToString("N2")</span>
                                </div>
                                @if (Model.DiscountAmount > 0)
                                {
                                    <div class="d-flex justify-content-between mb-2 text-success">
                                        <span>Discount:</span>
                                        <span>-₹@Model.DiscountAmount.ToString("N2")</span>
                                    </div>
                                }
                                <hr />
                                <div class="d-flex justify-content-between">
                                    <strong>Total:</strong>
                                    <strong class="text-success h5">₹@Model.TotalAmount.ToString("N2")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Shipping Address -->
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Shipping Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Contact Name:</strong><br />@Model.ContactName</p>
                                <p><strong>Phone:</strong><br />@Model.ContactPhone</p>
                                <p><strong>Email:</strong><br />@Model.ContactEmail</p>
                            </div>
                            <div class="col-md-6">
                                <p>
                                    <strong>Shipping Address:</strong><br />
                                    @Model.ShippingAddress<br />
                                    @Model.ShippingCity, @Model.ShippingState<br />
                                    @Model.ShippingPostalCode<br />
                                    @Model.ShippingCountry
                                </p>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.OrderNotes))
                        {
                            <div class="alert alert-warning mt-3">
                                <strong>Order Notes:</strong><br />
                                @Model.OrderNotes
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Order Timeline -->
            <div class="col-md-4">
                <div class="card mb-4">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">Order Timeline</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled">
                            <li class="mb-3">
                                <i class="fas fa-circle text-primary"></i>
                                <strong>Order Placed</strong><br />
                                <small>@Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</small>
                            </li>

                            @if (Model.ShippedAt.HasValue)
                            {
                                <li class="mb-3">
                                    <i class="fas fa-circle text-info"></i>
                                    <strong>Shipped</strong><br />
                                    <small>@Model.ShippedAt.Value.ToString("dd MMM yyyy, hh:mm tt")</small>
                                </li>
                            }

                            @if (Model.DeliveredAt.HasValue)
                            {
                                <li class="mb-3">
                                    <i class="fas fa-circle text-success"></i>
                                    <strong>Delivered</strong><br />
                                    <small>@Model.DeliveredAt.Value.ToString("dd MMM yyyy, hh:mm tt")</small>
                                </li>
                            }

                            @if (Model.CancelledAt.HasValue)
                            {
                                <li class="mb-3">
                                    <i class="fas fa-circle text-danger"></i>
                                    <strong>Cancelled</strong><br />
                                    <small>@Model.CancelledAt.Value.ToString("dd MMM yyyy, hh:mm tt")</small>
                                    @if (!string.IsNullOrEmpty(Model.CancellationReason))
                                    {
                                        <br />
                            
                                        <small class="text-muted">Reason: @Model.CancellationReason</small>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                @if (Model.OrderStatus == "Pending")
                {
                    <div class="card border-danger">
                        <div class="card-body text-center">
                            <p class="text-muted">Need to cancel this order?</p>
                            <button type="button" class="btn btn-danger btn-block" data-toggle="modal" data-target="#cancelModal">
                                <i class="fas fa-times"></i> Cancel Order
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Cancel Order Modal -->
    @if (Model.OrderStatus == "Pending")
    {
        <div class="modal fade" id="cancelModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="CancelOrder" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title">Cancel Order</h5>
                            <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to cancel this order?</p>
                            <div class="form-group">
                                <label class="font-weight-bold">Reason for Cancellation:</label>
                                <textarea name="reason" class="form-control" rows="3" required placeholder="Please tell us why you're cancelling..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Keep Order</button>
                            <button type="submit" class="btn btn-danger">Cancel Order</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }