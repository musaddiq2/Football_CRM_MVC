@model FootBallOne.Models.FBOrder
@{
    ViewData["Title"] = "Order Confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="fas fa-check-circle text-success" style="font-size: 80px;"></i>
                    </div>
                    <h2 class="text-success mb-3">Order Placed Successfully!</h2>
                    <p class="lead">Thank you for your order. We'll process it shortly.</p>

                    <div class="alert alert-info mt-4">
                        <h5>Order Number: <strong>@Model.OrderNumber</strong></h5>
                        <p class="mb-0">Order Date: @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</p>
                    </div>

                    <div class="card mt-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Order Details</h5>
                        </div>
                        <div class="card-body text-left">
                            <div class="row mb-3">
                                <div class="col-6">
                                    <strong>Items:</strong>
                                </div>
                                <div class="col-6 text-right">
                                    @Model.OrderItems.Sum(oi => oi.Quantity) items
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-6">
                                    <strong>Total Amount:</strong>
                                </div>
                                <div class="col-6 text-right">
                                    <h4 class="text-success mb-0">₹@Model.TotalAmount.ToString("N2")</h4>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-6">
                                    <strong>Payment Method:</strong>
                                </div>
                                <div class="col-6 text-right">
                                    @Model.PaymentMethod
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-6">
                                    <strong>Shipping Address:</strong>
                                </div>
                                <div class="col-6 text-right">
                                    <small>
                                        @Model.ShippingAddress<br />
                                        @Model.ShippingCity, @Model.ShippingState<br />
                                        @Model.ShippingPostalCode
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Ordered Items</h5>
                        </div>
                        <div class="card-body">
                            @foreach (var item in Model.OrderItems)
                            {
                                var primaryImage = item.Product?.ProductImages?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? "/images/no-image.png";
                                <div class="row border-bottom py-2">
                                    <div class="col-2">
                                        <img src="@primaryImage" class="img-fluid" style="max-height: 60px;" />
                                    </div>
                                    <div class="col-6">
                                        <strong>@item.ProductName</strong><br />
                                        @if (!string.IsNullOrEmpty(item.Size) || !string.IsNullOrEmpty(item.Color))
                                        {
                                            <small class="text-muted">@item.VariantInfo</small>
                                        }
                                    </div>
                                    <div class="col-2 text-center">
                                        Qty: @item.Quantity
                                    </div>
                                    <div class="col-2 text-right">
                                        ₹@item.TotalPrice.ToString("N2")
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-4">
                        <a asp-action="MyOrderDetails" asp-route-id="@Model.OrderId" class="btn btn-primary btn-lg mr-2">
                            <i class="fas fa-eye"></i> View Order Details
                        </a>
                        <a asp-action="Index" class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-store"></i> Continue Shopping
                        </a>
                    </div>

                    <div class="alert alert-warning mt-4">
                        <i class="fas fa-info-circle"></i>
                        <strong>What's Next?</strong><br />
                        You'll receive an email confirmation shortly. Track your order status in "My Orders" section.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>