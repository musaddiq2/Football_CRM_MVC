@model FootBallOne.Models.Academy
@{
    ViewData["Title"] = "Academy Dashboard";
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Model.AcademyName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OerWCPHphzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f0f2f5 0%, #e0e6ed 100%); /* Soft background gradient */
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px; /* Add some padding around the content */
        }

        .dashboard-card {
            background-color: #ffffff;
            border-radius: 20px; /* More rounded corners */
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1); /* Soft, prominent shadow */
            padding: 40px;
            max-width: 700px; /* Max width for a clean look */
            width: 100%; /* Ensures responsiveness */
            text-align: center;
            position: relative; /* Needed for banner if added later */
            overflow: hidden; /* Ensures rounded corners apply to content */
            transition: transform 0.3s ease, box-shadow 0.3s ease; /* For subtle hover */
        }

        .dashboard-card:hover {
            transform: translateY(-5px); /* Subtle lift effect */
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15); /* Enhanced shadow on hover */
        }

        .greeting {
            font-size: 2.2rem;
            font-weight: bold;
            color: #0d6efd; /* Bootstrap primary blue */
            margin-bottom: 30px;
            position: relative;
            padding-bottom: 15px; /* Space for separator */
        }

        .greeting::after {
            content: '';
            position: absolute;
            left: 50%;
            bottom: 0;
            transform: translateX(-50%);
            width: 80px; /* Shorter separator */
            height: 4px;
            background-color: #6c757d; /* Muted color for separator */
            border-radius: 2px;
        }

        .detail-item {
            display: flex;
            align-items: center;
            justify-content: center; /* Center details */
            margin-bottom: 15px;
            font-size: 1.1rem;
            color: #343a40; /* Darker text for readability */
        }

        .detail-item strong {
            margin-right: 8px; /* Space between label and value */
            color: #212529; /* Even darker for labels */
        }

        .detail-item i {
            font-size: 1.3rem; /* Slightly larger icons */
            color: #6c757d; /* Muted icon color */
            margin-right: 12px;
            width: 30px; /* Fixed width for icon alignment */
            text-align: center;
        }

        /* Border separators between detail groups for better readability */
        .detail-group-separator {
            border-top: 1px solid #e9ecef;
            padding-top: 15px;
            margin-top: 15px;
            margin-bottom: 15px;
            width: 80%; /* Shorter separator */
            margin-left: auto;
            margin-right: auto;
        }

        /* Responsive adjustments */
       
    </style>
</head>
<body>
    <div class="dashboard-card" data-aos="zoom-in" data-aos-duration="1000">
        <h2 class="greeting">Welcome, @Model.AcademyName!</h2>

        <div class="row justify-content-center">
            <div class="col-12">
                <div class="detail-item" data-aos="fade-right" data-aos-delay="100">
                    <i class="bi bi-envelope-fill"></i>
                    <div><strong>Email:</strong> @Model.Email</div>
                </div>
                <div class="detail-item" data-aos="fade-right" data-aos-delay="150">
                    <i class="bi bi-building"></i>
                    <div><strong>Company Code:</strong> @Model.CompanyCode</div>
                </div>

                <div class="detail-group-separator" data-aos="fade-up" data-aos-delay="200"></div>

                <div class="detail-item" data-aos="fade-right" data-aos-delay="250">
                    <i class="bi bi-geo-alt-fill"></i>
                    <div><strong>Location:</strong> @Model.Location</div>
                </div>
                <div class="detail-item" data-aos="fade-right" data-aos-delay="300">
                    <i class="bi bi-person-badge-fill"></i>
                    <div><strong>Head Coach:</strong> @Model.HeadCoach</div>
                </div>
                <div class="detail-item" data-aos="fade-right" data-aos-delay="350">
                    <i class="bi bi-people-fill"></i>
                    <div><strong>Capacity:</strong> @Model.Capacity Players</div>
                </div>

                <div class="detail-group-separator" data-aos="fade-up" data-aos-delay="400"></div>

                <div class="detail-item" data-aos="fade-right" data-aos-delay="450">
                    <i class="bi bi-telephone-fill"></i>
                    <div><strong>Contact No:</strong> @Model.ContactNo</div>
                </div>
                <div class="detail-item" data-aos="fade-right" data-aos-delay="500">
                    <i class="bi bi-house-fill"></i>
                    <div><strong>Academy Address:</strong> @Model.AcademyAddress</div>
                </div>
                <a href="/RegistrationManagements/Create" class="btn btn-dark w-100 py-2">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Login
                </a>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 1000, // Animation duration
            once: true // Whether animation should happen only once - while scrolling down
        });
    </script>
</body>
</html>