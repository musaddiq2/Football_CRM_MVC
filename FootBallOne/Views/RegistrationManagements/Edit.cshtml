@model FootBallOne.Models.RegistrationManagement

@{
    ViewData["Title"] = "Edit Player";
    Layout = "_Layout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<style>
    body {
        background: linear-gradient(135deg, #f2f4f8 0%, #e0e6f0 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 100vh;
    }

    .edit-card {
        max-width: 900px;
        margin: 60px auto;
        background: #ffffff;
        border-radius: 20px;
        padding: 45px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(13, 110, 253, 0.1);
    }

    h1 {
        font-weight: 700;
        color: #0d6efd;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 2rem;
        margin-bottom: 1.5rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #343a40;
        margin-bottom: 0.5rem;
    }

    .form-control, .form-select {
        border-radius: 12px;
        border: 1px solid #ced4da;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }

    .btn {
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

        .btn i {
            margin-right: 8px;
        }

    .btn-primary {
        background-color: #0d6efd;
        border: none;
    }

        .btn-primary:hover {
            background-color: #0b5ed7;
            transform: translateY(-2px);
        }

    .btn-success {
        background-color: #198754;
        border: none;
    }

        .btn-success:hover {
            background-color: #157347;
            transform: translateY(-2px);
        }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #5c636a;
            transform: translateY(-2px);
        }

    hr {
        border-top: 2px solid #e9ecef;
        margin: 1.5rem 0;
    }

    .toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 1080;
    }

    .toast {
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }
</style>

<div class="edit-card">
    <h1><i class="bi bi-pencil-square"></i> Edit Player</h1>
    <hr />

    <form asp-action="Edit" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="AcademyID" class="form-label"></label>
                    <input asp-for="AcademyID" class="form-control" readonly />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="PhoneNo" class="form-label"></label>
                    <input asp-for="PhoneNo" class="form-control" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Category" class="form-label"><i class="bi bi-tags-fill"></i> Category</label>
                    <select asp-for="Category" class="form-select" id="categoryDropdown">
                        <option value="">-- Select Category --</option>
                        <option value="Under-12">Under-12</option>
                        <option value="Under-14">Under-14</option>
                        <option value="Under-16">Under-16</option>
                        <option value="Under-18">Under-18</option>
                        <option value="Senior">Senior</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="SubscriptionStart" class="form-label"></label>
                    <input asp-for="SubscriptionStart" type="date" class="form-control" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="SubscriptionEnd" class="form-label"></label>
                    <input asp-for="SubscriptionEnd" type="date" class="form-control" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label asp-for="SubscriptionFees" class="form-label"></label>
                    <input asp-for="SubscriptionFees" class="form-control" id="subscriptionFees" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label asp-for="KitFees" class="form-label"></label>
                    <input asp-for="KitFees" class="form-control" id="kitFees" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label asp-for="SugarFees" class="form-label"></label>
                    <input asp-for="SugarFees" class="form-control" id="sugarFees" />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label asp-for="BagFees" class="form-label"></label>
                    <input asp-for="BagFees" class="form-control" id="bagFees" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="TotalFees" class="form-label"></label>
                    <input asp-for="TotalFees" class="form-control" id="totalFees" readonly />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Ground" class="form-label"></label>
                    <select asp-for="Ground" class="form-select">
                        <option value="">-- Select Ground --</option>
                        <option value="Turf 1">Turf 1</option>
                        <option value="Turf 2">Turf 2</option>
                        <option value="Turf 3">Turf 3</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="TimeSlot" class="form-label"></label>
                    <select asp-for="TimeSlot" class="form-select">
                        <option value="">-- Select Time Slot --</option>
                        <option value="Morning">Morning</option>
                        <option value="Evening">Evening</option>
                        <option value="Night">Night</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="BirthDate" class="form-label"></label>
                    <input asp-for="BirthDate" type="date" class="form-control" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label class="form-label">Upload New Image (Optional)</label>
                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.ImageFile))
                    {
                        <small class="text-muted">Current: @Model.ImageFile</small>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="CoachName" class="form-label">
                        <i class="bi bi-person-circle"></i> Coach Name
                    </label>
                    <input asp-for="CoachName" class="form-control" placeholder="Enter coach name" />
                    <span asp-validation-for="CoachName" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="WorkingHours" class="form-label"><i class="bi bi-clock-fill"></i> Working Hours</label>
                    <select asp-for="WorkingHours" class="form-select">
                        <option value="">-- Select Working Time --</option>
                        <option value="1 To 3">1 To 3</option>
                        <option value="3 To 6">3 To 6</option>
                        <option value="6 To 9">6 To 9</option>
                        <option value="9 To 12">9 To 12</option>
                    </select>
                    <span asp-validation-for="WorkingHours" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="PaymentStatus" class="form-label"><i class="bi bi-credit-card"></i> Payment Status</label>
                    <select asp-for="PaymentStatus" class="form-select" id="paymentStatusDropdown">
                        <option value="">-- Select Payment Status --</option>
                        <option value="Paid">Paid</option>
                        <option value="Not Paid">Not Paid</option>
                    </select>
                    <span asp-validation-for="PaymentStatus" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="CreatedDate" class="form-label"></label>
                    <input asp-for="CreatedDate" type="date" class="form-control" readonly />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="LastUpdated" class="form-label"></label>
                    <input asp-for="LastUpdated" type="datetime-local" class="form-control" readonly />
                </div>
            </div>
        </div>

        <div class="form-group text-end">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-success">
                <i class="bi bi-eye"></i> View
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Save Changes
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </form>
</div>

@if (TempData["Updated"] != null)
{
    <div class="toast-container">
        <div class="toast align-items-center text-white bg-success border-0 show">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle-fill"></i> @TempData["Updated"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
}

@if (TempData["ModelErrors"] != null)
{
    <div class="toast-container">
        <div class="toast align-items-center text-white bg-danger border-0 show">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ModelErrors"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // FIX: Force set Category dropdown value
        var categorySelect = document.getElementById('categoryDropdown');
        var categoryValue = '@Html.Raw(Model.Category)';

        if (categoryValue && categorySelect) {
            categoryValue = categoryValue.trim();
            console.log('Setting category to:', categoryValue); // Debug log

            for (var i = 0; i < categorySelect.options.length; i++) {
                if (categorySelect.options[i].value === categoryValue) {
                    categorySelect.selectedIndex = i;
                    console.log('Category set successfully'); // Debug log
                    break;
                }
            }
        }

        // FIX: Force set PaymentStatus dropdown value
        var paymentSelect = document.getElementById('paymentStatusDropdown');
        var paymentValue = '@Html.Raw(Model.PaymentStatus)';

        if (paymentValue && paymentSelect) {
            paymentValue = paymentValue.trim();
            console.log('Setting payment status to:', paymentValue); // Debug log

            for (var i = 0; i < paymentSelect.options.length; i++) {
                if (paymentSelect.options[i].value === paymentValue) {
                    paymentSelect.selectedIndex = i;
                    console.log('Payment status set successfully'); // Debug log
                    break;
                }
            }
        }

        // Auto-calculate Total Fees
        function calculateTotal() {
            var subscription = parseFloat(document.getElementById('subscriptionFees').value) || 0;
            var kit = parseFloat(document.getElementById('kitFees').value) || 0;
            var sugar = parseFloat(document.getElementById('sugarFees').value) || 0;
            var bag = parseFloat(document.getElementById('bagFees').value) || 0;

            var total = subscription + kit + sugar + bag;
            document.getElementById('totalFees').value = total.toFixed(2);
        }

        // Attach event listeners to fee inputs
        ['subscriptionFees', 'kitFees', 'sugarFees', 'bagFees'].forEach(function(id) {
            var input = document.getElementById(id);
            if (input) {
                input.addEventListener('input', calculateTotal);
                input.addEventListener('change', calculateTotal);
            }
        });

        // Calculate total on page load
        calculateTotal();
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}