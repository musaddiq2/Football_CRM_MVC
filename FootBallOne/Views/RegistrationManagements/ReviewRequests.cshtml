@model List<PlayerRequest>
@{
    // Layout = "_Layout";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Player Registration Requests</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons CSS (for potential future use or consistency) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background-color: #001f3f; /* Dark blue background */
            display: flex;
            justify-content: center;
            align-items: flex-start; /* Align to top, not center, for longer tables */
            min-height: 100vh;
            padding: 30px 20px; /* Add padding for overall spacing */
        }

        .table-container {
            background-color: #fff;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
            max-width: 1000px; /* Max width for the table card */
            width: 100%;
            margin-top: 20px; /* Space from top if not perfectly centered */
        }

        .table {
            margin-bottom: 0; /* Remove default table margin-bottom */
        }

            .table thead th {
                background-color: #001f3f; /* Dark blue header background */
                color: #fff; /* White text for headers */
                border-bottom: none; /* Remove default border */
                padding: 15px;
                vertical-align: middle;
            }

            .table tbody tr {
                transition: background-color 0.2s ease;
            }

                .table tbody tr:hover {
                    background-color: #f8f9fa; /* Light hover effect */
                }

            .table tbody td {
                padding: 15px;
                vertical-align: middle;
                border-top: 1px solid #dee2e6; /* Light border between rows */
            }

            .table tbody tr:last-child td {
                border-bottom: none; /* No border for the last row */
            }
        /* Rounded corners for the table itself */
        .table-responsive {
            border-radius: 10px; /* Slightly less rounded than card for visual hierarchy */
            overflow: hidden; /* Ensures content respects border-radius */
            border: 1px solid rgba(0, 0, 0, 0.1); /* Subtle border for the table */
        }

        /* Button styling */
        .btn {
            border-radius: 8px; /* Rounded corners for buttons */
            padding: 8px 15px;
            font-weight: 500;
            transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
        }

        .btn-success {
            background-color: #28a745; /* Green */
            border-color: #28a745;
        }

            .btn-success:hover {
                background-color: #218838;
                border-color: #1e7e34;
                transform: translateY(-2px); /* Slight lift on hover */
            }

        .btn-danger {
            background-color: #dc3545; /* Red */
            border-color: #dc3545;
        }

            .btn-danger:hover {
                background-color: #c82333;
                border-color: #bd2130;
                transform: translateY(-2px); /* Slight lift on hover */
            }
        /* Spacing between action buttons */
        .table td .btn + .btn {
            margin-left: 8px;
        }

        /* Responsive adjustments for smaller screens */
        (max-width: 768px) {
            .table-container

        {
            padding: 25px;
        }

        .table thead th, .table tbody td {
            padding: 12px;
            font-size: 0.9rem;
        }

        .btn {
            padding: 6px 12px;
            font-size: 0.85rem;
        }

        }
    </style>
</head>
<body>
    <div class="table-container">
        <h2 class="text-center mb-4 text-dark">Player Registration Requests</h2>
        <!-- Use table-responsive for horizontal scrolling on small screens -->
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>
                        <th>Phone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model)
                    {
                        <tr>
                            <td>@req.Name</td>
                            <td>@req.Email</td>
                            <td>@req.PhoneNo</td>
                            <td>
                                <a asp-action="AcceptRequest" asp-route-id="@req.Id" class="btn btn-success">Accept</a>
                                <a asp-action="RejectRequest" asp-route-id="@req.Id" class="btn btn-danger">Reject</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Bootstrap 5 JS (optional, for some Bootstrap components, not strictly needed for this table) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
