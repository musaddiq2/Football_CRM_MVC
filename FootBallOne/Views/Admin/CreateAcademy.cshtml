@model FootBallOne.Models.FootballAcademy

@{
    ViewData["Title"] = "Create New Academy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card p-4" style="max-width: 100%; overflow-x: hidden;">
        <h2 class="mb-4">Create New Academy</h2>
        @if (Context.Session.GetString("UserRole") != "SuperAdmin")
        {
            <div class="alert alert-danger">
                Access Denied: Only Super Admins can create academies.
            </div>
            <a asp-action="Index" asp-controller="Dashboard" class="btn btn-secondary mt-3">Back to Dashboard</a>
        }
        else
        {
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <form asp-action="CreateAcademy" asp-controller="Admin" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label for="AcademyName" class="form-label">Academy Name</label>
                    <input type="text" class="form-control" id="AcademyName" asp-for="AcademyName" required />
                    <span asp-validation-for="AcademyName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="Location" class="form-label">Location</label>
                    <input type="text" class="form-control" id="Location" asp-for="Location" required />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="CompanyCode" class="form-label">Company Code</label>
                    <input type="text" class="form-control" id="CompanyCode" asp-for="CompanyCode" />
                    <span asp-validation-for="CompanyCode" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="HeadCoach" class="form-label">Head Coach</label>
                    <input type="text" class="form-control" id="HeadCoach" asp-for="HeadCoach" />
                    <span asp-validation-for="HeadCoach" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="Capacity" class="form-label">Capacity</label>
                    <input type="number" class="form-control" id="Capacity" asp-for="Capacity" min="1" />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="ContactNo" class="form-label">Contact Number</label>
                    <input type="text" class="form-control" id="ContactNo" asp-for="ContactNo" />
                    <span asp-validation-for="ContactNo" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="AcademyAddress" class="form-label">Academy Address</label>
                    <textarea class="form-control" id="AcademyAddress" asp-for="AcademyAddress" rows="4"></textarea>
                    <span asp-validation-for="AcademyAddress" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="Email" class="form-label">Manager Email</label>
                    <input type="email" class="form-control" id="Email" asp-for="Email" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label for="Password" class="form-label">Manager Password</label>
                    <input type="password" class="form-control" id="Password" asp-for="Password" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create Academy</button>
                    <a asp-action="Index" asp-controller="Admin" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}