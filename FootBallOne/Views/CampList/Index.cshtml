@model IEnumerable<FootBallOne.Models.Camp>

@{
    ViewData["Title"] = "Camp List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <!-- Header + Add Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">
            <i class="bi bi-people-fill me-2"></i>Camp List
        </h2>
        <a asp-controller="Calendar" asp-action="CreateCamp" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add New Camp
        </a>
    </div>

    <!-- Success Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Card Table Container -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle mb-0">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>Camp Name</th>
                            <th>Branch</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Ticket Price</th>
                            <th>Status</th>
                            <th style="width: 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var camp in Model)
                        {
                            <tr class="text-center">
                                <td class="text-start">@camp.CampName</td>
                                <td>@camp.Branch</td>
                                <td>@camp.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@camp.EndDate.ToString("dd MMM yyyy")</td>
                                <td><span class="fw-semibold text-success">₹@camp.TicketPrice</span></td>
                                <td>
                                    @if (camp.IsActive)
                                    {
                                        <span class="badge bg-success px-3 py-2">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@camp.CampID" class="btn btn-outline-primary">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@camp.CampID" class="btn btn-outline-warning">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@camp.CampID"
                                           class="btn btn-outline-danger"
                                           onclick="return confirm('Are you sure you want to delete this camp?');">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="text-muted small text-end mt-3">
        Showing @Model.Count() camp(s)
    </div>
</div>
<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }

    .table td, .table th {
        vertical-align: middle;
    }

    .badge {
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .btn-group .btn {
        transition: 0.2s ease-in-out;
    }

</style>