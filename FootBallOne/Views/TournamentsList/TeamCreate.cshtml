@model FootBallOne.ViewModel.TeamViewModel
@{
    ViewData["Title"] = "Create Team";
    var returnTab = ViewBag.ReturnTab ?? "teams";
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .create-team-container {
        background-color: #fff;
        padding: 20px;
        border-radius: 8px;
    }

    .breadcrumb-nav {
        font-size: 13px;
        color: #666;
        margin-bottom: 10px;
    }

        .breadcrumb-nav a {
            color: #666;
            text-decoration: none;
        }

            .breadcrumb-nav a:hover {
                text-decoration: underline;
            }

    .page-title {
        font-size: 24px;
        font-weight: 600;
        margin-bottom: 25px;
        color: #000;
    }

    .section-title {
        font-size: 14px;
        font-weight: 600;
        padding: 15px 20px;
        background-color: #fafafa;
        border-bottom: 1px solid #e0e0e0;
        margin: 0 -20px 20px -20px;
    }

    .form-row {
        display: flex;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-group {
        flex: 1;
        margin-bottom: 0;
    }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 8px;
            color: #333;
        }

            .form-group label .required {
                color: #dc3545;
                margin-left: 2px;
            }

    .form-control, .form-select {
        width: 100%;
        padding: 8px 12px;
        font-size: 14px;
        border: 1px solid #d1d5db;
        border-radius: 4px;
        background-color: #fff;
        transition: border-color 0.15s ease-in-out;
    }

        .form-control:focus, .form-select:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .form-control:disabled, .form-select:disabled {
            background-color: #f3f4f6;
            cursor: not-allowed;
        }

    .add-media-btn {
        display: inline-block;
        padding: 8px 16px;
        background-color: #fff;
        border: 1px solid #10b981;
        color: #10b981;
        font-size: 13px;
        font-weight: 500;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .add-media-btn:hover {
            background-color: #f0fdf4;
        }

        .add-media-btn.file-selected {
            background-color: #10b981;
            color: #fff;
            border-color: #10b981;
        }

    .file-name-display {
        display: inline-block;
        margin-left: 10px;
        font-size: 13px;
        color: #059669;
        font-weight: 500;
    }

    .form-control[type="file"] {
        display: none;
    }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e0e0e0;
    }

    .btn {
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 500;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-cancel {
        background-color: #fff;
        border: 1px solid #d1d5db;
        color: #374151;
    }

        .btn-cancel:hover {
            background-color: #f9fafb;
        }

    .btn-create-another {
        background-color: #fff;
        border: 1px solid #d1d5db;
        color: #374151;
    }

        .btn-create-another:hover {
            background-color: #f9fafb;
        }

    .btn-primary {
        background-color: #10b981;
        color: #fff;
        border: none;
    }

        .btn-primary:hover {
            background-color: #059669;
        }

    .fab-button {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 56px;
        height: 56px;
        background-color: #10b981;
        color: #fff;
        border: none;
        border-radius: 50%;
        font-size: 24px;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .fab-button:hover {
            background-color: #059669;
            box-shadow: 0 6px 16px rgba(16, 185, 129, 0.5);
        }

    .text-danger {
        color: #dc3545;
        font-size: 12px;
        margin-top: 4px;
        display: block;
    }

    .select-wrapper {
        position: relative;
    }

        .select-wrapper::after {
            content: "▼";
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
            font-size: 10px;
            color: #6b7280;
        }
</style>

<div class="create-team-container">
    <div class="breadcrumb-nav">
        <a href="#">Competitions and Teams Management</a> >
        <a href="#">Teams</a> >
        <span>Create</span>
    </div>

    <h1 class="page-title">Create Team</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <form asp-action="TeamCreate" asp-controller="TournamentsList" method="post" enctype="multipart/form-data">
        <input type="hidden" name="tab" value="@returnTab" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="section-title">Team Information</div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="TrainingActivity">
                    Training Activity
                </label>
                <input asp-for="TrainingActivity" class="form-control" placeholder="" />
                <span asp-validation-for="TrainingActivity" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Branch">
                    Branch<span class="required">*</span>
                </label>
                <input asp-for="Branch" class="form-control" value="" />
                <span asp-validation-for="Branch" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="TeamName">
                    Team Name<span class="required">*</span>
                </label>
                <input asp-for="TeamName" class="form-control" />
                <span asp-validation-for="TeamName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TeamLogo">
                    Team Logo
                </label>
                <input asp-for="TeamLogo" type="file" id="teamLogoInput" class="form-control" accept="image/*" onchange="handleFileSelect(this)" />
                <label for="teamLogoInput" class="add-media-btn" id="mediaBtn">Add media</label>
                <span class="file-name-display" id="fileName" style="display: none;"></span>
                <span asp-validation-for="TeamLogo" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Stadium">
                    Stadium
                </label>
                <input asp-for="Stadium" class="form-control" placeholder="" />
                <span asp-validation-for="Stadium" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Coach">
                    Coach
                </label>
                <input asp-for="Coach" class="form-control" placeholder="" />
                <span asp-validation-for="Coach" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Status">
                    Status<span class="required">*</span>
                </label>
                <div class="select-wrapper">
                    <select asp-for="Status" class="form-select">
                        <option value="">Select an option</option>
                        <option value="Active" selected>Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FoundationDate">
                    Foundation Date
                </label>
                <input asp-for="FoundationDate" type="date" class="form-control" />
                <span asp-validation-for="FoundationDate" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label asp-for="TeamDescription">
                Team Description
            </label>
            <textarea asp-for="TeamDescription" class="form-control" rows="4"></textarea>
            <span asp-validation-for="TeamDescription" class="text-danger"></span>
        </div>

        <div class="form-group" style="display: none;">
            <input asp-for="IsActive" type="checkbox" checked="@Model.IsActive" />
        </div>

        <div class="form-actions">
            <a asp-action="Index" asp-controller="TournamentsList" asp-route-tab="@returnTab" class="btn btn-cancel">Cancel</a>
            <button type="submit" name="createAnother" value="true" class="btn btn-create-another">Create & create another</button>
            <button type="submit" class="btn btn-primary">Create</button>
        </div>
    </form>
</div>

<button type="button" class="fab-button" onclick="document.querySelector('form').submit();">+</button>

<script>
    function handleFileSelect(input) {
        const fileNameDisplay = document.getElementById('fileName');
        const mediaBtn = document.getElementById('mediaBtn');

        if (input.files && input.files[0]) {
            const fileName = input.files[0].name;
            fileNameDisplay.textContent = fileName;
            fileNameDisplay.style.display = 'inline-block';
            mediaBtn.classList.add('file-selected');
            mediaBtn.textContent = 'File selected';
        } else {
            fileNameDisplay.style.display = 'none';
            mediaBtn.classList.remove('file-selected');
            mediaBtn.textContent = 'Add media';
        }
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}