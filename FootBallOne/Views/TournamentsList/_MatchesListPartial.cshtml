@model FootBallOne.Models.MatchListViewModel

@if (Model.Matches == null || !Model.Matches.Any())
{
    <div class="no-data-icon">
        <span>⏰</span>
    </div>
    <div class="no-data-text">No Data</div>
}
else
{
    <table class="matches-table">
        <thead>
            <tr>
                <th>Tournament</th>
                <th>Match</th>
                <th>Date & Time</th>
                <th>Venue</th>
                <th>Score</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var match in Model.Matches)
            {
                <tr>
                    <td>@match.Tournament</td>
                    <td>
                        <div class="match-teams">
                            @match.HomeTeam vs @match.AwayTeam
                        </div>
                    </td>
                    <td>
                        @match.MatchDate.ToString("MMM dd, yyyy")<br />
                        <small>@match.MatchTime.ToString(@"hh\:mm")</small>
                    </td>
                    <td>@match.Venue</td>
                    <td>
                        @if (match.MatchStatus == "Completed" || match.MatchStatus == "Live")
                        {
                            <span class="match-score">@match.HomeScore - @match.AwayScore</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        <span class="status-badge status-@match.MatchStatus.ToLower().Replace(" ", "-")">
                            @match.MatchStatus
                        </span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <a asp-action="Details" asp-route-id="@match.MatchId" class="btn-action">View</a>
                            <a asp-action="Edit" asp-route-id="@match.MatchId" class="btn-action">Edit</a>
                            <a asp-action="Delete" asp-route-id="@match.MatchId" class="btn-action"> Delete </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}