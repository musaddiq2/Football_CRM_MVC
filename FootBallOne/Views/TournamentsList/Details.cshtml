@model FootBallOne.ViewModel.MatchViewModel

<div class="match-container">
    <!-- Hero Header -->
    <div class="match-hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div class="match-icon">
                <i class="bi bi-trophy-fill"></i>
            </div>
            <h1 class="match-title">@Model.HomeTeam vs @Model.AwayTeam</h1>
            <div class="match-status-badge">
                @if (Model.MatchStatus == "Live")
                {
                    <span class="status-active"><i class="bi bi-check-circle-fill"></i> Live</span>
                }
                else if (Model.MatchStatus == "Completed")
                {
                    <span class="status-completed"><i class="bi bi-check-circle-fill"></i> Completed</span>
                }
                else if (Model.MatchStatus == "Scheduled")
                {
                    <span class="status-scheduled"><i class="bi bi-clock-fill"></i> Scheduled</span>
                }
                else if (Model.MatchStatus == "Postponed")
                {
                    <span class="status-postponed"><i class="bi bi-pause-circle-fill"></i> Postponed</span>
                }
                else if (Model.MatchStatus == "Cancelled")
                {
                    <span class="status-cancelled"><i class="bi bi-x-circle-fill"></i> Cancelled</span>
                }
                else
                {
                    <span class="status-other"><i class="bi bi-info-circle-fill"></i> @Model.MatchStatus</span>
                }
            </div>
        </div>
    </div>

    <div class="container main-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Score Card (if available) -->
        @if (Model.MatchStatus == "Completed" || Model.MatchStatus == "Live")
        {
            <div class="score-card">
                <div class="section-header">
                    <i class="bi bi-award"></i>
                    <h3>Match Score</h3>
                </div>
                <div class="score-content">
                    <div class="team-score">
                        <span class="team-name">@Model.HomeTeam</span>
                        <span class="score-value">@Model.HomeScore</span>
                    </div>
                    <div class="score-divider">
                        <i class="bi bi-dash-lg"></i>
                    </div>
                    <div class="team-score">
                        <span class="score-value">@Model.AwayScore</span>
                        <span class="team-name">@Model.AwayTeam</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Winner))
                {
                    <div class="winner-info">
                        <span class="winner-badge">Winner: @Model.Winner</span>
                    </div>
                }
            </div>
        }

        <!-- Info Cards Grid -->
        <div class="info-grid">
            <!-- Schedule Card -->
            <div class="info-card schedule-card">
                <div class="card-icon">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <h4>Match Schedule</h4>
                <div class="date-info">
                    <div class="date-item">
                        <span class="date-label">Date</span>
                        <span class="date-value">@Model.MatchDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="date-divider">
                        <i class="bi bi-clock"></i>
                    </div>
                    <div class="date-item">
                        <span class="date-label">Time</span>
                        <span class="date-value">@Model.MatchTime.ToString(@"hh\:mm")</span>
                    </div>
                </div>
            </div>

            <!-- Details Card -->
            <div class="info-card details-card">
                <div class="card-icon">
                    <i class="bi bi-info-circle"></i>
                </div>
                <h4>Match Details</h4>
                <div class="detail-list">
                    <div class="detail-item">
                        <span class="detail-label">Tournament</span>
                        <span class="detail-value">@Model.Tournament</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Venue</span>
                        <span class="detail-value">@Model.Venue</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Referee</span>
                        <span class="detail-value">@Model.Referee</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Status</span>
                        <span class="detail-badge status-badge">@Model.MatchStatus</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Teams Section -->
        <div class="teams-section">
            <div class="section-header">
                <i class="bi bi-people"></i>
                <h3>Competing Teams</h3>
            </div>
            <div class="teams-grid">
                <div class="team-card home-team">
                    <div class="team-icon">
                        <i class="bi bi-house-door-fill"></i>
                    </div>
                    <div class="team-content">
                        <h5 class="team-name">@Model.HomeTeam</h5>
                        <span class="team-type">Home Team</span>
                    </div>
                </div>
                <div class="team-card away-team">
                    <div class="team-icon">
                        <i class="bi bi-airplane-fill"></i>
                    </div>
                    <div class="team-content">
                        <h5 class="team-name">@Model.AwayTeam</h5>
                        <span class="team-type">Away Team</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Additional Information Section -->
        @if (!string.IsNullOrEmpty(Model.VIPGuests) || !string.IsNullOrEmpty(Model.Sponsors) || !string.IsNullOrEmpty(Model.InvitationNotes))
        {
            <div class="additional-section">
                <div class="section-header">
                    <i class="bi bi-star-fill"></i>
                    <h3>Additional Information</h3>
                </div>
                <div class="additional-grid">
                    @if (!string.IsNullOrEmpty(Model.VIPGuests))
                    {
                        <div class="additional-card">
                            <div class="additional-icon">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div class="additional-content">
                                <h5>VIP Guests</h5>
                                <p>@Model.VIPGuests</p>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Sponsors))
                    {
                        <div class="additional-card">
                            <div class="additional-icon">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <div class="additional-content">
                                <h5>Sponsors</h5>
                                <p>@Model.Sponsors</p>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.InvitationNotes))
                    {
                        <div class="additional-card">
                            <div class="additional-icon">
                                <i class="bi bi-envelope-paper"></i>
                            </div>
                            <div class="additional-content">
                                <h5>Invitation Notes</h5>
                                <p>@Model.InvitationNotes</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <p>No additional information available</p>
            </div>
        }

        <!-- Action Buttons -->
        <div class="action-buttons">
            <a asp-action="Edit" asp-route-id="@Model.MatchId" class="btn btn-primary action-btn">
                <i class="bi bi-pencil-fill"></i> Edit
            </a>
            <form asp-action="Delete" asp-route-id="@Model.MatchId" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger action-btn">
                    <i class="bi bi-trash-fill"></i> Delete
                </button>
            </form>
            <a asp-action="Index" asp-route-tab="@ViewBag.ReturnTab" class="btn btn-secondary action-btn">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>

        <!-- Footer Info -->
        <div class="footer-info">
            <i class="bi bi-clock-history"></i>
            <span>Match ID: @Model.MatchId</span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-hide success message after 5 seconds
        setTimeout(function() {
            var alert = document.querySelector('.alert-success');
            if (alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }
        }, 5000);
    </script>
}

