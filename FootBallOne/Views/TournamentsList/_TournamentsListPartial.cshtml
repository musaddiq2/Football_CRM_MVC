<div class="tournaments-table-container">
    @if (Model == null || !Model.Any())
    {
        <div style="padding: 40px; text-align: center;">
            <div class="no-data-icon" style="font-size: 48px;">⏰</div>
            <div class="no-data-text" style="margin-top: 10px; font-size: 16px; color: #888;">No Data</div>
        </div>
    }
    else
    {
        <div class="table-controls">
            @* <div class="search-box">
                    <input type="text" placeholder="Search" id="searchInput" />
                </div>

                <div class="filters-section">
                    <button class="btn-filters">
                        <span>Filters</span>
                        <span class="filter-badge">0</span>
                    </button>

                    <div class="view-toggle">
                        <button title="List View">☰</button>
                        <button title="Grid View">⊞</button>
                    </div> 
                </div>*@
        </div>

        <table class="tournaments-table">
            <thead>
                <tr>
                    <th>Tournament Name</th>
                    <th>Branch</th>
                    <th>Date Interval</th>
                    <th>Status</th>
                    <th>Invited Facilities</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.TournamentName</td>
                        <td>@t.Branch</td>
                        <td>
                            @t.StartDate.ToString("MMM d, yyyy")<br />
                            <small style="color: #999;">to</small><br />
                            @t.EndDate.ToString("MMM d, yyyy")
                        </td>
                        <td>
                            <span class="status-badge status-@t.Status.ToLower()">@t.Status</span>
                        </td>
                        <td>
                            @if (t.InvitedFacilities?.Any() == true)
                            {
                                @string.Join(", ", t.InvitedFacilities)
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </td>
                        <td>
                            <span class="actions-menu">
                                ⋮
                                <div class="dropdown-menu">
                                    <a href="@Url.Action("TournamentEdit", "TournamentsList", new { id = t.TournamentID })">Edit</a>
                                    <a href="@Url.Action("TournamentDetails", "TournamentsList", new { id = t.TournamentID })">Details</a>
                                    <a href="@Url.Action("TournamentDelete", "TournamentsList", new { id = t.TournamentID })">Delete</a>
                                </div>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="footer-section">
            <div class="results-count">Showing @Model.Count result@(Model.Count != 1 ? "s" : "")</div>

            <div class="pagination-controls">
                <label>Per page</label>
                <select>
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
        </div>
    }
</div>
</div>