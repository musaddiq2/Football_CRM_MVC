@model IEnumerable<FootBallOne.Models.FBProductVariant>
@{
    ViewData["Title"] = "Product Variants";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>🔀 Product Variants</h2>
            <p class="text-muted">Product: <strong>@ViewBag.ProductName</strong></p>
        </div>
        <div class="col-md-6 text-right">
            <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#createVariantModal">
                <i class="fas fa-plus"></i> Add Variant
            </button>
            <a asp-action="Products" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Products
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-layer-group fa-5x text-muted mb-3"></i>
                    <h5>No Variants Yet</h5>
                    <p class="text-muted">Add variants like sizes, colors, or other options for this product.</p>
                    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#createVariantModal">
                        <i class="fas fa-plus"></i> Add First Variant
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="thead-dark">
                            <tr>
                                <th>Size</th>
                                <th>Color</th>
                                <th>SKU</th>
                                <th>Additional Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var variant in Model)
                            {
                                <tr>
                                    <td>@(variant.Size ?? "N/A")</td>
                                    <td>@(variant.Color ?? "N/A")</td>
                                    <td>@variant.SKU</td>
                                    <td>
                                        @if (variant.AdditionalPrice > 0)
                                        {
                                            <span class="text-success">+₹@variant.AdditionalPrice.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span>₹0.00</span>
                                        }
                                    </td>
                                    <td>
                                        @if (variant.IsOutOfStock)
                                        {
                                            <span class="badge badge-danger">Out of Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">@variant.StockQuantity</span>
                                        }
                                    </td>
                                    <td>
                                        @if (variant.IsActive)
                                        {
                                            <span class="badge badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="DeleteVariant" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@variant.VariantId" />
                                            <input type="hidden" name="productId" value="@ViewBag.ProductId" />
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this variant?')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create Variant Modal -->
<div class="modal fade" id="createVariantModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateVariant" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ProductId" value="@ViewBag.ProductId" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Add Product Variant</h5>
                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="font-weight-bold">Size</label>
                        <input type="text" name="Size" class="form-control" placeholder="e.g., S, M, L, XL, 42, 43" />
                        <small class="form-text text-muted">Leave blank if not applicable</small>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Color</label>
                        <input type="text" name="Color" class="form-control" placeholder="e.g., Red, Blue, Black" />
                        <small class="form-text text-muted">Leave blank if not applicable</small>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Variant SKU <span class="text-danger">*</span></label>
                        <input type="text" name="SKU" class="form-control" required placeholder="e.g., FB-001-S-RED" />
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Additional Price</label>
                        <input type="number" name="AdditionalPrice" class="form-control" step="0.01" value="0" />
                        <small class="form-text text-muted">Extra price for this variant (₹0 if same as base price)</small>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Stock Quantity <span class="text-danger">*</span></label>
                        <input type="number" name="StockQuantity" class="form-control" required value="0" min="0" />
                    </div>

                    <div class="form-check">
                        <input type="checkbox" name="IsActive" class="form-check-input" checked />
                        <label class="form-check-label">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Variant</button>
                </div>
            </form>
        </div>
    </div>
</div>