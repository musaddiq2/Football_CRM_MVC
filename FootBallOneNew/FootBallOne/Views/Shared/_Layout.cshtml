                </div>

                <!-- NEW: Admin/Academy E-Commerce Menu -->
                <div class="sidebar-item">
                    <a class="sidebar-link" href="#" data-label="E-Commerce">
                        <i class="bi bi-cart4"></i>
                        <span class="label">E-Commerce</span>
                        <button class="caret-btn" type="button">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    </a>
                    <div class="submenu">
                        <a class="submenu-link" href="@Url.Action("Dashboard", "FBProductAdmin")">
                            <i class="bi bi-graph-up"></i> Dashboard
                        </a>
                        <a class="submenu-link" href="@Url.Action("Products", "FBProductAdmin")">
                            <i class="bi bi-box"></i> Products
                        </a>
                        <a class="submenu-link" href="@Url.Action("Categories", "FBProductAdmin")">
                            <i class="bi bi-tags"></i> Categories
                        </a>
                        <a class="submenu-link" href="@Url.Action("Orders", "FBProductAdmin")">
                            <i class="bi bi-cart-check"></i> Orders
                        </a>
                    </div>
                </div>

                <!-- NEW: Student Shop Menu -->
                <div class="sidebar-item">
                    <a class="sidebar-link" href="#" data-label="Shop">
                        <i class="bi bi-shop"></i>
                        <span class="label">Shop</span>
                        <button class="caret-btn" type="button">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    </a>
                    <div class="submenu">
                        <a class="submenu-link" href="@Url.Action("Index", "FBShop")">
                            <i class="bi bi-store"></i> Browse Products
                        </a>
                        <a class="submenu-link" href="@Url.Action("Cart", "FBShop")">
                            <i class="bi bi-cart"></i> My Cart <span class="badge bg-primary" id="cart-count">0</span>
                        </a>
                        <a class="submenu-link" href="@Url.Action("MyOrders", "FBShop")">
                            <i class="bi bi-box-seam"></i> My Orders
                        </a>
                    </div>
                </div>

                <hr>
                <a class="sidebar-link" href="#" data-label="Help & Support">
                    <i class="bi bi-question-circle"></i>
                    <span class="label">Help & Support</span>
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const wrapper = document.getElementById('app-wrapper');
        const sidebarToggle = document.getElementById('sidebarToggle');

        // Function to update tooltips based on sidebar state
        function updateTooltips() {
            const isCollapsed = wrapper.classList.contains('sidebar-collapsed');
            document.querySelectorAll('.sidebar-link').forEach(link => {
                const label = link.querySelector('.label');
                if (label && isCollapsed) {
                    link.setAttribute('title', label.textContent.trim());
                } else {
                    link.removeAttribute('title');
                }
            });
        }

        // Toggle sidebar and update tooltips
        sidebarToggle.addEventListener('click', () => {
            wrapper.classList.toggle('sidebar-collapsed');

            // Close all dropdowns when sidebar collapses
            if (wrapper.classList.contains('sidebar-collapsed')) {
                document.querySelectorAll('.sidebar-item').forEach(item => item.classList.remove('open'));
            }
            updateTooltips();
        });

        // Toggle submenu for dropdown items
        document.querySelectorAll('.caret-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                const item = btn.closest('.sidebar-item');
                const isOpen = item.classList.toggle('open');

                // Close other open dropdowns
                document.querySelectorAll('.sidebar-item').forEach(other => {
                    if (other !== item) other.classList.remove('open');
                });
            });
        });

        // Initial call to set tooltips based on initial sidebar state
        updateTooltips();

        // Update cart count on page load
        $(document).ready(function() {
            updateCartCount();
        });

        function updateCartCount() {
            $.get('/FBShop/GetCartCount', function(data) {
                $('#cart-count').text(data.count);
                $('#cart-count-header').text(data.count);
                if (data.count > 0) {
                    $('#cart-count').show();
                    $('#cart-count-header').show();
                } else {
                    $('#cart-count').hide();
                    $('#cart-count-header').hide();
                }
            });
        }
    </script>
</body>
</html>