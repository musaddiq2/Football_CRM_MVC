                        @Html.ActionLink("Add Coach", "Create", "Coach", null, new { @class = "submenu-link" })
                        @Html.ActionLink("Coach Details", "Index", "Coach", null, new { @class = "submenu-link" })
                    </div>
                </div>

                <div class="sidebar-item">
                    <a class="sidebar-link" href="#" data-label="Create Academy">
                        <i class="bi bi-calendar-check"></i>
                        <span class="label">Create Academy</span>
                        <button class="caret-btn" type="button">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    </a>
                    <div class="submenu">
                        @Html.ActionLink("Create Academy Here", "Index", "Security", null, new { @class = "submenu-link" })
                        @Html.ActionLink("Branch Dashboard", "Index", "Dashboard", null, new { @class = "submenu-link" })
