                <a class="sidebar-link" href="@Url.Action("RequestRegistration", "RegistrationManagements")">
                    <i class="bi bi-person-badge"></i>
                    <span class="label">User Add Some Details</span>
                </a>

                <a class="sidebar-link" href="@Url.Action("RejectedRequests", "RegistrationManagements")" data-label="Rejected Players">
                    <i class="bi bi-person-x"></i>
                    <span class="label">Rejected Players</span>
                </a>

                <div class="sidebar-item">
                    <a class="sidebar-link" href="#" data-label="Coach">
                        <i class="bi bi-calendar-check"></i>
