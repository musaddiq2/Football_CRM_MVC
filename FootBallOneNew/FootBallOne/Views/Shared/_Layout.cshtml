                </div>

                <div class="sidebar-item">
                    <a class="sidebar-link" href="#" data-label="Player Status">
                        <i class="bi bi-list-ul"></i>
                        <span class="label">Player Status</span>
                        <button class="caret-btn" type="button">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    </a>
                    <div class="submenu">
                        @Html.ActionLink("Status Paid", "Paid", "Alerts", null, new { @class = "submenu-link" })
                        @Html.ActionLink("Unpaid Player", "NotPaid", "Alerts", null, new { @class = "submenu-link" })
                        @Html.ActionLink("Pending", "Pending", "Alerts", null, new { @class = "submenu-link" })
                        @Html.ActionLink("Subscription Expired", "Expired", "Alerts", null, new { @class = "submenu-link" })
                        @Html.ActionLink("Subscription ExpiringSoon", "ExpiringSoon", "Alerts", null, new { @class = "submenu-link" })
                    </div>
                </div>

                <a class="sidebar-link" href="@Url.Action("Login", "CC")">
                    <i class="bi bi-speedometer2"></i>
                    <span class="label">User Dashboard</span>
                </a>

                <a class="sidebar-link" href="@Url.Action("ReviewRequests", "RegistrationManagements")">
                    <i class="bi bi-check2-square"></i>
                    <span class="label">Admin Accept/Reject Req</span>
                </a>

                <div class="sidebar-item">
                    <a class="sidebar-link" href="#" data-label="Player Attendance">
                        <i class="bi bi-person-check"></i>
                        <span class="label">Player Attendance</span>
                        <button class="caret-btn" type="button">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    </a>
                    <div class="submenu">
                        @Html.ActionLink("Player Attendance", "MarkAttendance", "PlayerAttendance", null, new { @class = "submenu-link" })
                        @Html.ActionLink("Player Status", "ViewAttendance", "PlayerAttendance", null, new { @class = "submenu-link" })
