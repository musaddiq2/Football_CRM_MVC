@{
    ViewData["Title"] = "Import Subscribers Data";
    Layout = "_Layout";
}

<!-- Bootstrap & Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h4>Import Subscribers Data</h4>
        </div>
        <div class="card-body">
            <p>Please ensure your file is properly formatted. Each subscriber needs a name and either a mobile number or parent mobile number. For parent-child relationships, either include the parent as a separate row with their own mobile number, or add the parent's name in the child's row alongside the parent_mobile field. Parent information will be processed automatically, and duplicates will be handled based on mobile numbers, names, and other identifiers.</p>
            <div class="mb-3">
                <label for="csvFile" class="form-label">Upload a CSV file</label>
                <input type="file" class="form-control" id="csvFile" accept=".csv" />
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary">Prepare File for Import</button>
                <a href="#" class="btn btn-warning" download>English Example XLSX</a>
                <a href="#" class="btn btn-warning" download>English Example CSV</a>
                <a href="#" class="btn btn-warning" download>Arabic Example XLSX</a>
                <a href="#" class="btn btn-warning" download>Arabic Example CSV</a>
                <button type="button" class="btn btn-success">Import</button>
            </div>
        </div>
        <div class="card-footer text-end">
            <button type="button" class="btn btn-secondary" onclick="window.location.href='@Url.Action("Index", "RegistrationManagement")'">Cancel</button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const importBtn = document.querySelector('.btn-success');
        importBtn.addEventListener('click', function () {
            const fileInput = document.getElementById('csvFile');
            if (fileInput.files.length > 0) {
                const formData = new FormData();
                formData.append('csvFile', fileInput.files[0]);

                fetch('/RegistrationManagement/ProcessImport', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    alert('Import completed! ' + data.message);
                    window.location.href = '@Url.Action("Index", "RegistrationManagement")';
                })
                .catch(error => alert('Error during import: ' + error));
            } else {
                alert('Please select a CSV file to import.');
            }
        });
    });
</script>