@model FootBallOne.Models.FBProduct
@{
    ViewData["Title"] = "Edit Product";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>✏️ Edit Product</h2>
        </div>
        <div class="col-md-6 text-right">
            <a asp-action="Products" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Products
            </a>
        </div>
    </div>

    @if (TempData["ModelErrors"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ModelErrors"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <form asp-action="EditProduct" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ProductId" />

        <div class="row">
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Product Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="ProductName" class="font-weight-bold"></label>
                            <input asp-for="ProductName" class="form-control" />
                            <span asp-validation-for="ProductName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="CategoryId" class="font-weight-bold"></label>
                                    <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories">
                                        <option value="">-- Select Category --</option>
                                    </select>
                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="SKU" class="font-weight-bold"></label>
                                    <input asp-for="SKU" class="form-control" />
                                    <span asp-validation-for="SKU" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label asp-for="Description" class="font-weight-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="form-group">
                            <label asp-for="Brand" class="font-weight-bold"></label>
                            <input asp-for="Brand" class="form-control" />
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="BasePrice" class="font-weight-bold"></label>
                                    <input asp-for="BasePrice" class="form-control" type="number" step="0.01" />
                                    <span asp-validation-for="BasePrice" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="DiscountPercentage" class="font-weight-bold"></label>
                                    <input asp-for="DiscountPercentage" class="form-control" type="number" step="0.01" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="StockQuantity" class="font-weight-bold"></label>
                                    <input asp-for="StockQuantity" class="form-control" type="number" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="MinStockLevel" class="font-weight-bold"></label>
                                    <input asp-for="MinStockLevel" class="form-control" type="number" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Weight" class="font-weight-bold"></label>
                                    <input asp-for="Weight" class="form-control" type="number" step="0.01" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Dimensions" class="font-weight-bold"></label>
                                    <input asp-for="Dimensions" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label asp-for="Tags" class="font-weight-bold"></label>
                            <input asp-for="Tags" class="form-control" />
                        </div>
                    </div>
                </div>

                <!-- Existing Images -->
                @if (Model.ProductImages != null && Model.ProductImages.Any())
                {
                    <div class="card mb-4">
                        <div class="card-header bg-warning">
                            <h5 class="mb-0">Existing Images</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                @foreach (var image in Model.ProductImages.OrderBy(i => i.DisplayOrder))
                                {
                                    <div class="col-md-3 mb-3 text-center">
                                        <img src="@image.ImageUrl" class="img-thumbnail" style="height: 150px; object-fit: cover;" />
                                        @if (image.IsPrimary)
                                        {
                                            <span class="badge badge-primary d-block mt-2">Primary</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-md-4">
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">Update Images</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label class="font-weight-bold">New Primary Image</label>
                            <input type="file" name="primaryImage" class="form-control-file" accept="image/*" />
                            <small class="form-text text-muted">Will replace current primary image</small>
                        </div>

                        <div class="form-group">
                            <label class="font-weight-bold">Add More Images</label>
                            <input type="file" name="additionalImages" class="form-control-file" accept="image/*" multiple />
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Product Status</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-check mb-2">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label font-weight-bold"></label>
                        </div>

                        <div class="form-check">
                            <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                            <label asp-for="IsFeatured" class="form-check-label font-weight-bold"></label>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-warning btn-block btn-lg">
                    <i class="fas fa-save"></i> Update Product
                </button>

                <a asp-action="ProductVariants" asp-route-productId="@Model.ProductId" class="btn btn-info btn-block mt-2">
                    <i class="fas fa-layer-group"></i> Manage Variants
                </a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}