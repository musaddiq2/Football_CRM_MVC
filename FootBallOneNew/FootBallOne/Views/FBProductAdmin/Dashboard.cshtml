@{
    ViewData["Title"] = "E-Commerce Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-4">⚽ Football Store Dashboard</h2>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Products</h5>
                    <h2>@ViewBag.TotalProducts</h2>
                    <p class="mb-0">@ViewBag.ActiveProducts Active</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Orders</h5>
                    <h2>@ViewBag.TotalOrders</h2>
                    <p class="mb-0">@ViewBag.PendingOrders Pending</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Low Stock</h5>
                    <h2>@ViewBag.LowStockProducts</h2>
                    <p class="mb-0">Need Restock</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Revenue</h5>
                    <h2>₹@ViewBag.TotalRevenue.ToString("N2")</h2>
                    <p class="mb-0">Paid Orders</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a asp-action="CreateProduct" class="btn btn-primary btn-block btn-lg">
                                <i class="fas fa-plus"></i> Add New Product
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-action="Products" class="btn btn-info btn-block btn-lg">
                                <i class="fas fa-box"></i> Manage Products
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-action="Orders" class="btn btn-success btn-block btn-lg">
                                <i class="fas fa-shopping-cart"></i> View Orders
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-action="Categories" class="btn btn-warning btn-block btn-lg">
                                <i class="fas fa-tags"></i> Manage Categories
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (ViewBag.LowStockProducts > 0 || ViewBag.OutOfStockProducts > 0)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <h5 class="alert-heading">⚠️ Stock Alerts</h5>
                    <ul class="mb-0">
                        @if (ViewBag.LowStockProducts > 0)
                        {
                            <li><strong>@ViewBag.LowStockProducts</strong> products are running low on stock</li>
                        }
                        @if (ViewBag.OutOfStockProducts > 0)
                        {
                            <li><strong>@ViewBag.OutOfStockProducts</strong> products are out of stock</li>
                        }
                    </ul>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
}