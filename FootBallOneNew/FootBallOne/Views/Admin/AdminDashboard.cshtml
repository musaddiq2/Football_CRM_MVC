@model FootBallOne.Models.Admin
@{
    ViewData["Title"] = "Admin Dashboard";

    // 🟢 FIX: Retrieve Academy details from ViewBag, which were fetched in the controller.
    string academyName = ViewBag.AcademyName as string ?? "N/A";
    string companyCode = ViewBag.CompanyCode as string ?? "N/A";
    string location = ViewBag.Location as string ?? "N/A";
    string headCoach = ViewBag.HeadCoach as string ?? "N/A";
    int? capacity = ViewBag.Capacity as int? ?? 0;
    int? contactNo = ViewBag.ContactNo as int?;
    string academyAddress = ViewBag.AcademyAddress as string ?? "N/A";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="text-center mb-4">
        {{-- 🟢 FIX: Use the ViewBag variable for AcademyName --}}
        <h1 class="fw-bold text-primary">⚽ @academyName - Admin Dashboard</h1>
        {{-- Model.Email still works as Email is a property on the Admin model --}}
        <p class="text-muted">Welcome, <strong>@Model.Email</strong></p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-lg border-0 rounded-4 p-3">
                <h5 class="fw-bold text-primary mb-3">Academy Info</h5>
                {{-- Model.AcademyID still works as AcademyID is on the Admin model --}}
                <p><strong>Academy ID:</strong> @Model.AcademyID</p>
                {{-- 🟢 FIX: Use ViewBag variables for Academy details --}}
                <p><strong>Company Code:</strong> @companyCode</p>
                <p><strong>Location:</strong> @location</p>
                <p><strong>Address:</strong> @academyAddress</p>
                <p><strong>Capacity:</strong> @capacity Players</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-lg border-0 rounded-4 p-3">
                <h5 class="fw-bold text-success mb-3">Head Coach</h5>
                {{-- 🟢 FIX: Use ViewBag variable for HeadCoach --}}
                <p>@(string.IsNullOrEmpty(headCoach) ? "Not Assigned" : headCoach)</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-lg border-0 rounded-4 p-3">
                <h5 class="fw-bold text-info mb-3">Contact</h5>
                {{-- 🟢 FIX: Use ViewBag variable for ContactNo --}}
                <p><strong>Phone:</strong> @(contactNo?.ToString() ?? "N/A")</p>
                <p><strong>Email:</strong> @Model.Email</p>
            </div>
        </div>
    </div>

    <div class="mt-5 text-center">
        <a href="@Url.Action("Index", "RegistrationManagements")" class="btn btn-primary btn-lg me-2">
            Manage Players
        </a>
        <a href="@Url.Action("Logout", "Admin")" class="btn btn-danger btn-lg">
            Logout
        </a>
    </div>
</div>

<style>
    .card {
        transition: all 0.3s ease-in-out;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0px 6px 20px rgba(0,0,0,0.15);
        }
</style>