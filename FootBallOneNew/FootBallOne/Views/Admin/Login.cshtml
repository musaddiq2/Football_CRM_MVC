@model FootBallOne.Models.Admin

@{
    ViewData["Title"] = "Admin Login";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', sans-serif;
    }

    .form-panel {
        background-color: #fff;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    }

    .info-panel {
        background-color: #0f0f0f;
        color: #ffffff;
        padding: 40px;
        border-radius: 10px;
    }

    .form-title {
        font-weight: 600;
    }

    .text-small {
        font-size: 0.9rem;
        color: gray;
    }

    .form-control:focus {
        box-shadow: none;
        border-color: #007bff;
    }

    footer a:hover {
        text-decoration: underline;
    }

    /* ✅ ADD: Styling for branch selector */
    .branch-selector {
        position: relative;
    }

        .branch-selector .form-select {
            padding-left: 40px;
            height: 45px;
            font-size: 0.95rem;
        }

    .branch-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        font-size: 1.2rem;
        z-index: 10;
        pointer-events: none;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 d-flex shadow-lg rounded-4 overflow-hidden">
            <!-- Admin Login Form -->
            <div class="col-md-6 p-4 form-panel">
                <h3 class="form-title mb-3">Admin Login</h3>
                <p class="text-small mb-4">Welcome back! Please enter your admin credentials.</p>

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-danger text-center">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @ViewBag.Message
                    </div>
                }

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Email Field -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">
                            <i class="bi bi-envelope me-1"></i> Email Address
                        </label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="admin@example.com" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Password Field -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">
                            <i class="bi bi-lock me-1"></i> Password
                        </label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Enter your password" required />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <!-- ✅ UPDATED: Branch Selection Dropdown with Icon -->
                    <div class="mb-3">
                        <label asp-for="AcademyID" class="form-label">
                            <i class="bi bi-building me-1"></i> Select Branch
                        </label>
                        <div class="branch-selector">
                            <i class="bi bi-geo-alt-fill branch-icon"></i>
                            <select asp-for="AcademyID" class="form-select" required>
                                <option value="">-- Select Your Branch --</option>
                                <option value="1">🏢 Bangalore Branch</option>
                                <option value="2">🏢 Pune Branch</option>
                                <option value="3">🏢 Saudi Branch</option>
                            </select>
                        </div>
                        <span asp-validation-for="AcademyID" class="text-danger"></span>
                        <small class="form-text text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Choose the branch you want to access
                        </small>
                    </div>

                    <!-- Remember Me -->
                    <div class="form-check mb-4">
                        <input type="checkbox" class="form-check-input" id="rememberMe" />
                        <label class="form-check-label" for="rememberMe">Remember Me</label>
                    </div>

                    <!-- Login Button -->
                    <button type="submit" class="btn btn-dark w-100">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Login to Dashboard
                    </button>

                    <!-- ✅ ADD: Forgot Password Link (Optional) -->
                    <div class="text-center mt-3">
                        <a href="#" class="text-decoration-none text-muted">
                            <small>Forgot Password?</small>
                        </a>
                    </div>
                </form>
            </div>

            <!-- Info Panel -->
            <div class="col-md-6 p-5 info-panel text-center d-flex flex-column justify-content-center">
                <div class="mb-4">
                    <i class="bi bi-shield-lock-fill" style="font-size: 4rem; color: #fff;"></i>
                </div>
                <h2 class="mb-3">Admin Portal</h2>
                <p class="mb-4">Access academy data, manage players, coaches, and stay in control of your football academy.</p>

                <!-- ✅ UPDATED: Better image handling -->
                @if (System.IO.File.Exists(System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "full-shot-man-playing-football.jpg")))
                {
                    <img src="~/full-shot-man-playing-football.jpg" class="img-fluid rounded shadow-lg" alt="Football Admin" />
                }
                else
                {
                    <div class="bg-secondary bg-opacity-25 rounded p-5">
                        <i class="bi bi-trophy-fill" style="font-size: 5rem; opacity: 0.3;"></i>
                    </div>
                }

                <!-- ✅ ADD: Quick Stats -->
                <div class="row mt-4 text-start">
                    <div class="col-6">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-people-fill fs-3 me-2"></i>
                            <div>
                                <small class="d-block opacity-75">Manage</small>
                                <strong>Players</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-calendar-event fs-3 me-2"></i>
                            <div>
                                <small class="d-block opacity-75">Schedule</small>
                                <strong>Events</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- ✅ ADD: Client-side validation for branch selection -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form');
            const branchSelect = document.getElementById('AcademyID');

            form.addEventListener('submit', function(e) {
                if (!branchSelect.value || branchSelect.value === '') {
                    e.preventDefault();

                    // Show error message
                    const errorDiv = document.createElement('div');
                    errorDiv.className = 'alert alert-warning alert-dismissible fade show mt-3';
                    errorDiv.innerHTML = `
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Please select a branch before logging in.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    `;

                    // Remove existing error if present
                    const existingError = form.querySelector('.alert-warning');
                    if (existingError) {
                        existingError.remove();
                    }

                    // Add error above submit button
                    const submitBtn = form.querySelector('button[type="submit"]');
                    submitBtn.parentNode.insertBefore(errorDiv, submitBtn);

                    // Highlight the branch select
                    branchSelect.classList.add('is-invalid');
                    branchSelect.focus();

                    return false;
                }
            });

            // Remove error styling when user selects a branch
            branchSelect.addEventListener('change', function() {
                if (this.value) {
                    this.classList.remove('is-invalid');
                    const warningAlert = form.querySelector('.alert-warning');
                    if (warningAlert) {
                        warningAlert.remove();
                    }
                }
            });
        });
    </script>
}