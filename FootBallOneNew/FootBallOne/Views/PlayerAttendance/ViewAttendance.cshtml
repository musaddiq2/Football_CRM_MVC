@model List<FootBallOne.Models.PlayerAttendance>
@{
    ViewData["Title"] = "View Attendance by Date";
      Layout = "_Layout";
    var coachList = ViewBag.CoachList as List<string>; // populated from controller
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />

<div class="max-w-5xl mx-auto p-6 bg-white mt-10 rounded-xl shadow-lg">
    <h2 class="text-3xl font-bold mb-6 text-gray-800 text-center">📅 View Player Attendance by Date</h2>

    <!-- Coach and Date Filter Form -->
    <form method="get" class="mb-8 grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
        <div>
            <label for="coachName" class="block font-medium text-gray-700 mb-1">Select Coach:</label>
            <select name="coachName" id="coachName" class="w-full border rounded px-4 py-2">
                <option value="">-- All Coaches --</option>
                @if (coachList != null)
                {
                    @foreach (var coach in coachList)
{
    var selected = Context.Request.Query["coachName"] == coach ? "selected" : "";
    @:<option value="@coach" @selected>@coach</option>
}

                }
            </select>
        </div>

        <div>
            <label for="date" class="block font-medium text-gray-700 mb-1">Select Date:</label>
            <input type="date" name="date" id="date" value="@ViewBag.SelectedDate" class="w-full border rounded px-4 py-2" />
        </div>

        <div>
            <button type="submit" class="w-full bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 transition">
                🔍 Filter
            </button>
        </div>
    </form>

    @if (Model != null && Model.Count > 0)
    {
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 border rounded-lg">
                <thead class="bg-gray-100">
                    <tr>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Player Name</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Coach</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Status</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">Date</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-4 py-3 font-medium text-gray-800">@item.PlayerName</td>
                            <td class="px-4 py-3 text-gray-600">@item.CoachName</td>
                            <td class="px-4 py-3 font-semibold @(item.Status == "Present" ? "text-green-600" : "text-red-500")">@item.Status</td>
                            <td class="px-4 py-3 text-gray-500">@item.Date.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center text-yellow-600 font-medium mt-6">
            ⚠️ No attendance records found for the selected filters.
        </div>
    }
</div>
