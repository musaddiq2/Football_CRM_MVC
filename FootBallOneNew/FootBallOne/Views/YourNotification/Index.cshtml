@{
    ViewData["Title"] = " Your Notification";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2 style="color:red">IN PROGRESS</h2>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Notifications</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <div class="min-h-screen py-6">
        <div class="max-w-6xl mx-auto px-6">
            <!-- Header -->
            <div class="mb-6">
                <h1 class="text-2xl font-bold text-black">Your Notifications</h1>
            </div>

            <!-- Main Container -->
            <div class="bg-white rounded-lg border border-gray-200 p-0">
                <!-- Search and Filter Bar -->
                <div class="flex items-center justify-between p-4 border-b border-gray-100">
                    <div class="flex-1"></div>

                    <div class="flex items-center gap-3">
                        <!-- Search Input -->
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </div>
                            <input type="text"
                                   placeholder="Search"
                                   class="w-64 pl-9 pr-3 py-2 text-sm border border-gray-300 rounded-md bg-white focus:outline-none focus:ring-1 focus:ring-gray-300 focus:border-gray-300">
                        </div>

                        <!-- Filters Button -->
                        <button class="flex items-center px-3 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                            <svg class="w-4 h-4 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                            </svg>
                            Filters
                            <span class="ml-2 px-1.5 py-0.5 text-xs bg-blue-100 text-blue-600 rounded-full min-w-5 text-center">0</span>
                        </button>

                        <!-- Three dots menu -->
                        <button class="p-2 text-gray-400 hover:text-gray-600">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Empty State -->
                <div class="flex flex-col items-center justify-center py-24">
                    <!-- Info Icon -->
                    <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center mb-4">
                        <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>

                    <!-- Text -->
                    <h3 class="text-base font-medium text-gray-900 mb-1">No notifications</h3>
                    <p class="text-sm text-gray-500">Please check back later.</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>