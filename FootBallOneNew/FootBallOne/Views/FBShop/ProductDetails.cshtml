@model FootBallOne.Models.FBProduct
@{
    ViewData["Title"] = Model.ProductName;
    var primaryImage = Model.ProductImages.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? "/images/no-image.png";
    var averageRating = Model.ProductReviews.Any() ? Model.ProductReviews.Average(r => r.Rating) : 0;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <nav aria-label="breadcrumb" class="mt-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Shop</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category?.CategoryName</a></li>
            <li class="breadcrumb-item active">@Model.ProductName</li>
        </ol>
    </nav>

    <div class="row mt-4">
        <!-- Product Images -->
        <div class="col-md-6">
            <div class="card">
                <img id="mainImage" src="@primaryImage" class="card-img-top" alt="@Model.ProductName" style="height: 400px; object-fit: contain;" />
            </div>

            @if (Model.ProductImages.Count() > 1)
            {
                <div class="row mt-3">
                    @foreach (var image in Model.ProductImages.OrderBy(i => i.DisplayOrder))
                    {
                        <div class="col-3">
                            <img src="@image.ImageUrl" class="img-thumbnail" style="cursor: pointer; height: 80px; object-fit: cover;"
                                 onclick="document.getElementById('mainImage').src='@image.ImageUrl'" />
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Product Information -->
        <div class="col-md-6">
            <h2>@Model.ProductName</h2>

            @if (!string.IsNullOrEmpty(Model.Brand))
            {
                <p class="text-muted">Brand: <strong>@Model.Brand</strong></p>
            }

            <!-- Rating -->
            @if (Model.ProductReviews.Any())
            {
                <div class="mb-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= averageRating)
                        {
                            <span class="text-warning">★</span>
                        }
                        else
                        {
                            <span class="text-muted">☆</span>
                        }
                    }
                    <span class="ml-2">(@averageRating.ToString("F1")) - @Model.ProductReviews.Count() reviews</span>
                </div>
            }
            else
            {
                <p class="text-muted">No ratings yet</p>
            }

            <!-- Price -->
            <div class="my-3">
                @if (Model.DiscountPercentage > 0)
                {
                    <h4 class="text-muted" style="text-decoration: line-through;">₹@Model.BasePrice.ToString("N2")</h4>
                    <h2 class="text-success">₹@Model.FinalPrice.ToString("N2")</h2>
                    <span class="badge badge-danger">Save @Model.DiscountPercentage%</span>
                }
                else
                {
                    <h2>₹@Model.FinalPrice.ToString("N2")</h2>
                }
            </div>

            <!-- Stock Status -->
            <div class="mb-3">
                @if (Model.IsOutOfStock)
                {
                    <span class="badge badge-danger badge-lg">Out of Stock</span>
                }
                else if (Model.IsLowStock)
                {
                    <span class="badge badge-warning badge-lg">Only @Model.StockQuantity left in stock!</span>
                }
                else
                {
                    <span class="badge badge-success badge-lg">In Stock</span>
                }
            </div>

            <!-- Product Variants -->
            @if (Model.ProductVariants != null && Model.ProductVariants.Any())
            {
                <div class="mb-3">
                    <label class="font-weight-bold">Select Variant:</label>
                    <select id="variantSelect" class="form-control">
                        <option value="">-- Standard --</option>
                        @foreach (var variant in Model.ProductVariants.Where(v => v.IsActive))
                        {
                            var price = Model.FinalPrice + variant.AdditionalPrice;
                            @if (variant.IsOutOfStock)
                            {
                                <option value="@variant.VariantId" data-price="@price" disabled>
                                    @variant.VariantDisplay - ₹@price.ToString("N2") (Out of Stock)
                                </option>
                            }
                            else
                            {
                                <option value="@variant.VariantId" data-price="@price">
                                    @variant.VariantDisplay - ₹@price.ToString("N2")
                                </option>
                            }
                        }
                    </select>
                </div>
            }

            <!-- Quantity -->
            <div class="form-group">
                <label class="font-weight-bold">Quantity:</label>
                <input type="number" id="quantity" class="form-control" value="1" min="1" max="@Model.StockQuantity" style="width: 100px;" />
            </div>

            <!-- Add to Cart Button -->
            @if (!Model.IsOutOfStock)
            {
                <button class="btn btn-success btn-lg btn-block" onclick="addToCart()">
                    <i class="fas fa-shopping-cart"></i> Add to Cart
                </button>
            }
            else
            {
                <button class="btn btn-secondary btn-lg btn-block" disabled>Out of Stock</button>
            }

            <a asp-action="Index" class="btn btn-outline-primary btn-block mt-2">
                <i class="fas fa-arrow-left"></i> Continue Shopping
            </a>

            <!-- Product Description -->
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">Product Description</h5>
                </div>
                <div class="card-body">
                    <p>@(Model.Description ?? "No description available.")</p>

                    @if (Model.Weight.HasValue || !string.IsNullOrEmpty(Model.Dimensions))
                    {
                        <hr />
                        <h6>Specifications:</h6>
                        <ul>
                            @if (Model.Weight.HasValue)
                            {
                                <li><strong>Weight:</strong> @Model.Weight.Value kg</li>
                            }
                            @if (!string.IsNullOrEmpty(Model.Dimensions))
                            {
                                <li><strong>Dimensions:</strong> @Model.Dimensions</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews Section -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Customer Reviews (@Model.ProductReviews.Count())</h5>
                </div>
                <div class="card-body">
                    @if (!Model.ProductReviews.Any())
                    {
                        <p class="text-muted">No reviews yet. Be the first to review this product!</p>
                    }
                    else
                    {
                        @foreach (var review in Model.ProductReviews.OrderByDescending(r => r.CreatedAt))
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <strong>@review.ReviewTitle</strong>
                                        <div>
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <span class="text-warning">★</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">☆</span>
                                                }
                                            }
                                            @if (review.IsVerifiedPurchase)
                                            {
                                                <span class="badge badge-success ml-2">Verified Purchase</span>
                                            }
                                        </div>
                                    </div>
                                    <small class="text-muted">@review.CreatedAt.ToString("dd MMM yyyy")</small>
                                </div>
                                <p class="mt-2 mb-0">@review.ReviewText</p>
                            </div>
                        }
                    }

                    <!-- Add Review Button -->
                    <button type="button" class="btn btn-primary mt-3" data-toggle="modal" data-target="#reviewModal">
                        <i class="fas fa-star"></i> Write a Review
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (ViewBag.RelatedProducts != null && ((IEnumerable<FootBallOne.Models.FBProduct>)ViewBag.RelatedProducts).Any())
    {
        <div class="row mt-5">
            <div class="col-12">
                <h4 class="mb-4">Related Products</h4>
            </div>
            @foreach (var product in (IEnumerable<FootBallOne.Models.FBProduct>)ViewBag.RelatedProducts)
            {
                var relatedImage = product.ProductImages.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? "/images/no-image.png";
                <div class="col-md-3 mb-3">
                    <div class="card">
                        <img src="@relatedImage" class="card-img-top" alt="@product.ProductName" style="height: 200px; object-fit: cover;" />
                        <div class="card-body">
                            <h6 class="card-title">@product.ProductName</h6>
                            <p class="text-success"><strong>₹@product.FinalPrice.ToString("N2")</strong></p>
                            <a asp-action="ProductDetails" asp-route-id="@product.ProductId" class="btn btn-sm btn-primary btn-block">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Review Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Write a Review</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="font-weight-bold">Rating <span class="text-danger">*</span></label>
                    <select id="reviewRating" class="form-control" required>
                        <option value="">Select Rating</option>
                        <option value="5">5 - Excellent</option>
                        <option value="4">4 - Good</option>
                        <option value="3">3 - Average</option>
                        <option value="2">2 - Poor</option>
                        <option value="1">1 - Terrible</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="font-weight-bold">Review Title</label>
                    <input type="text" id="reviewTitle" class="form-control" placeholder="Summary of your review" />
                </div>
                <div class="form-group">
                    <label class="font-weight-bold">Review</label>
                    <textarea id="reviewText" class="form-control" rows="4" placeholder="Tell us about your experience..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitReview()">Submit Review</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function addToCart() {
            var variantId = $('#variantSelect').val() || null;
            var quantity = parseInt($('#quantity').val());

            $.post('@Url.Action("AddToCart")', {
                productId: @Model.ProductId,
                variantId: variantId,
                quantity: quantity
            }, function (response) {
                if (response.success) {
                    alert('✅ ' + response.message);
                    updateCartCount();
                } else {
                    alert('❌ ' + response.message);
                }
            });
        }

        function submitReview() {
            var rating = $('#reviewRating').val();
            var title = $('#reviewTitle').val();
            var text = $('#reviewText').val();

            if (!rating) {
                alert('Please select a rating');
                return;
            }

            $.post('@Url.Action("AddReview")', {
                productId: @Model.ProductId,
                rating: rating,
                reviewTitle: title,
                reviewText: text
            }, function (response) {
                if (response.success) {
                    alert('✅ ' + response.message);
                    $('#reviewModal').modal('hide');
                    location.reload();
                } else {
                    alert('❌ ' + response.message);
                }
            });
        }

        function updateCartCount() {
            $.get('@Url.Action("GetCartCount")', function (data) {
                $('#cart-count').text(data.count);
                $('#cart-count-header').text(data.count);
            });
        }
    </script>
}
