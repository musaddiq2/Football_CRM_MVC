@model IEnumerable<FootBallOne.Models.FBOrder>
@{
    ViewData["Title"] = "My Orders";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-md-6">
            <h2>📦 My Orders</h2>
        </div>
        <div class="col-md-6 text-right">
            <a asp-action="Index" class="btn btn-primary">
                <i class="fas fa-store"></i> Continue Shopping
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-box-open fa-5x text-muted mb-3"></i>
                <h4>No Orders Yet</h4>
                <p class="text-muted">You haven't placed any orders yet. Start shopping now!</p>
                <a asp-action="Index" class="btn btn-primary mt-3">
                    <i class="fas fa-store"></i> Browse Products
                </a>
            </div>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            var statusClass = order.OrderStatus switch
            {
                "Pending" => "warning",
                "Confirmed" => "info",
                "Shipped" => "primary",
                "Delivered" => "success",
                "Cancelled" => "danger",
                _ => "secondary"
            };

            <div class="card mb-3">
                <div class="card-header bg-@statusClass text-white">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <strong>Order #@order.OrderNumber</strong>
                        </div>
                        <div class="col-md-3">
                            <i class="fas fa-calendar"></i> @order.CreatedAt.ToString("dd MMM yyyy")
                        </div>
                        <div class="col-md-3">
                            <i class="fas fa-rupee-sign"></i> ₹@order.TotalAmount.ToString("N2")
                        </div>
                        <div class="col-md-3 text-right">
                            <span class="badge badge-light">@order.OrderStatus</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <h6>Order Items:</h6>
                            <ul class="list-unstyled">
                                @foreach (var item in order.OrderItems.Take(3))
                                {
                                    <li>• @item.ProductName x @item.Quantity - ₹@item.TotalPrice.ToString("N2")</li>
                                }
                                @if (order.OrderItems.Count() > 3)
                                {
                                    <li class="text-muted">... and @(order.OrderItems.Count() - 3) more items</li>
                                }
                            </ul>

                            @if (!string.IsNullOrEmpty(order.TrackingNumber))
                            {
                                <div class="alert alert-info mb-0">
                                    <i class="fas fa-truck"></i> <strong>Tracking Number:</strong> @order.TrackingNumber
                                </div>
                            }
                        </div>
                        <div class="col-md-4 text-right">
                            <div class="mb-2">
                                <strong>Payment:</strong>
                                <span class="badge badge-@(order.PaymentStatus == "Paid" ? "success" : "warning")">
                                    @order.PaymentStatus
                                </span>
                            </div>

                            <a asp-action="MyOrderDetails" asp-route-id="@order.OrderId" class="btn btn-primary btn-block">
                                <i class="fas fa-eye"></i> View Details
                            </a>

                            @if (order.OrderStatus == "Pending")
                            {
                                <button type="button" class="btn btn-danger btn-block mt-2" onclick="showCancelModal(@order.OrderId, '@order.OrderNumber')">
                                    <i class="fas fa-times"></i> Cancel Order
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

