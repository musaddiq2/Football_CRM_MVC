@model IEnumerable<FootBallOne.Models.FBProduct>
@{
    ViewData["Title"] = "Football Store";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .product-card {
        transition: transform 0.3s;
        height: 100%;
    }
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
    .product-image {
        height: 250px;
        object-fit: cover;
        width: 100%;
    }
    .price-strike {
        text-decoration: line-through;
        color: #999;
    }
</style>

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="text-center mb-4">⚽ Football Academy Store</h1>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Categories</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a href="@Url.Action("Index")" class="list-group-item list-group-item-action @(ViewBag.SelectedCategory == null ? "active" : "")">
                        All Products
                    </a>
                    @foreach (var category in ViewBag.Categories as List<FootBallOne.Models.FBCategory>)
                    {
                        <a href="@Url.Action("Index", new { categoryId = category.CategoryId })" 
                           class="list-group-item list-group-item-action @(ViewBag.SelectedCategory == category.CategoryId ? "active" : "")">
                            @category.CategoryName
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <!-- Search and Sort -->
            <form method="get" class="mb-4">
                <div class="row">
                    <div class="col-md-6">
                        <input type="text" name="search" class="form-control" placeholder="Search products..." value="@ViewBag.SearchTerm" />
                    </div>
                    <div class="col-md-4">
                        <select name="sortBy" class="form-control">
                            <option value="">Sort By</option>
                            @if (ViewBag.SortBy == "price_low")
                            {
                                <option value="price_low" selected>Price: Low to High</option>
                            }
                            else
                            {
                                <option value="price_low">Price: Low to High</option>
                            }

                            @if (ViewBag.SortBy == "price_high")
                            {
                                <option value="price_high" selected>Price: High to Low</option>
                            }
                            else
                            {
                                <option value="price_high">Price: High to Low</option>
                            }

                            @if (ViewBag.SortBy == "name")
                            {
                                <option value="name" selected>Name: A to Z</option>
                            }
                            else
                            {
                                <option value="name">Name: A to Z</option>
                            }

                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-block">Search</button>
                    </div>
                </div>
            </form>

            <!-- Products Grid -->
            <div class="row">
                @if (!Model.Any())
                {
                    <div class="col-12">
                        <div class="alert alert-info">
                            No products found. Try adjusting your filters.
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var product in Model)
                    {
                        var primaryImage = product.ProductImages.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? "/images/no-image.png";
                        <div class="col-md-4 mb-4">
                            <div class="card product-card">
                                @if (product.IsFeatured)
                                {
                                    <div class="position-absolute" style="top: 10px; left: 10px; z-index: 10;">
                                        <span class="badge badge-warning">Featured</span>
                                    </div>
                                }
                                @if (product.DiscountPercentage > 0)
                                {
                                    <div class="position-absolute" style="top: 10px; right: 10px; z-index: 10;">
                                        <span class="badge badge-danger">-@product.DiscountPercentage%</span>
                                    </div>
                                }
                                
                                <img src="@primaryImage" class="card-img-top product-image" alt="@product.ProductName" />
                                
                                <div class="card-body">
                                    <h5 class="card-title">@product.ProductName</h5>
                                    <p class="card-text text-muted">@(product.Brand ?? "Football Gear")</p>
                                    
                                    <div class="mb-2">
                                        @if (product.DiscountPercentage > 0)
                                        {
                                            <span class="price-strike">₹@product.BasePrice.ToString("N2")</span>
                                            <strong class="text-success h5 ml-2">₹@product.FinalPrice.ToString("N2")</strong>
                                        }
                                        else
                                        {
                                            <strong class="h5">₹@product.FinalPrice.ToString("N2")</strong>
                                        }
                                    </div>

                                    <div class="mb-2">
                                        @if (product.IsOutOfStock)
                                        {
                                            <span class="badge badge-danger">Out of Stock</span>
                                        }
                                        else if (product.IsLowStock)
                                        {
                                            <span class="badge badge-warning">Only @product.StockQuantity left!</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">In Stock</span>
                                        }
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center">
                                        <a asp-action="ProductDetails" asp-route-id="@product.ProductId" class="btn btn-primary">
                                            View Details
                                        </a>
                                        @if (!product.IsOutOfStock)
                                        {
                                            <button class="btn btn-success" onclick="addToCart(@product.ProductId)">
                                                <i class="fas fa-shopping-cart"></i> Add to Cart
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function addToCart(productId) {
            $.post('@Url.Action("AddToCart")', { productId: productId, quantity: 1 }, function(response) {
                if (response.success) {
                    alert('✅ ' + response.message);
                    updateCartCount();
                } else {
                    alert('❌ ' + response.message);
                }
            });
        }

        function updateCartCount() {
            $.get('@Url.Action("GetCartCount")', function(data) {
                $('#cart-count').text(data.count);
            });
        }

        $(document).ready(function() {
            updateCartCount();
        });
    </script>
}