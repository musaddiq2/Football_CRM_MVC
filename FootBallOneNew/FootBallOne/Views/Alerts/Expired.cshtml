@model List<FootBallOne.Models.RegistrationManagement>

@{
    ViewData["Title"] = "📅 Expired Subscriptions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Imports -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        theme: {
            extend: {
                fontFamily: {
                    sans: ['Inter', 'sans-serif'],
                },
                colors: {
                    'soft-blue': '#ADD8E6',
                    'soft-gold': '#FFD700',
                    'danger-red': '#dc3545'
                }
            }
        }
    }
</script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f3f4f6;
        padding: 20px;
    }

    .badge-expired {
        background-color: #dc3545;
        color: white;
    }

    .card-glass {
        background-color: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        border-radius: 1rem;
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.37);
    }
</style>

<div class="container">
    <h2 class="text-3xl font-bold text-center text-danger mb-4" data-aos="fade-down">
        <i class="bi bi-calendar-x me-2"></i> @ViewData["Title"]
    </h2>

    <div class="card-glass p-4" data-aos="fade-up">
        <table class="table table-hover table-striped">
            <thead class="bg-danger text-white">
                <tr>
                    <th>Player</th>
                    <th>Subscription End</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No expired subscriptions found.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@(item.SubscriptionEnd?.ToString("dd/MM/yyyy") ?? "N/A")</td>

                            <td>
                                <span class="badge badge-expired px-3 py-1 rounded">Expired</span>
                            </td>
                            <td>
                                <form asp-action="PayOneMonth" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <a asp-controller="RegistrationManagements"
                                       asp-action="Payment"
                                       asp-route-playerId="@item.Id"
                                       asp-route-playerName="@item.Name"
                                       class="btn btn-sm btn-primary me-1"
                                       title="Open payment page">
                                        <i class="bi bi-cash me-1"></i> Pay Now
                                    </a>
                                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm">
                                        <i class="bi bi-clock me-1"></i> Extend 1 Month
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    AOS.init({ duration: 800, once: true });
</script>
