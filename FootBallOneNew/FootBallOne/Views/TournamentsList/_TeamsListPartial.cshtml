@model IEnumerable<FootBallOne.ViewModel.TeamViewModel>

@if (Model == null || !Model.Any())
{
    <div class="no-data-icon">
        <span>👥</span>
    </div>
    <div class="no-data-text">No Teams Found</div>
}
else
{
    <table class="matches-table">
        <thead>
            <tr>
                <th>Logo</th>
                <th>Team Name</th>
                <th>Branch</th>
                <th>Stadium</th>
                <th>Coach</th>
                <th>Status</th>
                <th>Foundation Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var team in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(team.TeamLogoPath))
                        {
                            <img src="@team.TeamLogoPath" alt="@team.TeamName" style="max-width: 50px; max-height: 50px;" />
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>@team.TeamName</td>
                    <td>@team.Branch</td>
                    <td>@team.Stadium</td>
                    <td>@team.Coach</td>
                    <td>
                        <span class="status-badge @(team.IsActive ? "status-completed" : "status-cancelled")">
                            @(team.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td>
                        @if (team.FoundationDate.HasValue)
                        {
                            @team.FoundationDate.Value.ToString("MMM dd, yyyy")
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>
                        <div class="action-buttons">
                            <a asp-action="TeamDetails" asp-route-id="@team.TeamID" asp-route-tab="teams" class="btn-action">View</a>
                            <a asp-action="TeamEdit" asp-route-id="@team.TeamID" asp-route-tab="teams" class="btn-action">Edit</a>
                            <a asp-action="TeamDelete" asp-route-id="@team.TeamID" asp-route-tab="teams" class="btn-action">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}