@model FootBallOne.Models.Tournament

@{
    ViewData["Title"] = "Confirm Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white text-center">
                    <h4>
                        <i class="fas fa-exclamation-triangle me-2"></i> Confirm Deletion
                    </h4>
                </div>
                <div class="card-body">
                    <p class="mb-3 text-center">
                        Are you sure you want to delete the tournament:<br />
                        <strong>@(Model.TournamentName ?? "N/A")</strong>?
                    </p>
                    <p class="text-muted text-center mb-4">
                        This action is permanent and cannot be undone.
                    </p>

                    <!-- Tournament Details -->
                    <div class="mb-3">
                        <h5>Details</h5>
                        <ul class="list-group">
                            <li class="list-group-item">
                                <strong>Description:</strong> @(Model.TournamentDescription ?? "N/A")
                            </li>
                            <li class="list-group-item">
                                <strong>Branch:</strong> @(Model.Branch ?? "N/A")
                            </li>
                            <li class="list-group-item">
                                <strong>Status:</strong> @(Model.Status ?? "N/A")
                            </li>
                            <li class="list-group-item">
                                <strong>Start Date:</strong>
                                @if (Model.StartDate != null && Model.StartDate != default(DateTime))
                                {
                                    @Model.StartDate.ToString("dd-MMM-yyyy")
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </li>
                            <li class="list-group-item">
                                <strong>End Date:</strong>
                                @if (Model.EndDate != null && Model.EndDate != default(DateTime))
                                {
                                    @Model.EndDate.ToString("dd-MMM-yyyy")
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </li>
                            <li class="list-group-item">
                                <strong>Open to Everyone:</strong>
                                @if (Model.OpenToEveryone)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </li>
                            <li class="list-group-item">
                                <strong>Is Active:</strong>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </li>
                            <li class="list-group-item">
                                <strong>Created On:</strong>
                                @if (Model.CreateDate != null && Model.CreateDate != default(DateTime))
                                {
                                    @Model.CreateDate.ToString("dd-MMM-yyyy hh:mm tt")
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </li>
                        </ul>
                    </div>

                    <!-- Invited Facilities Section -->
                    @if (Model.InvitedFacilities != null && Model.InvitedFacilities.Any())
                    {
                        <div class="mb-4">
                            <h6 class="mb-3" style="color: #333333; font-size: 15px; font-weight: 600;">
                                Invited Facilities (@Model.InvitedFacilities.Count())
                            </h6>
                            <div class="border rounded overflow-hidden" style="border-color: #dee2e6 !important;">
                                <table class="table mb-0" style="background-color: #ffffff;">
                                    <thead>
                                        <tr style="background-color: #f8f9fa; border-bottom: 1px solid #dee2e6;">
                                            <th class="py-3 ps-3" style="color: #333333; font-weight: 600; font-size: 14px; border: none;">
                                                Facility Name
                                            </th>
                                            <th class="py-3" style="color: #333333; font-weight: 600; font-size: 14px; border: none;">
                                                Invitation Message
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var facility in Model.InvitedFacilities)
                                        {
                                            <tr style="background-color: #ffffff;">
                                                <td class="py-3 ps-3" style="color: #333333; font-size: 14px; border: none;">
                                                    <b>@(facility.Invitedfacility ?? "N/A")</b>
                                                </td>
                                                <td class="py-3" style="color: #666666; font-size: 14px; border: none;">
                                                    <em>@(facility.InvitationMessage ?? "No message")</em>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-4">
                            <i class="bi bi-info-circle me-2"></i>No facilities have been invited to this tournament.
                        </div>
                    }

                    <!-- Action Buttons -->
                    <div class="text-center mt-4">
                        <form asp-action="TournamentDelete" asp-route-id="@Model.TournamentID" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn px-4 py-2 me-2" style="background-color: #d9534f; color: white; border: none; border-radius: 0.375rem; font-size: 15px; font-weight: 400;">
                                <i class="bi bi-trash me-2"></i>Delete
                            </button>
                        </form>
                        <a asp-action="Index" class="btn px-4 py-2" style="background-color: #6c757d; color: white; border: none; border-radius: 0.375rem; font-size: 15px; font-weight: 400; text-decoration: none;">
                            <i class="bi bi-x-circle me-2"></i>Cancel
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FontAwesome (optional if already in _Layout) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />