@model IEnumerable<FootBallOne.Models.Parent>

@{
    ViewData["Title"] = "Parents Management";
    var studentName = ViewBag.StudentName;
    var registrationId = ViewBag.RegistrationId;
    var studentDictionary = ViewBag.Students as Dictionary<int, string>;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Parents Management</h2>
            <p class="text-muted mb-0">For Student: <strong>@studentName</strong></p>
        </div>
        <div>
            <a asp-controller="RegistrationManagements" asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left"></i> Back to Students
            </a>
            <a asp-action="Create" asp-route-registrationId="@registrationId" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Parent
            </a>
        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Parents List -->
    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">No Parents Found</h4>
                <p class="text-muted mb-4">No parents have been added for this student yet.</p>
                <a asp-action="Create" asp-route-registrationId="@registrationId" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add First Parent
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="fas fa-list me-2"></i>Parents List (@Model.Count() parents)
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Parent Name</th>
                                <th>Student Name</th>
                                <th>Contact Information</th>
                                <th>Personal Details</th>
                                <th>Status</th>
                                <th style="width: 140px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var parent in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3">
                                                @parent.Fullname?.Substring(0, 1).ToUpper()
                                            </div>
                                            <div>
                                                <h6 class="mb-0">@parent.Fullname</h6>
                                                <small class="text-muted">ID: @parent.Id</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var currentStudentName = studentDictionary != null && studentDictionary.ContainsKey(parent.RegistrationId)
                                            ? studentDictionary[parent.RegistrationId]
                                            : "Unknown";
                                        }
                                        <div>
                                            <span class="badge bg-info text-white">
                                                <i class="fas fa-user-graduate me-1"></i>@currentStudentName
                                            </span>
                                            <div class="small text-muted mt-1">Student ID: @parent.RegistrationId</div>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <div><i class="fas fa-envelope me-2 text-muted"></i>@parent.Email</div>
                                            <div><i class="fas fa-phone me-2 text-muted"></i>@parent.MobileNo</div>
                                            @if (parent.PhoneNumbers != null && parent.PhoneNumbers.Any(p => p.IsWhatsApp))
                                            {
                                                <div><i class="fab fa-whatsapp me-2 text-success"></i>WhatsApp Available</div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <div><strong>Gender:</strong> @parent.Gender</div>
                                            <div><strong>Iqama:</strong> @(parent.IqamaID ?? "N/A")</div>
                                            <div><strong>City:</strong> @(parent.City ?? "N/A")</div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (parent.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                        <div class="small text-muted mt-1">
                                            Created: @parent.CreatedDate.ToString("MMM dd, yyyy")
                                        </div>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@parent.Id"
                                               class="btn btn-outline-info" title="View Details">
                                                <i class="fas fa-eye me-1"></i>Details
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@parent.Id"
                                               class="btn btn-outline-warning" title="Edit">
                                                <i class="fas fa-edit me-1"></i>Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@parent.Id"
                                               class="btn btn-outline-danger" title="Delete"
                                               onclick="return confirm('Are you sure you want to delete this parent?');">
                                                <i class="fas fa-trash me-1"></i>Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Summary Card -->
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <h4 class="mb-0">@Model.Count()</h4>
                                <small>Total Parents</small>
                            </div>
                            <div class="flex-shrink-0">
                                <i class="fas fa-users fa-2x opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <h4 class="mb-0">@Model.Count(p => p.IsActive)</h4>
                                <small>Active Parents</small>
                            </div>
                            <div class="flex-shrink-0">
                                <i class="fas fa-check-circle fa-2x opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <h4 class="mb-0">@Model.Count(p => !string.IsNullOrEmpty(p.MobileNo))</h4>
                                <small>With Mobile</small>
                            </div>
                            <div class="flex-shrink-0">
                                <i class="fas fa-mobile-alt fa-2x opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <h4 class="mb-0">@Model.Count(p => p.PhoneNumbers != null && p.PhoneNumbers.Any(pp => pp.IsWhatsApp))</h4>
                                <small>WhatsApp Users</small>
                            </div>
                            <div class="flex-shrink-0">
                                <i class="fab fa-whatsapp fa-2x opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        .avatar-sm {
            width: 40px;
            height: 40px;
            font-weight: bold;
            font-size: 16px;
        }

        .table td {
            vertical-align: middle;
        }

        /* Fixed button group styling */
        .btn-group {
            display: inline-flex;
            gap: 0;
        }

            .btn-group .btn {
                border-radius: 0;
                margin: 0;
            }

                .btn-group .btn:first-child {
                    border-top-left-radius: 0.375rem;
                    border-bottom-left-radius: 0.375rem;
                }

                .btn-group .btn:last-child {
                    border-top-right-radius: 0.375rem;
                    border-bottom-right-radius: 0.375rem;
                }

                .btn-group .btn + .btn {
                    border-left: 0;
                }

        .card {
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            border: 1px solid rgba(0, 0, 0, 0.125);
        }
    </style>
}

@section Scripts {
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            $('.alert').alert('close');
        }, 5000);
    </script>
}