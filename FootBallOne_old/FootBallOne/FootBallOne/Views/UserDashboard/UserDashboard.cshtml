@model FootBallOne.Models.RegistrationManagement
@{
    ViewData["Title"] = "Player Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Model.Name</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        /* Your full style block is correct and included here */
    </style>
</head>
<body>
    <div class="dashboard-container" data-aos="fade-up" data-aos-duration="1000">
        <h2 class="text-center mb-4 text-primary fw-bold" data-aos="fade-down" data-aos-delay="200">
            👋 Welcome, @Model.Name
        </h2>

        <div class="row">
            <div class="col-lg-5 col-md-6 mb-4" data-aos="fade-right" data-aos-delay="300">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
                    <div class="card-body text-center">
                        <div class="profile-image-container mb-3">
                            <img src="@Model.ImageFile" alt="Player Image" class="img-fluid" onerror="this.onerror=null;this.src='https://via.placeholder.com/150/007bff/ffffff?text=Player';">
                        </div>
                        <h4 class="card-title text-dark mb-2">@Model.Name</h4>
                        <hr class="w-75 mx-auto my-3" />
                        <div class="text-start">
                            <div class="info-item">
                                <i class="bi bi-envelope-fill"></i> <div><strong>Email:</strong> @Model.Email</div>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-phone-fill"></i> <div><strong>Phone No:</strong> @Model.PhoneNo</div>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-geo-alt-fill"></i> <div><strong>Address:</strong> @Model.Address, @Model.City</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7 col-md-6 mb-4" data-aos="fade-left" data-aos-delay="400">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-3">
                    <div class="card-body">
                        <h5 class="section-heading"><i class="bi bi-calendar-check me-2"></i> Subscription Details</h5>
                        <div class="mb-3">
                            <div class="info-item">
                                <i class="bi bi-grid-fill"></i> <div><strong>Category:</strong> <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">@Model.Category</span></div>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-calendar-event-fill"></i> <div><strong>Start Date:</strong> @(Model.SubscriptionStart?.ToString("dd/MM/yyyy") ?? "N/A")</div>
                            </div>
                            <div class="info-item">
                                <i class="bi bi-calendar-x-fill"></i> <div><strong>End Date:</strong> @(Model.SubscriptionEnd?.ToString("dd/MM/yyyy") ?? "N/A")</div>
                            </div>
                        </div>
                        <hr class="my-3" />
                        <h5 class="section-heading mt-4"><i class="bi bi-cash-coin me-2"></i> Payment Status</h5>
                        <div class="info-item mb-3">
                            <i class="bi bi-credit-card-fill"></i>
                            <div>
                                <strong>Status:</strong>
                                @if (Model.PaymentStatus == "Paid")
                                {
                                    <span class="status-badge bg-success text-white">
                                        <i class="bi bi-check-circle-fill me-1"></i> Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge bg-danger text-white">
                                        <i class="bi bi-x-circle-fill me-1"></i> Not Paid
                                    </span>
                                }
                            </div>
                        </div>
                        <hr class="my-3" />
                        <h5 class="section-heading mt-4"><i class="bi bi-person-fill me-2"></i> Coaching & Schedule</h5>
                        <div class="info-item">
                            <i class="bi bi-person-circle"></i> <div><strong>Coach:</strong> @Model.CoachName</div>
                        </div>
                        <div class="info-item">
                            <i class="bi bi-clock-fill"></i> <div><strong>Working Hours:</strong> @Model.WorkingHours</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4 border-0 shadow-sm rounded-4" data-aos="fade-up" data-aos-delay="500">
            <div class="card-body p-4">
                <h5 class="section-heading text-center mb-4"><i class="bi bi-wallet-fill me-2"></i> Fees Breakdown</h5>
                <div class="table-responsive fees-table">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Fee Type</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Subscription Fees</td>
                                <td class="text-end">@Model.SubscriptionFees?.ToString("C2")</td>
                            </tr>
                            <tr>
                                <td>Kit Fees</td>
                                <td class="text-end">@Model.KitFees?.ToString("C2")</td>
                            </tr>
                            <tr>
                                <td>Sugar Fees</td>
                                <td class="text-end">@Model.SugarFees?.ToString("C2")</td>
                            </tr>
                            <tr>
                                <td>Bag Fees</td>
                                <td class="text-end">@Model.BagFees?.ToString("C2")</td>
                            </tr>
                            <tr class="total-fees-row">
                                <td><strong>Total Fees</strong></td>
                                <td class="text-end"><strong>@Model.TotalFees.ToString("C2")</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 800,
            once: true
        });
    </script>
</body>
</html>
