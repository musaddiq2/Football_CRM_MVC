@model FootBallOne.Models.Admin
@{
    ViewData["Title"] = "Admin Dashboard";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="text-center mb-4">
        <h1 class="fw-bold text-primary">⚽ @Model.AcademyName - Admin Dashboard</h1>
        <p class="text-muted">Welcome, <strong>@Model.Email</strong></p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-lg border-0 rounded-4 p-3">
                <h5 class="fw-bold text-primary mb-3">Academy Info</h5>
                <p><strong>Academy ID:</strong> @Model.AcademyID</p>
                <p><strong>Company Code:</strong> @Model.CompanyCode</p>
                <p><strong>Location:</strong> @Model.Location</p>
                <p><strong>Address:</strong> @Model.AcademyAddress</p>
                <p><strong>Capacity:</strong> @(Model.Capacity ?? 0) Players</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-lg border-0 rounded-4 p-3">
                <h5 class="fw-bold text-success mb-3">Head Coach</h5>
                <p>@(string.IsNullOrEmpty(Model.HeadCoach) ? "Not Assigned" : Model.HeadCoach)</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-lg border-0 rounded-4 p-3">
                <h5 class="fw-bold text-info mb-3">Contact</h5>
                <p><strong>Phone:</strong> @(Model.ContactNo?.ToString() ?? "N/A")</p>
                <p><strong>Email:</strong> @Model.Email</p>
            </div>
        </div>
    </div>

    <div class="mt-5 text-center">
        <a href="@Url.Action("Index", "RegistrationManagements")" class="btn btn-primary btn-lg me-2">
            Manage Players
        </a>
        <a href="@Url.Action("Logout", "Admin")" class="btn btn-danger btn-lg">
            Logout
        </a>
    </div>
</div>

<style>
    .card {
        transition: all 0.3s ease-in-out;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0px 6px 20px rgba(0,0,0,0.15);
        }
</style>
