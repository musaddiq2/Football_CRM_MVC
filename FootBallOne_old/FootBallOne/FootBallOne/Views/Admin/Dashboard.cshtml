@{
}
@model IEnumerable<FootBallOne.Models.RegistrationManagement>
@{
    ViewData["Title"] = "Admin Dashboard";
}



@* <h2 class="text-center mt-4">Football Academy Registrations</h2> *@

<table class="table table-bordered table-hover mt-4">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Category</th>
            <th>City</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.PhoneNo</td>
                <td>@item.Category</td>
                <td>@item.City</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

