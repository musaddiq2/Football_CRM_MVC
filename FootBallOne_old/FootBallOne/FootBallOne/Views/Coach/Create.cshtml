@model FootBallOne.Models.Coach

@{
    ViewData["Title"] = "Create Coach";
    Layout = "_Layout";
}

@section Styles {
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .required-label::after {
            content: '*';
            color: #ef4444;
            margin-left: 4px;
        }
    </style>
}

<div class="flex justify-center items-center min-h-screen bg-gray-100 p-6">
    <div class="w-full max-w-2xl bg-white rounded-xl shadow-lg p-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-6 text-center">Create New Coach</h1>

        @using (Html.BeginForm("Create", "Coach", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="text-red-500 mb-3">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>

            <!-- FullName -->
            <div class="mb-4">
                <label class="required-label block text-sm font-medium text-gray-700">Full Name</label>
                @Html.TextBoxFor(m => m.FullName, new { @class = "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm sm:text-sm" })
                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-red-500 text-xs" })
            </div>

            <!-- Age -->
            <div class="mb-4">
                <label class="required-label block text-sm font-medium text-gray-700">Age</label>
                @Html.TextBoxFor(m => m.Age, new { type = "number", @class = "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm sm:text-sm" })
                @Html.ValidationMessageFor(m => m.Age, "", new { @class = "text-red-500 text-xs" })
            </div>

            <!-- PhoneNumber -->
            <div class="mb-4">
                <label class="required-label block text-sm font-medium text-gray-700">Phone Number</label>
                @Html.TextBoxFor(m => m.PhoneNumber, new { type = "tel", @class = "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm sm:text-sm" })
                @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-red-500 text-xs" })
            </div>

            <!-- Email -->
            <div class="mb-4">
                <label class="required-label block text-sm font-medium text-gray-700">Email</label>
                @Html.TextBoxFor(m => m.Email, new { type = "email", @class = "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm sm:text-sm" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-red-500 text-xs" })
            </div>

            <!-- Specialization -->
            <div class="mb-4">
                <label class="required-label block text-sm font-medium text-gray-700">Specialization</label>
                @Html.TextBoxFor(m => m.Specialization, new { @class = "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm sm:text-sm" })
                @Html.ValidationMessageFor(m => m.Specialization, "", new { @class = "text-red-500 text-xs" })
            </div>

            <!-- ExperienceYears -->
            <div class="mb-4">
                <label class="required-label block text-sm font-medium text-gray-700">Experience Years</label>
                @Html.TextBoxFor(m => m.ExperienceYears, new { type = "number", @class = "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm sm:text-sm" })
                @Html.ValidationMessageFor(m => m.ExperienceYears, "", new { @class = "text-red-500 text-xs" })
            </div>

            <!-- WorkingHours -->
            <div class="mb-4">
                <label class="required-label block text-sm font-medium text-gray-700">Working Hours</label>
                @Html.TextBoxFor(m => m.WorkingHours, new { @class = "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm sm:text-sm" })
                @Html.ValidationMessageFor(m => m.WorkingHours, "", new { @class = "text-red-500 text-xs" })
            </div>

            <!-- AssignedPlayers -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700">Assigned Players</label>
                @Html.TextBoxFor(m => m.AssignedPlayers, new { @class = "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm sm:text-sm" })
            </div>

            <!-- JoiningDate -->
            <div class="mb-4">
                <label class="required-label block text-sm font-medium text-gray-700">Joining Date</label>
                @Html.TextBoxFor(m => m.JoiningDate, new { type = "date", @class = "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm sm:text-sm" })
                @Html.ValidationMessageFor(m => m.JoiningDate, "", new { @class = "text-red-500 text-xs" })
            </div>

            <!-- PhotoFile -->
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700">Photo File</label>
                <input type="file" name="PhotoFile" accept="image/*" class="mt-1 block w-full text-sm text-gray-500 file:py-2 file:px-4 file:rounded-md file:border-0 file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
            </div>

            <!-- Buttons -->
            <div class="flex flex-col space-y-3">
                <button type="submit" class="w-full py-3 px-4 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">
                    Create Coach
                </button>
                <a href="@Url.Action("Index", "Coach")" class="w-full py-3 px-4 text-center bg-gray-100 rounded-md text-gray-800 hover:bg-gray-200">
                    Back to List
                </a>
            </div>

            <p class="text-sm text-gray-500 mt-6 text-center">
                Required fields are marked with <span class="text-red-500">*</span>
            </p>
        }
    </div>
</div>
