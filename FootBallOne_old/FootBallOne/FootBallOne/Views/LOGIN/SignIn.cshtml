@model FootBallOne.Models.Login

@{
    ViewData["Title"] = "Sign In";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    body {
        background-color: #f8f9fa;
    }

    .navbar-custom {
        background: black;
    }

        .navbar-custom .nav-link {
            margin-left: 15px;
            transition: color 0.2s ease;
        }

            .navbar-custom .nav-link:hover {
                color: #cdd6ff !important;
            }

        .navbar-custom .navbar-brand {
            font-size: 1.25rem;
        }

    .form-panel {
        background-color: #fff;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    }

    .info-panel {
        background-color: #0f0f0f;
        color: #ffffff;
        padding: 40px;
        border-radius: 10px;
    }

    .form-control:focus {
        box-shadow: none;
        border-color: #007bff;
    }

    .form-title {
        font-weight: 600;
    }

    .text-small {
        font-size: 0.9rem;
        color: gray;
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 d-flex shadow-lg rounded-4 overflow-hidden">
            <!-- Form Panel -->
            <div class="col-md-6 p-4 form-panel">
                <h3 class="form-title mb-3">Sign In</h3>
                <p class="text-small mb-4">Welcome back! Please enter your credentials.</p>

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-danger text-center">@ViewBag.Message</div>
                }

                <form asp-action="SignIn" method="post">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input name="email" type="email" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input name="password" type="password" class="form-control" required />
                    </div>

                    <div class="form-check mb-4">
                        <input type="checkbox" class="form-check-input" id="rememberMe">
                        <label class="form-check-label" for="rememberMe">Remember Me</label>
                    </div>

                    <button type="submit" class="btn btn-dark w-100">Login</button>
                    @*  <a href="/RM/Create" class="btn btn-dark w-100 text-center">Login</a> *@

                    <p class="text-center mt-3">
                        Don't have an account? <a asp-action="Create" asp-controller="Login" class="text-decoration-none">Register</a>
                    </p>
                </form>
            </div>

            <!-- Info Panel -->
            <div class="col-md-6 p-5 info-panel text-center d-flex flex-column justify-content-center">
                <h2 class="mb-3">Welcome To Football Academy</h2>
                <p>Sign in and continue your journey. Train, grow, and play like a pro!</p>
                <img src="~/full-shot-man-playing-football.jpg" class="img">
                <img src="~/full-shot-man-playing-football.jpg" alt="Chart" class="img-fluid rounded">
                @*  <div class="bg-white text-dark rounded p-3 mt-4">
                    <h6 class="mb-1">Performance Tracker</h6>
                    <img src="https://dummyimage.com/300x150/ddd/000.png&text=Stats+Chart" alt="Chart" class="img-fluid rounded">
                </div> *@
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
