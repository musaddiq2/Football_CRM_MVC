@model FootBallOne.Models.RegistrationManagement
@{
    ViewData["Title"] = "Register Player";
    Layout = "_Layout";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    /* (keep your styles and add step styles) */
    body {
        background: linear-gradient(to right,#c9d6ff,#e2e2e2);
        font-family: 'Segoe UI', sans-serif;
    }

    .form-card {
        background: #fff;
        padding: 35px;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .step-indicator {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 8px;
    }

    .step {
        text-align: center;
        flex: 1;
        position: relative;
    }

        .step .circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #e9e9e9;
            color: #333;
            font-weight: 600;
        }

        .step.active .circle {
            background: #000;
            color: #fff;
        }

        .step.completed .circle {
            background: #198754;
            color: #fff;
        }

        .step .label {
            display: block;
            font-size: 0.85rem;
            margin-top: 6px;
            color: #333;
        }

    .step-line {
        position: absolute;
        top: 18px;
        left: 50%;
        right: -50%;
        height: 4px;
        background: #e9e9e9;
        z-index: -1;
    }

    .step:last-child .step-line {
        display: none;
    }

    .step.completed ~ .step .step-line {
        background: #e9e9e9;
    }
    /* fallback */
    .progress-line {
        position: relative;
        height: 4px;
        background: #e9e9e9;
        border-radius: 2px;
        margin: 12px 0;
    }

    .progress-fill {
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        width: 0%;
        background: #000;
        border-radius: 2px;
        transition: width .35s ease;
    }

    .hidden {
        display: none;
    }

    .btn-custom {
        background: #000;
        color: #fff;
        font-weight: 600;
        border-radius: 50px;
        padding: 10px 30px;
        border: none;
    }

    .form-control {
        border-radius: 8px;
    }

    .small-muted {
        font-size: 0.9rem;
        color: #666;
    }

    .summary-row {
        border-bottom: 1px solid #f1f1f1;
        padding: 10px 0;
    }
</style>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="form-card">
                <h3 class="text-center mb-3">Register for Football Academy</h3>

                <!-- Step indicator -->
                <div class="step-indicator" id="stepIndicator">
                    <div class="step active" data-step="1">
                        <div class="circle">1</div>
                        <span class="label">Contact</span>
                        <div class="step-line"></div>
                    </div>
                    <div class="step" data-step="2">
                        <div class="circle">2</div>
                        <span class="label">Details</span>
                        <div class="step-line"></div>
                    </div>
                    <div class="step" data-step="3">
                        <div class="circle">3</div>
                        <span class="label">Confirm Phone</span>
                        <div class="step-line"></div>
                    </div>
                    <div class="step" data-step="4">
                        <div class="circle">4</div>
                        <span class="label">Summary</span>
                    </div>
                </div>

                <div class="progress-line">
                    <div class="progress-fill" id="progressFill" style="width:0%"></div>
                </div>

                @if (TempData["ModelErrors"] != null)
                {
                    <div class="alert alert-danger">@TempData["ModelErrors"]</div>
                }

                <div asp-validation-summary="All" class="text-danger mb-2"></div>


                <!-- Full form posts to Create (your existing POST) -->
                <form asp-action="Create" method="post" enctype="multipart/form-data" id="wizardForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <!-- STEP 1 -->
                    <div class="wizard-step" data-step="1">
                        <h5>Step 1 — Email / Phone</h5>
                        <div class="row g-3 mt-2">
                            <div class="col-md-6">
                                <label asp-for="PhoneNo" class="form-label">Phone No</label>
                                <input asp-for="PhoneNo" class="form-control" id="PhoneNo" />
                                <span asp-validation-for="PhoneNo" class="text-danger"></span>
                                <div class="small-muted mt-1">Enter phone to use for confirmation.</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" type="email" class="form-control" id="Email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mt-4 d-flex justify-content-end">
                            <button type="button" class="btn btn-custom" id="next1">Next →</button>
                        </div>
                    </div>

                    <!-- STEP 2 -->
                    <div class="wizard-step hidden" data-step="2">
                        <h5>Step 2 — Player Details</h5>
                        <div class="row g-3 mt-2">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">Name</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            @* <div class="col-md-6">
                                <label asp-for="Category" class="form-label">Category</label>
                                <select asp-for="Category" class="form-select">
                                    <option value="">-- Select Category --</option>
                                    <option>Under-12</option>
                                    <option>Under-14</option>
                                    <option>Under-16</option>
                                    <option>Under-18</option>
                                    <option>Senior</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger"></span>
                            </div> *@
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label">Age</label>
                                <input asp-for="Category" class="form-control" type="text" placeholder="Enter Age" />
                                <span asp-validation-for="Category" class="text-danger"></span>
                            </div>


                            <div class="col-md-6">
                                <label asp-for="SubscriptionStart" class="form-label">Start Date</label>
                                <input asp-for="SubscriptionStart" type="date" class="form-control" />
                                <span asp-validation-for="SubscriptionStart" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SubscriptionEnd" class="form-label">End Date</label>
                                <input asp-for="SubscriptionEnd" type="date" class="form-control" />
                                <span asp-validation-for="SubscriptionEnd" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="SubscriptionFees" class="form-label">Subscription Fees</label>
                                <input asp-for="SubscriptionFees" type="number" step="0.01" min="0" class="form-control fee-input" id="SubscriptionFees" />
                                <span asp-validation-for="SubscriptionFees" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="KitFees" class="form-label">Kit Fees</label>
                                <input asp-for="KitFees" type="number" step="0.01" min="0" class="form-control fee-input" id="KitFees" />
                                <span asp-validation-for="KitFees" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="SugarFees" class="form-label">Sugar Fees</label>
                                <input asp-for="SugarFees" type="number" step="0.01" min="0" class="form-control fee-input" id="SugarFees" />
                                <span asp-validation-for="SugarFees" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="BagFees" class="form-label">Bag Fees</label>
                                <input asp-for="BagFees" type="number" step="0.01" min="0" class="form-control fee-input" id="BagFees" />
                                <span asp-validation-for="BagFees" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Total Fees</label>
                                <input asp-for="TotalFees" class="form-control" id="TotalFees" readonly />
                                <span class="small-muted">Calculated automatically from fees.</span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="WorkingHours" class="form-label">Working Hours</label>
                                <select asp-for="WorkingHours" class="form-select">
                                    <option value="">-- Select Working Time --</option>
                                    <option>1 To 3</option>
                                    <option>3 To 6</option>
                                    <option>6 To 9</option>
                                    <option>9 To 12</option>
                                </select>
                            </div>

                         @*    <div class="col-md-6">
                                <label asp-for="CoachName" class="form-label">Coach Name</label>
                                <select asp-for="CoachName" class="form-select" asp-items="@(ViewBag.Coaches as List<SelectListItem>)">
                                    <option value="">-- Select Coach --</option>
                                </select>
                            </div> *@

                            <div class="col-md-6">
                                <label asp-for="CoachName" class="form-label">Coach Name</label>
                                <input asp-for="CoachName" class="form-control" type="text" placeholder="Enter Coach Name" />
                                <span asp-validation-for="CoachName" class="text-danger"></span>
                            </div>



                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label">Address</label>
                                <input asp-for="Address" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="City" class="form-label">City</label>
                                <input asp-for="City" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Ground" class="form-label">Ground</label>
                                <select asp-for="Ground" class="form-select">
                                    <option>Turf 1</option>
                                    <option>Turf 2</option>
                                    <option>Turf 3</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TimeSlot" class="form-label">Time Slot</label>
                                <select asp-for="TimeSlot" class="form-select">
                                    <option>Morning</option>
                                    <option>Evening</option>
                                    <option>Night</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="BirthDate" class="form-label">Birth Date</label>
                                <input asp-for="BirthDate" type="date" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Image</label>
                                <input type="file" name="imageFile" class="form-control" />

                            </div>
                        </div>

                        <div class="mt-4 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" id="prev2">← Back</button>
                            <button type="button" class="btn btn-custom" id="next2">Next →</button>
                        </div>
                    </div>

                    <!-- STEP 3 -->
                    <div class="wizard-step hidden" data-step="3">
                        <h5>Step 3 — Confirm Phone</h5>
                        <div class="mt-3">
                            <p>We will confirm the phone number you entered:</p>
                            <div class="mb-3">
                                <label class="form-label">Phone to confirm</label>
                                <input type="text" class="form-control" id="confirmPhoneDisplay" readonly />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Re-enter phone to confirm</label>
                                <input type="text" class="form-control" id="confirmPhoneInput" placeholder="Type the phone again to confirm" />
                                <div class="text-danger small mt-1" id="phoneConfirmError" style="display:none;"></div>
                            </div>

                            <div class="mb-2">
                                <small class="small-muted">If you want OTP-based confirmation instead, I can help integrate SMS in the controller.</small>
                            </div>
                        </div>

                        <div class="mt-4 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" id="prev3">← Back</button>
                            <button type="button" class="btn btn-custom" id="next3">Confirm →</button>
                        </div>
                    </div>

                    <!-- STEP 4: SUMMARY -->
                    <div class="wizard-step hidden" data-step="4">
                        <h5>Step 4 — Summary</h5>
                        <div class="mt-3" id="summaryBox">
                            <!-- summary rows filled by JS -->
                        </div>

                        <div class="mt-4 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" id="prev4">← Back</button>
                            <button type="submit" class="btn btn-custom" id="finalSubmit">Submit & Save</button>
                        </div>
                    </div>

                </form>

                <div class="text-center mt-3">
                    <a asp-action="Index" class="small-muted">← Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/additional-methods.min.js"></script>
<partial name="_ValidationScriptsPartial" />  <!-- keeps unobtrusive validation -->

<script>
    $(function(){
      // show/hide steps helpers
      function goToStep(step) {
        $('.wizard-step').addClass('hidden');
        $('.wizard-step[data-step="'+step+'"]').removeClass('hidden');

        // indicator
        $('.step').each(function(){
          var s = $(this).data('step');
          $(this).removeClass('active completed');
          if(s < step) $(this).addClass('completed');
          if(s == step) $(this).addClass('active');
        });

        // progress fill percent (0,33,66,100)
        var pct = {1:0,2:33,3:66,4:100}[step] || 0;
        $('#progressFill').css('width', pct + '%');
      }

      // init
      goToStep(1);

      // fees calculator
      function calcFees(){
        var s = parseFloat($('#SubscriptionFees').val() || 0);
        var k = parseFloat($('#KitFees').val() || 0);
        var su = parseFloat($('#SugarFees').val() || 0);
        var b = parseFloat($('#BagFees').val() || 0);
        var total = (s + k + su + b) || 0;
        $('#TotalFees').val(total.toFixed(2));
      }
      $('.fee-input').on('input change', calcFees);
      calcFees();

      // jQuery validate: we'll validate only visible fields
      var validator = $("#wizardForm").validate({
        ignore: [], // don't ignore hidden so we can validate visible only using conditional rules
        errorClass: "text-danger",
        errorPlacement: function(error, element) {
          error.insertAfter(element);
        }
      });

      // helper to validate only inputs inside current step
      function validateCurrentStep(step) {
        var valid = true;
        var $step = $('.wizard-step[data-step="'+step+'"]');
        // Clear previous errors
        validator.resetForm();
        $step.find(':input[required], input[type="email"], input[type="number"]').each(function(){
          // temporarily add rules for required if empty
          $(this).valid();
          if(!$(this).valid()) valid = false;
        });
        return valid;
      }

      // Step navigation handlers
      $('#next1').on('click', function(){
        // require Phone/email
        var phone = $('#PhoneNo').val().trim();
        var email = $('#Email').val().trim();
        if(!phone && !email){
          // show error
          if(!phone) {
            $('#PhoneNo').next('.text-danger').text('Phone required (or provide email).');
          }
          if(!email) {
            $('#Email').next('.text-danger').text('Email required (or provide phone).');
          }
          return;
        } else {
          // clear errors
          $('#PhoneNo').next('.text-danger').text('');
          $('#Email').next('.text-danger').text('');
        }

        // populate confirm phone display
        $('#confirmPhoneDisplay').val(phone);

        goToStep(2);
      });

      $('#prev2').on('click', function(){ goToStep(1); });

      $('#next2').on('click', function(){
        // validate some required fields in step2: Name, SubscriptionFees or others as you choose
        var name = $('[name="Name"]').val().trim();
        if(!name) {
          $('[name="Name"]').next('.text-danger').text('Name is required');
          return;
        } else {
          $('[name="Name"]').next('.text-danger').text('');
        }

        calcFees();
        goToStep(3);
      });

      $('#prev3').on('click', function(){ goToStep(2); });

      // Confirm phone step
      $('#next3').on('click', function(){
        var entered = $('#confirmPhoneInput').val().trim();
        var original = $('#confirmPhoneDisplay').val().trim();
        if(entered === "" ) {
          $('#phoneConfirmError').text('Please re-enter the phone to confirm.').show();
          return;
        }
        if(entered !== original) {
          $('#phoneConfirmError').text('Phone does not match. Please check.').show();
          return;
        }
        $('#phoneConfirmError').hide();

        // Build summary
        var summaryHtml = '';
        function row(label, value){ return '<div class="summary-row"><strong>'+label+'</strong><div class="small-muted">'+(value||'—')+'</div></div>'; }
        summaryHtml += row('Name', $('[name="Name"]').val());
        summaryHtml += row('Phone', $('[name="PhoneNo"]').val());
        summaryHtml += row('Email', $('[name="Email"]').val());
        summaryHtml += row('Category', $('[name="Category"]').val());
        summaryHtml += row('Subscription Start', $('[name="SubscriptionStart"]').val());
        summaryHtml += row('Subscription End', $('[name="SubscriptionEnd"]').val());
        summaryHtml += row('Subscription Fees', $('#SubscriptionFees').val());
        summaryHtml += row('Kit Fees', $('#KitFees').val());
        summaryHtml += row('Sugar Fees', $('#SugarFees').val());
        summaryHtml += row('Bag Fees', $('#BagFees').val());
        summaryHtml += row('Total Fees', $('#TotalFees').val());
        summaryHtml += row('Working Hours', $('[name="WorkingHours"]').val());
        summaryHtml += row('Coach', $('[name="CoachName"]').val());
        summaryHtml += row('Address', $('[name="Address"]').val());
        summaryHtml += row('City', $('[name="City"]').val());
        summaryHtml += row('Ground', $('[name="Ground"]').val());
        summaryHtml += row('TimeSlot', $('[name="TimeSlot"]').val());
        summaryHtml += row('BirthDate', $('[name="BirthDate"]').val());
        $('#summaryBox').html(summaryHtml);

        goToStep(4);
      });

      $('#prev4').on('click', function(){ goToStep(3); });

      // Final submit: do last quick client-side validation and allow server post
      $('#wizardForm').on('submit', function(e){
        // ensure TotalFees set (server also recalculates, this is UX)
        calcFees();
        return true; // allow default submit; server Create action will run
      });

    });
</script>
