@model IEnumerable<FootBallOne.Models.RegistrationManagement>
@{
    ViewData["Title"] = "Player List";
    string search = Context.Request.Query["search"];
    Layout = "_Layout";
}

<!-- Bootstrap & Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    body {
        background: #f2f4f7;
        font-family: 'Segoe UI', sans-serif;
    }

    h1 {
        font-weight: 600;
        color: #000;
    }

    .table-container {
        background-color: #fff;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 0 12px rgba(0, 0, 0, 0.08);
        margin-top: 30px;
        overflow-x: auto;
    }

    table {
        min-width: 1200px;
    }

    th {
        background-color: #0d6efd;
        color: white;
        vertical-align: middle;
        text-align: center;
    }

    td {
        vertical-align: middle;
        text-align: center;
    }

    .img-thumbnail {
        max-width: 60px;
        max-height: 60px;
        border-radius: 10px;
    }

    .search-form {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 30px;
    }

    .btn-action {
        margin: 0 3px;
    }

    .badge-category {
        border-radius: 20px;
        padding: 5px 12px;
        font-size: 0.75rem;
        font-weight: 500;
        color: #fff;
    }

    .badge-under-12 {
        background: #17a2b8;
    }

    .badge-under-14 {
        background: #ffc107;
    }

    .badge-under-16 {
        background: #fd7e14;
    }

    .badge-under-18 {
        background: #dc3545;
    }

    .badge-senior {
        background: #198754;
    }

    .pagination {
        justify-content: center;
        margin-top: 20px;
    }
</style>

<div class="container mt-4">
    <h1><i class="bi bi-people-fill"></i> Registered Players</h1>

    <!-- Search + Create Button -->
    <div class="search-form">
        <form method="get" class="flex-grow-1 d-flex">
            <input type="text" name="search" value="@search" class="form-control me-2" placeholder="Search by name, email, or city..." />
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i></button>
        </form>
        <a class="btn btn-success" asp-action="Create"><i class="bi bi-plus-circle-fill"></i> Add New Player</a>
    </div>

    <div class="table-container">
        <table class="table table-bordered table-hover table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Category</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Sub</th>
                    <th>Kit</th>
                    <th>Sugar</th>
                    <th>Bag</th>
                    <th>Total</th>
                    <th>Hours</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>City</th>
                    <th>Image</th>
                    <th>Coach</th>
                    <th>Payment</th>
                    <th>Ground</th>
                    <th>Time Slot</th>
                    <th>Birth Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Where(x =>
                                string.IsNullOrEmpty(search) ||
                                x.Name?.Contains(search, StringComparison.OrdinalIgnoreCase) == true ||
                                x.Email?.Contains(search, StringComparison.OrdinalIgnoreCase) == true ||
                                x.City?.Contains(search, StringComparison.OrdinalIgnoreCase) == true))
                {
                    string categoryClass = item.Category switch
                    {
                        "Under-12" => "badge-under-12",
                        "Under-14" => "badge-under-14",
                        "Under-16" => "badge-under-16",
                        "Under-18" => "badge-under-18",
                        "Senior" => "badge-senior",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td>@item.Name</td>
                        <td>@item.PhoneNo</td>
                        <td><span class="badge badge-category @categoryClass">@item.Category</span></td>
                        <td>@(item.SubscriptionStart?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                        <td>@(item.SubscriptionEnd?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                        <td>₹@item.SubscriptionFees</td>
                        <td>₹@item.KitFees</td>
                        <td>₹@item.SugarFees</td>
                        <td>₹@item.BagFees</td>
                        <td>₹@item.TotalFees</td>
                        <td>@item.WorkingHours</td>
                        <td>@item.Email</td>
                        <td>@item.Address</td>
                        <td>@item.City</td>
                        <td>
                            @if (item.ImageFile != null)
                            {
                                // Agar aapne already server pe save karke path banaya hai
                                <img src="@Url.Content(item.ImageFile)" alt="Player Image" class="img-thumbnail" />
                            }
                            else
                            {
                                <i class="bi bi-image" style="font-size: 1.5rem; color: #888;"></i>
                            }

                        </td>
                        <td>@item.CoachName</td>
                        <td>@item.PaymentStatus</td>
                        <td>@item.Ground</td>
                        <td>@item.TimeSlot</td>
                        <td>@item.BirthDate?.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a class="btn btn-sm btn-warning btn-action" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil"></i></a>
                            <a class="btn btn-sm btn-info btn-action" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-info-circle"></i></a>
                            <a class="btn btn-sm btn-danger btn-action" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination (optional) -->
        <nav>
            <ul class="pagination">
                <li class="page-item disabled"><a class="page-link">Previous</a></li>
                <li class="page-item active"><a class="page-link">1</a></li>
                <li class="page-item"><a class="page-link">2</a></li>
                <li class="page-item"><a class="page-link">Next</a></li>
            </ul>
        </nav>
    </div>
</div>
